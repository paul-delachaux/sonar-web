---
import MainLayout from './Layout.astro';
import categorySettings from '../data/categories.json';
import { t, categoryDictKey, categoryLabel } from '../utils/i18n.js';

interface Props {
  categoryTitle: string;
  categorySlug: string;
  articles: any[];
}

const { categoryTitle, categorySlug, articles } = Astro.props;

const IMG_PLACEHOLDER = "/assets/uploads/default-placeholder.jpg";
const DEFAULT_STYLES = { titleSize: "1.2rem", titleWeight: "700", descSize: "0.8rem" };

const nettoyer = (s: any) =>
  String(s || '')
    .replace(/\.mdx?$/, '')
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");

const slugEstVide = (s: any) => s == null || String(s).trim() === "";

const trouverArticleParSlug = (slugCible: string | undefined | null) => {
  if (slugEstVide(slugCible)) return null;
  const cibleClean = nettoyer(slugCible);
  return articles.find((art) => nettoyer(art.id || art.slug) === cibleClean) || null;
};

const checkHasEn = (art: any) =>
  Boolean(art && art.data && art.data.title_en && String(art.data.title_en).trim() !== "");

const currentSlug = categorySlug.toLowerCase();
const selectedSlugs = (categorySettings as any)[`${currentSlug}_topArticles`] || [];
const selectedStyles = (categorySettings as any)[`${currentSlug}_topStyles`] || [];

const slotsAdmin = (Array.isArray(selectedSlugs) && selectedSlugs.length > 0)
  ? [...selectedSlugs, null, null, null].slice(0, 3)
  : [null, null, null];

const avecStyles = (art: any, index: number) => {
  if (!art) return null;
  const styleConfig = selectedStyles[index] || {};
  return {
    ...art,
    customStyles: {
      titleSize: styleConfig.titleSize || DEFAULT_STYLES.titleSize,
      titleWeight: styleConfig.titleWeight || DEFAULT_STYLES.titleWeight,
      descSize: styleConfig.descSize || DEFAULT_STYLES.descSize,
    },
  };
};

// --- PLACEMENT FR : 2 PASSES (admin puis trous par date) ---
const usedIdsFR = new Set<string>();

const reserverAdmin = (slug: any) => {
  const art = trouverArticleParSlug(slug);
  if (!art || usedIdsFR.has(art.id)) return null;
  usedIdsFR.add(art.id);
  return art;
};

const prochainRecent = () => {
  const art = articles.find((a) => !usedIdsFR.has(a.id)) || null;
  if (art) usedIdsFR.add(art.id);
  return art;
};

let topThreeFR: any[] = slotsAdmin.map((slug: any, index: number) =>
  avecStyles(reserverAdmin(slug), index)
);
topThreeFR = topThreeFR.map((art, index) => art || avecStyles(prochainRecent(), index));
topThreeFR = topThreeFR.filter(Boolean);

const remainingFR = articles.filter((art) => !usedIdsFR.has(art.id));

// --- PLACEMENT EN (même logique que l'accueil) ---
const articlesENDisponibles = articles.filter(checkHasEn);

const assignerSlotsEN = (slotsFR: any[], adminSlugs: any[]) => {
  const usedIds = new Set<string>();
  const result = slotsFR.map(() => ({ article: null as any, hasEn: false }));

  const adminEnQueue: any[] = [];
  for (const slug of adminSlugs) {
    if (slugEstVide(slug)) continue;
    const art = trouverArticleParSlug(slug);
    if (!art || !checkHasEn(art)) continue;
    if (adminEnQueue.some((a) => a.id === art.id)) continue;
    adminEnQueue.push(art);
  }

  const prochainAdminEn = () => adminEnQueue.find((a) => !usedIds.has(a.id)) || null;
  const prochainDateEn = () => articlesENDisponibles.find((a) => !usedIds.has(a.id)) || null;

  const placer = (index: number, art: any) => {
    if (!art || usedIds.has(art.id) || result[index].hasEn) return false;
    usedIds.add(art.id);
    result[index] = { article: art, hasEn: true };
    return true;
  };

  for (let i = 0; i < slotsFR.length; i++) {
    const artFR = slotsFR[i];
    if (!artFR) continue;

    if (checkHasEn(artFR) && !usedIds.has(artFR.id)) {
      placer(i, artFR);
      continue;
    }

    placer(i, prochainAdminEn() || prochainDateEn());
  }

  return result;
};

const topThreeEN = assignerSlotsEN(topThreeFR, slotsAdmin);

// Sidebar EN : garder si traduit, sinon combler par date (sans reprendre les EN déjà en top)
const usedEnIds = new Set(
  topThreeEN.filter((r) => r.hasEn && r.article).map((r) => r.article.id)
);
const remainingEN = remainingFR.map((artFR) => {
  if (checkHasEn(artFR) && !usedEnIds.has(artFR.id)) {
    usedEnIds.add(artFR.id);
    return { article: artFR, hasEn: true };
  }
  const fill = articlesENDisponibles.find((a) => !usedEnIds.has(a.id));
  if (fill) {
    usedEnIds.add(fill.id);
    return { article: fill, hasEn: true };
  }
  return { article: null, hasEn: false };
});

const enText = (artEN: any, hasEn: boolean, field: string) => {
  if (!hasEn || !artEN) return "";
  const val = artEN.data?.[field];
  return val != null && String(val).trim() !== "" ? String(val) : "";
};
const enImage = (artEN: any, hasEn: boolean) => {
  if (!hasEn || !artEN) return "";
  return artEN.data?.image || artEN.data?.article_image || IMG_PLACEHOLDER;
};
const enHref = (artEN: any, hasEn: boolean) => {
  if (!hasEn || !artEN) return "";
  return `/articles/${artEN.id}`;
};

const DEFAULT_OVERLAY_OPACITY = 75;

const overlayGradient = (raw: unknown) => {
  const n = Number(raw);
  const intensity =
    raw === undefined || raw === null || raw === "" || Number.isNaN(n)
      ? DEFAULT_OVERLAY_OPACITY
      : Math.max(0, Math.min(100, n));
  const left = intensity / 100;
  const mid = left * (0.4 / 0.75);
  const right = left * (0.1 / 0.75);
  return `linear-gradient(to right, rgba(0, 0, 0, ${left}) 0%, rgba(0, 0, 0, ${mid}) 60%, rgba(0, 0, 0, ${right}) 100%)`;
};
---

<MainLayout title={categoryTitle}>
  <div class="category-wrapper">
    
    <!-- BANDEAU TITRE -->
    <header class="category-header">
      <h1 class="category-title" data-i18n={categoryDictKey(currentSlug) || undefined}>{categoryLabel(currentSlug, 'FR')}</h1>
      <div class="title-separator"></div>
    </header>

    <!-- GRILLE PRINCIPALE -->
    <div class="category-grid">

      <!-- COLONNE GAUCHE : 3 articles HERO -->
      <main class="left-stack">
        {topThreeFR.length > 0 ? (
          topThreeFR.map((artFR, idx) => {
            const artEN = topThreeEN[idx]?.article ?? null;
            const hasEn = topThreeEN[idx]?.hasEn ?? false;
            const bgImageFR = artFR.data.image || artFR.data.article_image || IMG_PLACEHOLDER;
            return (
              <a 
                href={`/articles/${artFR.id}`} 
                class="hero-card-bg article-card-item"
                data-has-en={hasEn ? "true" : "false"}
                data-href-fr={`/articles/${artFR.id}`}
                data-href-en={enHref(artEN, hasEn)}
              >
                <div
                  class="bg-image"
                  style={`background-image: url('${bgImageFR}');`}
                  data-bg-fr={bgImageFR}
                  data-bg-en={enImage(artEN, hasEn)}
                ></div>
                <div class="card-overlay" style={`background: ${overlayGradient(artFR.data.overlay_opacity)};`}></div>
                
                <div class="card-text-container">
                  <h2 
                    class="card-title"
                    style={`font-size: ${artFR.customStyles.titleSize} !important; font-weight: ${artFR.customStyles.titleWeight} !important;`}
                    data-fr={artFR.data.title}
                    data-en={enText(artEN, hasEn, "title_en")}
                  >
                    {artFR.data.title}
                  </h2>
                  <p 
                    class="card-desc"
                    style={`font-size: ${artFR.customStyles.descSize} !important;`}
                    data-fr={artFR.data.description}
                    data-en={enText(artEN, hasEn, "description_en")}
                  >
                    {artFR.data.description}
                  </p>
                </div>
              </a>
            );
          })
        ) : (
          <p class="no-articles" data-i18n="no_articles_category">Aucun article dans cette catégorie pour le moment.</p>
        )}
      </main>

      <!-- COLONNE DROITE : Sidebar -->
      <aside class="right-sidebar">
        <div class="sidebar-scroll-box">
          <p class="sidebar-label" data-i18n="sidebar_other_news">{t('sidebar_other_news', 'FR')}</p>
          
          <div class="sidebar-feed">
            {remainingFR.length > 0 ? (
              remainingFR.map((artFR, idx) => {
                const artEN = remainingEN[idx]?.article ?? null;
                const hasEn = remainingEN[idx]?.hasEn ?? false;
                const imgFR = artFR.data.image || artFR.data.article_image || "";
                return (
                  <a 
                    href={`/articles/${artFR.id}`} 
                    class="sidebar-card article-card-item"
                    data-has-en={hasEn ? "true" : "false"}
                    data-href-fr={`/articles/${artFR.id}`}
                    data-href-en={enHref(artEN, hasEn)}
                  >
                    {imgFR && (
                      <img
                        src={imgFR}
                        alt={artFR.data.title}
                        class="sidebar-card-img"
                        data-img-fr={imgFR}
                        data-img-en={enImage(artEN, hasEn)}
                      />
                    )}
                    <div class="sidebar-card-body">
                      <p 
                        class="sidebar-card-title"
                        data-fr={artFR.data.title}
                        data-en={enText(artEN, hasEn, "title_en")}
                      >
                        {artFR.data.title}
                      </p>
                    </div>
                  </a>
                );
              })
            ) : (
              <p class="no-more-articles" data-i18n="no_more_articles">Pas d'autres articles pour le moment.</p>
            )}
          </div>
        </div>
      </aside>

    </div>
  </div>
</MainLayout>

<style>
  .category-wrapper { max-width: 1200px; margin: 40px auto; padding: 0 20px 80px 20px; }
  .category-header { margin-bottom: 30px; text-align: left; padding-left: 15px; }
  .category-title { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.5rem; font-weight: 800; color: #ffffff; display: block; letter-spacing: 0.05em; margin: 0 0 10px 0; }
  .title-separator { width: 75%; height: 2px; background-color: #ffffff; margin-right: auto; }
  .category-grid { display: grid; grid-template-columns: 3.5fr 1.5fr; gap: 30px; align-items: start; }
  .left-stack { display: flex; flex-direction: column; gap: 25px; }
  .hero-card-bg { position: relative; width: 100%; height: 200px; border-radius: 4px; overflow: hidden; text-decoration: none; display: block; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .hero-card-bg:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6); }
  .bg-image { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 0.5s ease; pointer-events: none; }
  .hero-card-bg:hover .bg-image { transform: scale(1.03); }
  .card-overlay { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .card-text-container { position: relative; z-index: 2; padding: 20px; max-width: 80%; height: 100%; display: flex; flex-direction: column; justify-content: top; box-sizing: border-box; }
  .card-title { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.2rem; font-weight: 700; color: #ffffff; margin: 0 0 10px 0; line-height: 1.3; }
  .card-desc { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 0.8rem; font-weight: 400; color: #ffffff; margin: 0; line-height: 1.4; }
  .right-sidebar { height: 650px; position: sticky; top: 20px; }
  .sidebar-scroll-box { border: 1px solid #ffffff; border-radius: 4px; padding: 15px; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; background-color: #02001d; }
  .sidebar-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; color: #ea580c; margin: 0 0 15px 0; flex-shrink: 0; }
  .sidebar-feed { overflow-y: auto; display: flex; flex-direction: column; gap: 15px; padding-right: 8px; flex-grow: 1; scrollbar-width: thin; scrollbar-color: #002761 rgba(255, 255, 255, 0.05); }
  .sidebar-feed::-webkit-scrollbar { width: 6px; }
  .sidebar-feed::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 10px; }
  .sidebar-feed::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #002761 0%, #002761 100%); border-radius: 10px; transition: background 0.3s ease; }
  .sidebar-feed::-webkit-scrollbar-thumb:hover { background: #ea580c; }
  .sidebar-card { display: flex; flex-direction: column; gap: 8px; text-decoration: none; border-bottom: 1px solid #1f2937; padding-bottom: 12px; }
  .sidebar-card-img { width: 100%; height: 100px; object-fit: cover; border-radius: 4px; }
  .sidebar-card-title { margin: 0; font-size: 0.85rem; font-weight: 600; color: #ffffff; line-height: 1.3; transition: color 0.2s ease; }
  .sidebar-card:hover .sidebar-card-title { color: #ea580c; }
  .no-articles, .no-more-articles { color: #9ca3af; font-size: 0.85rem; font-style: italic; }
  @media (max-width: 968px) {
    .category-grid { grid-template-columns: 1fr; }
    .card-text-container { max-width: 100%; }

    /* Les colonnes de la grille (items grid) ont par défaut min-width:auto :
       elles refusent de rétrécir sous la largeur de leur contenu. Comme le
       carrousel ci-dessous contient des cartes à largeur fixe, ça poussait
       toute la page à déborder horizontalement. min-width:0 corrige ça. */
    .left-stack, .right-sidebar {
      min-width: 0;
    }

    /* "À lire aussi" : au lieu d'une liste verticale dans un encart à hauteur
       fixe (scroll interne peu pratique au doigt), on passe à un carrousel
       horizontal qu'on fait glisser de gauche à droite. */
    .right-sidebar {
      height: auto;
      position: static;
    }
    .sidebar-scroll-box {
      height: auto;
      width: 100%;
      box-sizing: border-box;
    }
    .sidebar-feed {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: visible;
      width: 100%;
      min-width: 0;
      gap: 12px;
      padding-right: 0;
      padding-bottom: 6px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }
    .sidebar-card {
      flex: 0 0 150px;
      width: 150px;
      border-bottom: none;
      padding-bottom: 0;
      scroll-snap-align: start;
    }
    .sidebar-card-img {
      height: 90px;
    }
  }
</style>
