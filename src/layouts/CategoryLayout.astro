---
import MainLayout from './Layout.astro';
import categorySettings from '../data/categories.json';

interface Props {
  categoryTitle: string;
  categorySlug: string;
  articles: any[];
}

const { categoryTitle, categorySlug, articles } = Astro.props;

// Fonction de nettoyage ultra-rigoureuse des slugs
const nettoyer = (s: any) => String(s || '').replace(/\.mdx?$/, '').trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

// Helper pour retrouver un article à partir d'un slug
const trouverArticleParSlug = (slugCible: string | undefined) => {
  if (!slugCible) return null;
  const cibleClean = nettoyer(slugCible);
  return articles.find(art => {
    const idClean = nettoyer(art.id || art.slug);
    return idClean === cibleClean;
  });
};

const currentSlug = categorySlug.toLowerCase();
const selectedSlugs = (categorySettings as any)[`${currentSlug}_topArticles`] || [];
const selectedStyles = (categorySettings as any)[`${currentSlug}_topStyles`] || [];

const usedArticleIds = new Set<string>();
let topThreeArticles: any[] = [];

// 1. Charger les 3 articles configurés dans le CMS (s'ils sont définis)
if (Array.isArray(selectedSlugs) && selectedSlugs.length > 0) {
  selectedSlugs.forEach((slug: string, index: number) => {
    const art = trouverArticleParSlug(slug);
    if (art && !usedArticleIds.has(art.id)) {
      const styleConfig = selectedStyles[index] || {};
      topThreeArticles.push({
        ...art,
        customStyles: {
          titleSize: styleConfig.titleSize || "1.2rem",
          titleWeight: styleConfig.titleWeight || "700",
          descSize: styleConfig.descSize || "0.8rem"
        }
      });
      usedArticleIds.add(art.id);
    }
  });
}

// 2. Remplir avec les articles récents si moins de 3 sélectionnés
articles.forEach((art) => {
  if (topThreeArticles.length < 3 && !usedArticleIds.has(art.id)) {
    topThreeArticles.push({
      ...art,
      customStyles: {
        titleSize: "1.2rem",
        titleWeight: "700",
        descSize: "0.8rem"
      }
    });
    usedArticleIds.add(art.id);
  }
});

// 3. Reste des articles pour la sidebar
const remainingArticles = articles.filter(art => !usedArticleIds.has(art.id));
---

<MainLayout title={categoryTitle}>
  <div class="category-wrapper">
    
    <!-- BANDEAU TITRE -->
    <header class="category-header">
      <h1 class="category-title" data-i18n={`category_${currentSlug}`}>{categoryTitle.toUpperCase()}</h1>
      <div class="title-separator"></div>
    </header>

    <!-- GRILLE PRINCIPALE -->
    <div class="category-grid">

      <!-- COLONNE GAUCHE : 3 articles HERO -->
      <main class="left-stack">
        {topThreeArticles.length > 0 ? (
          topThreeArticles.map((art) => {
            const bgImage = art.data.image || art.data.article_image || "/assets/uploads/default-placeholder.jpg";
            const hasEn = Boolean(art.data?.title_en && String(art.data.title_en).trim() !== "");
            
            return (
              <a 
                href={`/articles/${art.id}`} 
                class="hero-card-bg article-card-item"
                data-has-en={hasEn ? "true" : "false"}
              >
                <div class="bg-image" style={`background-image: url('${bgImage}');`}></div>
                <div class="card-overlay"></div>
                
                <div class="card-text-container">
                  <h2 
                    class="card-title"
                    style={`font-size: ${art.customStyles.titleSize} !important; font-weight: ${art.customStyles.titleWeight} !important;`}
                    data-fr={art.data.title}
                    data-en={art.data.title_en || art.data.title}
                  >
                    {art.data.title}
                  </h2>
                  <p 
                    class="card-desc"
                    style={`font-size: ${art.customStyles.descSize} !important;`}
                    data-fr={art.data.description}
                    data-en={art.data.description_en || art.data.description}
                  >
                    {art.data.description}
                  </p>
                </div>
              </a>
            );
          })
        ) : (
          <p class="no-articles" data-i18n="no_articles_category">Aucun article dans cette catégorie pour le moment.</p>
        )}
      </main>

      <!-- COLONNE DROITE : Sidebar -->
      <aside class="right-sidebar">
        <div class="sidebar-scroll-box">
          <p class="sidebar-label" data-i18n="other_news">AUTRES ACTUALITÉS</p>
          
          <div class="sidebar-feed">
            {remainingArticles.length > 0 ? (
              remainingArticles.map((art) => {
                const hasEn = Boolean(art.data?.title_en && String(art.data.title_en).trim() !== "");
                
                return (
                  <a 
                    href={`/articles/${art.id}`} 
                    class="sidebar-card article-card-item"
                    data-has-en={hasEn ? "true" : "false"}
                  >
                    {(art.data.image || art.data.article_image) && (
                      <img
                        src={art.data.image || art.data.article_image}
                        alt={art.data.title}
                        class="sidebar-card-img"
                      />
                    )}
                    <div class="sidebar-card-body">
                      <p 
                        class="sidebar-card-title"
                        data-fr={art.data.title}
                        data-en={art.data.title_en || art.data.title}
                      >
                        {art.data.title}
                      </p>
                    </div>
                  </a>
                );
              })
            ) : (
              <p class="no-more-articles" data-i18n="no_more_articles">Pas d'autres articles pour le moment.</p>
            )}
          </div>
        </div>
      </aside>

    </div>
  </div>
</MainLayout>

<style>
  .category-wrapper { max-width: 1200px; margin: 40px auto; padding: 0 20px 80px 20px; }
  .category-header { margin-bottom: 30px; text-align: left; padding-left: 15px; }
  .category-title { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.5rem; font-weight: 800; color: #ffffff; display: block; letter-spacing: 0.05em; margin: 0 0 10px 0; }
  .title-separator { width: 75%; height: 2px; background-color: #ffffff; margin-right: auto; }
  .category-grid { display: grid; grid-template-columns: 3.5fr 1.5fr; gap: 30px; align-items: start; }
  .left-stack { display: flex; flex-direction: column; gap: 25px; }
  .hero-card-bg { position: relative; width: 100%; height: 200px; border-radius: 4px; overflow: hidden; text-decoration: none; display: block; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .hero-card-bg:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6); }
  .bg-image { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 0.5s ease; }
  .hero-card-bg:hover .bg-image { transform: scale(1.03); }
  .card-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.4) 60%, rgba(0, 0, 0, 0.1) 100%); z-index: 1; }
  .card-text-container { position: relative; z-index: 2; padding: 20px; max-width: 80%; height: 100%; display: flex; flex-direction: column; justify-content: top; box-sizing: border-box; }
  .card-title { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 1.2rem; font-weight: 700; color: #ffffff; margin: 0 0 10px 0; line-height: 1.3; }
  .card-desc { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 0.8rem; font-weight: 400; color: #ffffff; margin: 0; line-height: 1.4; }
  .right-sidebar { height: 650px; position: sticky; top: 20px; }
  .sidebar-scroll-box { border: 1px solid #ffffff; border-radius: 4px; padding: 15px; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; background-color: #02001d; }
  .sidebar-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; color: #ea580c; margin: 0 0 15px 0; flex-shrink: 0; }
  .sidebar-feed { overflow-y: auto; display: flex; flex-direction: column; gap: 15px; padding-right: 8px; flex-grow: 1; scrollbar-width: thin; scrollbar-color: #002761 rgba(255, 255, 255, 0.05); }
  .sidebar-feed::-webkit-scrollbar { width: 6px; }
  .sidebar-feed::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 10px; }
  .sidebar-feed::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #002761 0%, #002761 100%); border-radius: 10px; transition: background 0.3s ease; }
  .sidebar-feed::-webkit-scrollbar-thumb:hover { background: #ea580c; }
  .sidebar-card { display: flex; flex-direction: column; gap: 8px; text-decoration: none; border-bottom: 1px solid #1f2937; padding-bottom: 12px; }
  .sidebar-card-img { width: 100%; height: 100px; object-fit: cover; border-radius: 4px; }
  .sidebar-card-title { margin: 0; font-size: 0.85rem; font-weight: 600; color: #ffffff; line-height: 1.3; transition: color 0.2s ease; }
  .sidebar-card:hover .sidebar-card-title { color: #ea580c; }
  .no-articles, .no-more-articles { color: #9ca3af; font-size: 0.85rem; font-style: italic; }
  @media (max-width: 858px) {
    .category-grid { grid-template-columns: 1fr; }
    .right-sidebar { height: 400px; }
    .card-text-container { max-width: 100%; }
  }
</style>