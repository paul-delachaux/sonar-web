---
// 1. On récupère "isHome" en plus de "title" (par défaut false s'il n'est pas fourni)
const { title, isHome = false } = Astro.props;
import logoSonar from '../components/LogoSonarVdef.png';
import backgroundImage from '../assets/background.jpg';
import substackIcon from '../components/substack.png';
import Analytics from '@vercel/analytics/astro';
import AuthNav from '../components/AuthNav.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || '';
---

<html lang="fr">
    <head>
        <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" type="text/javascript"></script>
        <script async src="https://platform.twitter.com/widgets.js"></script>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- sizes=48x48 : empêche Chrome de préférer l'ICO au PNG adaptatif -->
        <link rel="icon" type="image/png" href="/favicon.png" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/png" href="/favicon_dark.png" media="(prefers-color-scheme: dark)" />
        <script is:inline>
            (function () {
                var DARK = '/favicon.png';
                var LIGHT = '/favicon_dark.png';

                function isDarkMode() {
                    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                }

                function applyFavicon() {
                    var href = (isDarkMode() ? DARK : LIGHT) + '?theme=' + (isDarkMode() ? 'dark' : 'light');

                    // Retirer tous les favicons PNG/SVG dynamiques (garder l'ICO legacy en secours)
                    document.querySelectorAll('link[rel="icon"]').forEach(function (el) {
                        var h = el.getAttribute('href') || '';
                        if (h.indexOf('favicon-legacy') !== -1) return;
                        el.parentNode.removeChild(el);
                    });

                    var link = document.createElement('link');
                    link.rel = 'icon';
                    link.type = 'image/png';
                    link.sizes = '32x32';
                    link.href = href;
                    document.head.appendChild(link);
                }

                applyFavicon();

                var mql = window.matchMedia('(prefers-color-scheme: dark)');
                if (mql.addEventListener) mql.addEventListener('change', applyFavicon);
                else if (mql.addListener) mql.addListener(applyFavicon);
            })();
        </script>
        <title>Sonar | {title}</title>
        <style is:global>
            html {
                /* Vos variables d'offset */
                --bg-offset-x: -3px;
                --bg-offset-y: -3px;

                background-color: #121f2f;
                background-image: url('../assets/background.jpg');
                background-repeat: no-repeat;
                
                /* Utilisation explicite des variables d'offset avec fallback */
                background-position: calc(50% + var(--bg-offset-x, 0px)) calc(0px + var(--bg-offset-y, 0px));
                
                background-size: cover;
                background-attachment: fixed;
                min-height: 100%;

                /* Empêche le défilement horizontal causé par les marges négatives */
                overflow-x: hidden; 
            }

            /* `background-attachment: fixed` est mal géré par les navigateurs mobiles
               (Chrome Android / Safari iOS) : l'image ne se repeint qu'une fois le
               scroll totalement arrêté, ce qui donne l'impression que le fond ne se
               met à jour qu'en bas de page. On repasse en "scroll" sous 968px. */
            @media (max-width: 968px) {
                html {
                    background-attachment: scroll;
                }
            }

            body { 
                /* Marge latérale du site : utilisée aussi par les marges négatives
                   du header/nav/footer pour qu'ils s'étendent bord à bord.
                   On la réduit en media query pour les petits écrans. */
                --page-pad: 20px;

                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; 
                margin: 0; 
                padding: var(--page-pad) var(--page-pad) 0 var(--page-pad);
                background: transparent;
                color: #eee; 
                /* S'assure que le body ne déborde pas */
                box-sizing: border-box;
            }

            /* --- STYLE DE L'EN-TÊTE DE L'ACCUEIL --- */
            header { 
                position: relative;
                text-align: center; 
                line-height: 60px;
                background-color: #02001d; 
                border-bottom: 2px solid #000; 
                padding-bottom: 20px; 
                backdrop-filter: blur(8px);
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
                margin-top: calc(-1 * var(--page-pad));
            }

            /* Le header accueil doit passer AU-DESSUS de la nav, sinon le menu
               Déconnexion (qui dépasse sous le header) se retrouve derrière. */
            header:not(.header-inner) {
                z-index: 40;
                overflow: visible;
            }

            /* --- ACTIONS ACCUEIL (CONNEXION + LANGUE) --- */
            .header-home-actions {
                position: absolute;
                top: 20px;
                right: 30px;
                z-index: 9999;
                display: flex;
                align-items: center;
                gap: 12px;
                line-height: normal;
            }

            .lang-selector-home-wrapper {
                position: static;
            }

            .sonar-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #ffffff;
                overflow: hidden;
                flex-shrink: 0;
                text-transform: uppercase;
                font-size: 0.95rem;
                background-color: #ea580c;
                line-height: 1;
            }

            .sonar-avatar-sm {
                width: 28px;
                height: 28px;
                font-size: 0.8rem;
            }

            .sonar-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            /* --- STYLE DE LA BARRE DE NAVIGATION DE L'ACCUEIL --- */
            .nav-bar { 
                position: relative;
                z-index: 10;
                display: flex; 
                justify-content: center; 
                gap: 15px; 
                background-color: #02001d; 
                border-bottom: 1px solid #000; 
                padding: 10px 0; 
                margin-bottom: 20px; 
                backdrop-filter: blur(8px);
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
            }

            .nav-bar a {
                text-decoration: none;
                color: #ffffff;
                font-weight: bold;
                transition: color 0.3s ease;
            }

            .nav-bar a:hover {
                color: #ff8826;
            }

            .fixed-logo-wrapper {
                    position: absolute; /* S'assure qu'il est bien positionné par rapport au header */
                    top: -10px;          /* Ajuste la distance depuis le haut (ex: 10px, 15px...) */
                    left: -10px;         /* Ajuste la distance depuis la gauche (pour être aligné avec ton --page-pad) */
                    z-index: 10000;     /* Reste toujours au-dessus du reste */
            }

                .fixed-logo-wrapper img {
                    width: 100px;       /* Ajuste la largeur (140px est parfois un peu grand sur petit écran) */
                    height: auto;       /* Conserve les proportions */
                    display: block;
            }

            /* --- STYLE DE LA BARRE COMPACTE DE NAVIGATION (HORS ACCUEIL) --- */
            .header-inner {
                position: relative;
                z-index: 40;
                display: flex;
                align-items: center;
                justify-content: space-between; 
                padding: 15px 30px;
                background-color: #02001d; 
                border-bottom: 1px solid #102136;
                backdrop-filter: blur(8px);
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
                margin-top: calc(-1 * var(--page-pad));
                margin-bottom: 30px;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            }

            .header-inner-logo {
                display: flex;
                align-items: center;
                width: 140px;
            }
            .header-inner-logo a {
                display: block;
                width: 100%;
                text-decoration: none;
                cursor: pointer;
            }

            .header-right-group {
                display: flex;
                align-items: center;
                gap: 40px; 
            }

            .header-toolbar {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-bar-inner {
                display: flex;
                gap: 25px;
                align-items: center;
            }

            .nav-bar-inner a {
                text-decoration: none;
                color: #ffffff;
                font-size: 1rem;
                font-weight: bold; 
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.3s ease;
            }

            .nav-bar-inner a:hover {
                color: #ff8826;
            }

            /* Bouton sélecteur de langue (Style Pilule) */
            .lang-selector-btn {
                background-color: #ffffff;
                color: #03031a;
                border: none;
                padding: 8px 20px;
                border-radius: 50px;
                font-weight: bold; 
                font-size: 0.9rem;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                cursor: pointer;
                transition: background-color 0.3s ease, transform 0.2s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .lang-selector-btn:hover {
                background-color: #e2e8f0;
                transform: scale(1.03);
            }

            .main-grid { 
                display: grid; 
                grid-template-columns: 2fr 1fr; 
                gap: 20px; 
                max-width: 1200px; 
                margin: 0 auto; 
                color: #000; 
            }
            .article-une { 
                background: white; 
                padding: 20px; 
                border: 1px solid #ddd; 
                border-radius: 2%;
            }
            .article-sidebar { 
                background: white; 
                padding: 15px; 
                border: 1px solid #ddd; 
                margin-bottom: 10px; 
                border-radius: 2%;
            }
            .site-footer {
                background-color: #0a131d;
                color: #cccccc;
                padding: 60px 20px 30px 20px;
                margin-top: 80px;
                border-top: 2px solid #000;
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
            }
            .footer-container {
                max-width: 1200px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                gap: 40px;
                padding-bottom: 40px;
            }
            .footer-brand h3 {
                color: #ffffff;
                margin: 0 0 15px 0;
                font-size: 1.4rem;
                letter-spacing: 1px;
            }
            .footer-brand p {
                color: #8fa0b5;
                font-size: 0.95rem;
                line-height: 1.6;
                margin: 0;
            }
            .footer-links h4, .footer-contact h4 {
                color: #ff8826;
                margin: 0 0 15px 0;
                font-size: 1.1rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .footer-links ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .footer-links li {
                margin-bottom: 10px;
            }
            .footer-links a {
                display: inline-block;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .footer-links a:hover {
                color: #ff8826; 
                transform: translateY(-2px);
            }
            .footer-contact p {
                margin: 0;
                font-size: 0.95rem;
                color: #b0c0d2;
                display: inline-flex;
                align-items: center;
                height: 20px;
            }
            .footer-contact {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }
            .footer-legal-section {
                border-top: 1px solid #1f334b;
                border-bottom: 1px solid #1f334b;
                padding: 25px 20px;
                margin: 20px auto 30px auto;
                max-width: 1200px;
                text-align: center;
            }
            .legal-section-title {
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.15em;
                color: #ffffff;
                text-transform: uppercase;
                margin: 0 0 15px 0;
            }
            .legal-links {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 30px;
                padding: 0;
                margin: 0;
            }
            .legal-link {
                font-size: 0.85rem;
                color: #b0c0d2;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: color 0.3s ease;
            }
            .legal-link::before {
                content: "▪";
                color: #ff8826; 
                font-size: 0.6rem;
            }
            .legal-link:hover {
                color: #ff8826;
            }
            .footer-bottom {
                max-width: 1200px;
                margin: 0 auto;
                padding-top: 20px;
                text-align: center;
                font-size: 0.85rem;
                color: #566981;
            }
            .instagram-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                color: #b0c0d2; 
                text-decoration: none;
                font-size: 0.95rem;
                line-height: 1;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .instagram-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .instagram-icon {
                width: 20px;
                height: 20px;
                display: block;
            }
            .instagram-wrapper {
                margin-top: 0;
                text-align: left; 
            }
            .contact-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .contact-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .mail-icon {
                width: 20px;
                height: 20px;
                fill: currentColor;
                color: #eee;
            }

            /* --- MENU MOBILE (BOUTON BURGER) --- */
            .mobile-nav-toggle {
                display: none;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 5px;
                width: 40px;
                height: 40px;
                padding: 0;
                background: transparent;
                border: none;
                cursor: pointer;
                flex-shrink: 0;
            }
            .mobile-nav-toggle span {
                display: block;
                width: 22px;
                height: 2px;
                background-color: #ffffff;
                border-radius: 2px;
                transition: transform 0.25s ease, opacity 0.25s ease;
            }
            nav.is-open .mobile-nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
            nav.is-open .mobile-nav-toggle span:nth-child(2) { opacity: 0; }
            nav.is-open .mobile-nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

            /* Responsive */
            /* EN : masquer sans retirer du flux → même grille / emplacements que FR */
            .article-card-item.is-lang-hidden {
                visibility: hidden;
                pointer-events: none;
            }
            @media (max-width: 968px) {
                body {
                    --page-pad: 14px;
                }

                /* --- En-tête page d'accueil --- */
                .fixed-logo-wrapper img {
                    width: 90px;
                }
                header h1 {
                    font-size: 1.8rem !important;
                }
                header {
                    line-height: 40px;
                    padding-top: 15px;
                    padding-bottom: 15px;
                }
                .header-home-actions {
                    top: 14px;
                    right: 14px;
                    gap: 8px;
                }
                .lang-selector-btn {
                    padding: 6px 14px;
                    font-size: 0.8rem;
                }

                /* --- Nav accueil : dropdown --- */
                .mobile-nav-toggle {
                    display: flex;
                }
                .nav-bar {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 0;
                    padding: 6px 0;
                }
                .nav-bar .mobile-nav-toggle {
                    align-self: center;
                    margin: 6px 0;
                }
                .nav-bar a {
                    display: none;
                    width: 100%;
                    text-align: center;
                    padding: 12px 0;
                    box-sizing: border-box;
                    border-top: 1px solid rgba(255, 255, 255, 0.08);
                }
                .nav-bar.is-open a {
                    display: block;
                }
                .nav-bar.is-open {
                    padding-bottom: 10px;
                }

                /* --- En-tête interne (hors accueil) --- */
                .header-inner {
                    flex-direction: row;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 15px;
                }
                .header-inner-logo {
                    width: 105px;
                }
                .header-right-group {
                    flex-direction: row;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    width: 100%;
                }
                .header-toolbar {
                    margin-left: auto;
                }
                .nav-bar-inner {
                    flex-wrap: wrap;
                    gap: 0;
                }
                .nav-bar-inner .mobile-nav-toggle {
                    margin-right: 4px;
                }
                .nav-bar-inner a {
                    display: none;
                    width: 100%;
                    text-align: center;
                    padding: 10px 0;
                    box-sizing: border-box;
                    border-top: 1px solid rgba(255, 255, 255, 0.08);
                }
                .nav-bar-inner.is-open {
                    width: 100%;
                    order: -1;
                    flex-direction: column;
                    align-items: stretch;
                }
                .nav-bar-inner.is-open a {
                    display: block;
                }

                /* --- Footer --- */
                .site-footer {
                    padding: 40px 16px 20px 16px;
                }
                .footer-container {
                    grid-template-columns: 1fr;
                    gap: 30px;
                    text-align: center;
                }
                .footer-contact {
                    align-items: center;
                }
                .instagram-wrapper {
                    text-align: center;
                }
                .legal-links {
                    gap: 12px 18px;
                }
                .footer-legal-section {
                    padding: 20px 15px;
                }
            }

            @media (max-width: 968px) {
                header h1 {
                    font-size: 1.5rem !important;
                }
                .fixed-logo-wrapper img {
                    width: 72px;
                }
                .header-inner-logo {
                    width: 85px;
                }
                .footer-brand h3 {
                    font-size: 1.2rem;
                }
                .legal-links {
                    flex-direction: column;
                    gap: 10px;
                }
                .footer-legal-section {
                    padding: 18px 12px;
                }
            }
            .substack-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                color: #b0c0d2; 
                text-decoration: none;
                font-size: 0.95rem;
                line-height: 1;
                transition: color 0.3s ease, transform 0.2s ease;
            }

            /* Style de l'icône Substack par défaut (Blanc) */
            .substack-icon {
                width: 20px;
                height: 20px;
                max-width: 20px;
                max-height: 20px;
                display: block;
                object-fit: contain;
                /* Rend le logo complètement blanc */
                filter: brightness(0) invert(1);
                transition: filter 0.3s ease, transform 0.2s ease;
            }

            /* Au survol du lien Substack */
            .substack-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }

            /* Au survol : l'icône retrouve sa couleur originale (orange Substack) */
            .substack-link:hover .substack-icon {
                filter: none;
            }
        </style>
    </head>
    <body>
        <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
            window.__SONAR_SUPABASE_URL__ = supabaseUrl;
            window.__SONAR_SUPABASE_ANON_KEY__ = supabaseAnonKey;
        </script>
        
        {isHome ? (
            /* ==========================================
               1. VERSION POUR LA PAGE D'ACCUEIL
               ========================================== */
            <>
                <div class="fixed-logo-wrapper">
                    <a href="/" style="text-decoration: none;">
                        <img src={logoSonar.src} alt="Logo Sonar" style="width: 140px; height: auto; display: block;" />
                    </a>
                </div>

                <header>
                    <h1 style="color: #ff8826; margin: 0; font-size: 2.5rem; letter-spacing: 2px;">
                        <a href="/" style="text-decoration: none; color: inherit;">SONAR</a>
                    </h1>

                    <div class="header-home-actions">
                        <AuthNav variant="home" />
                        <div class="lang-selector-home-wrapper">
                            <button class="lang-selector-btn">
                                FR | ENG
                            </button>
                        </div>
                    </div>
                </header>

                <nav class="nav-bar">
                    <button type="button" class="mobile-nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                    <a href="/" data-i18n="nav_home">Accueil</a>
                    <a href="/politique" data-i18n="nav_politique">Politique</a>
                    <a href="/culture" data-i18n="nav_culture">Culture</a>
                    <a href="/societe" data-i18n="nav_societe">Société</a>
                    <a href="/technologie" data-i18n="nav_tech">Technologie</a>
                </nav>
            </>
        ) : (
            /* ==========================================
               2. VERSION HORS ACCUEIL
               ========================================== */
            <header class="header-inner">
                <div class="header-inner-logo">
                    <a href="/" aria-label="Retour au menu principal">
                        <img src={logoSonar.src} alt="Logo Sonar" style="width: 100%; height: auto; display: block;" />
                    </a>
                </div>

                <div class="header-right-group">
                    <nav class="nav-bar-inner">
                        <button type="button" class="mobile-nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
                            <span></span><span></span><span></span>
                        </button>
                        <a href="/" data-i18n="nav_home">Accueil</a>
                        <a href="/politique" data-i18n="nav_politique">Politique</a>
                        <a href="/culture" data-i18n="nav_culture">Culture</a>
                        <a href="/societe" data-i18n="nav_societe">Société</a>
                        <a href="/technologie" data-i18n="nav_tech">Technologie</a>
                        </nav>

                    <div class="header-toolbar">
                        <AuthNav variant="inner" />
                        <div class="lang-selector-wrapper">
                            <button class="lang-selector-btn">
                                FR | ENG
                            </button>
                        </div>
                    </div>
                </div>
            </header>
        )}

        <main>
            <slot /> 
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <h3>SONAR</h3>
                    <p data-i18n="footer_description">Le média qui amplifie l'information. Analyses, décryptages et perspectives sur l'actualité politique, culturelle et technologique.</p>
                </div>
                
                <div class="footer-links">
                    <h4 data-i18n="footer_nav_title">Navigation</h4>
                    <ul>
                        <li><a href="/" data-i18n="nav_home">Accueil</a></li>
                        <li><a href="/politique" data-i18n="nav_politique">Politique</a></li>
                        <li><a href="/culture" data-i18n="nav_culture">Culture</a></li>
                        <li><a href="/societe" data-i18n="nav_societe">Société</a></li>
                        <li><a href="/technologie" data-i18n="nav_tech">Technologie</a></li>
                    </ul>
                </div>

                <div class="footer-contact">
                    <h4>Contact</h4>
                    <div class="mail-wrapper">
                        <a href="mailto:contact@lesonar.media" class="contact-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b0c0d2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mail-icon">
