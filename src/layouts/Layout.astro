                                <line x1="18" y1="6" x2="6" y2="18"></line>
                            </svg>
                        </button>
                        <a href="/" class="hv2-menu-brand">
                            <img src={logoSonar.src} alt="Logo Sonar" class="hv2-menu-brand-logo" />
