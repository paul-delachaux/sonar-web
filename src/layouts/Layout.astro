        </footer>

        <script type="application/json" id="hv2-search-data" set:html={searchIndexJson} />
        <script type="application/json" id="sonar-article-titles" set:html={articleTitlesJson} />
        <AccountDrawer />

        <!-- SCRIPT D'INTERACTION & GESTION DU DICTIONNAIRE ET DE LA LANGUE -->
        <script>
            import { dictionary } from '../data/dictionary.js';

            // --- RECHERCHE D'ARTICLES (header accueil + header compact) ---
            function loadSearchIndex() {
                try {
                    const raw = document.getElementById('hv2-search-data');
                    return raw && raw.textContent ? JSON.parse(raw.textContent) : [];
                } catch {
                    return [];
                }
            }

            function setupHeaderSearch(header, hooks = {}) {
                const searchBtn = header.querySelector('.hv2-search-toggle');
                const searchWrap = header.querySelector('.hv2-search-wrap');
                const searchInput = searchWrap ? searchWrap.querySelector('.hv2-search-input') : null;
                const resultsList = searchWrap ? searchWrap.querySelector('[data-search-results]') : null;
                const searchIndex = loadSearchIndex();

                function isSearchOpen() {
                    return Boolean(searchWrap && searchWrap.classList.contains('is-open'));
                }
                function closeSearch() {
                    if (!searchWrap || !isSearchOpen()) return;
                    searchWrap.classList.remove('is-open');
                    if (searchBtn) searchBtn.setAttribute('aria-expanded', 'false');
                    if (searchInput) searchInput.value = '';
                    if (resultsList) {
                        resultsList.hidden = true;
                        resultsList.innerHTML = '';
                    }
                }
                function openSearch() {
                    if (!searchWrap) return;
                    if (typeof hooks.onOpen === 'function') hooks.onOpen();
                    searchWrap.classList.add('is-open');
                    if (searchBtn) searchBtn.setAttribute('aria-expanded', 'true');
                    if (searchInput) searchInput.focus();
                }
                function toggleSearch() {
                    if (isSearchOpen()) closeSearch();
                    else openSearch();
                }

                if (searchBtn) {
                    searchBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        toggleSearch();
                    });
                }
                document.addEventListener('click', (e) => {
                    const insideHeader = header.contains(e.target);
                    const insideExtra = typeof hooks.isInside === 'function' && hooks.isInside(e.target);
                    if (!insideHeader && !insideExtra) closeSearch();
                });
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') closeSearch();
                });
                if (searchWrap) {
                    searchWrap.addEventListener('click', (e) => e.stopPropagation());
                }

                const normalize = (str) => String(str || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase();

                function renderResults(query) {
                    if (!resultsList) return;
                    const q = query.trim();
                    const langKey = (localStorage.getItem('site_lang') || 'FR').toUpperCase();

                    if (!q) {
                        resultsList.hidden = true;
                        resultsList.innerHTML = '';
                        return;
                    }

                    let regex;
                    try {
                        const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                        regex = new RegExp(normalize(escaped));
                    } catch {
                        resultsList.hidden = true;
                        return;
                    }

                    const matches = searchIndex.filter((item) => {
                        const title = (langKey === 'EN' && item.titleEn) ? item.titleEn : item.title;
                        return regex.test(normalize(title));
                    }).slice(0, 8);

                    resultsList.innerHTML = '';
                    if (matches.length === 0) {
                        const li = document.createElement('li');
                        li.className = 'hv2-search-empty';
                        li.textContent = (dictionary[langKey] && dictionary[langKey].search_no_results)
                            || dictionary.FR.search_no_results;
                        resultsList.appendChild(li);
                    } else {
                        matches.forEach((item) => {
                            const title = (langKey === 'EN' && item.titleEn) ? item.titleEn : item.title;
                            const li = document.createElement('li');
                            const a = document.createElement('a');
                            a.href = `/articles/${item.slug}`;
                            a.textContent = title;
                            li.appendChild(a);
                            resultsList.appendChild(li);
                        });
                    }
                    resultsList.hidden = false;
                }

                if (searchInput) {
                    searchInput.addEventListener('input', (e) => renderResults(e.target.value));
                    window.addEventListener('languageChanged', () => {
                        if (isSearchOpen()) renderResults(searchInput.value);
                    });
                }

                return { closeSearch, isSearchOpen };
            }

            // --- HEADER ACCUEIL (v2) : menu catégories + recherche d'articles ---
            function setupHeaderV2() {
                const header = document.querySelector('.header-v2');
                if (!header) return; // Header v2 uniquement présent sur la page d'accueil

                // Le menu latéral et son voile sombre sont rendus hors du header (voir
                // Layout.astro) pour rester positionnés par rapport à la fenêtre, pas au
                // header (qui a un backdrop-filter, cf. commentaire dans le markup).
                const overlay = document.getElementById('hv2-overlay');
                const menuPanel = document.getElementById('hv2-menu-panel');
                const menuCloseBtn = menuPanel ? menuPanel.querySelector('.hv2-menu-close') : null;
                const burgerBtn = header.querySelector('.hv2-burger');

                function isMenuOpen() {
                    return Boolean(menuPanel && menuPanel.classList.contains('is-open'));
                }

                function closeMenu() {
                    if (!menuPanel || !isMenuOpen()) return;
                    menuPanel.classList.remove('is-open');
                    if (overlay) overlay.classList.remove('is-open');
                    if (burgerBtn) burgerBtn.setAttribute('aria-expanded', 'false');
                    menuPanel.querySelectorAll('.nav-domain.is-open').forEach((item) => {
                        item.classList.remove('is-open');
                        const toggle = item.querySelector('.nav-domain-toggle');
                        if (toggle) toggle.setAttribute('aria-expanded', 'false');
                    });
                }

                const searchApi = setupHeaderSearch(header, {
                    onOpen: closeMenu,
                    isInside: (target) => Boolean(menuPanel && menuPanel.contains(target)),
                });

                function openMenu() {
                    if (!menuPanel) return;
                    searchApi.closeSearch();
                    menuPanel.classList.add('is-open');
                    if (overlay) overlay.classList.add('is-open');
                    if (burgerBtn) burgerBtn.setAttribute('aria-expanded', 'true');
                }
                function toggleMenu() {
                    if (isMenuOpen()) closeMenu();
                    else openMenu();
                }

                if (burgerBtn) {
                    burgerBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        toggleMenu();
                    });
                }
                if (menuCloseBtn) {
                    menuCloseBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        closeMenu();
                    });
                }
                if (overlay) {
                    overlay.addEventListener('click', closeMenu);
                }
                if (menuPanel) {
                    menuPanel.querySelectorAll('.hv2-menu-links a').forEach((link) => {
                        link.addEventListener('click', closeMenu);
                    });
                    menuPanel.querySelectorAll('.nav-domain-toggle').forEach((btn) => {
                        btn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            const item = btn.closest('.nav-domain');
                            if (!item) return;
                            const willOpen = !item.classList.contains('is-open');
                            menuPanel.querySelectorAll('.nav-domain.is-open').forEach((other) => {
                                if (other === item) return;
                                other.classList.remove('is-open');
                                const otherBtn = other.querySelector('.nav-domain-toggle');
                                if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                            });
                            item.classList.toggle('is-open', willOpen);
                            btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                        });
                    });
                    menuPanel.addEventListener('click', (e) => e.stopPropagation());
                }

                document.addEventListener('click', (e) => {
                    const insideHeader = header.contains(e.target);
                    const insideMenu = menuPanel && menuPanel.contains(e.target);
                    if (!insideHeader && !insideMenu) closeMenu();
                });
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') closeMenu();
                });
            }

            function setupInnerHeaderSearch() {
                document.querySelectorAll('.header-inner').forEach((header) => {
                    setupHeaderSearch(header);
                });
            }

            // Accueil uniquement : remplace en douceur le grand header par le bandeau
            // compact ("header-inner") une fois qu'il a totalement défilé hors de
            // l'écran. Ne fait rien sur les autres pages (pas de .header-v2/.header-fixed-clone).
            function setupStickyHeader() {
                const heroHeader = document.querySelector('.header-v2');
                const stickyHeader = document.querySelector('.header-fixed-clone');
                if (!heroHeader || !stickyHeader) return;

                function update() {
                    const isFullyScrolledPast = heroHeader.getBoundingClientRect().bottom <= 0;
                    stickyHeader.classList.toggle('is-visible', isFullyScrolledPast);
                }

                update();
                window.addEventListener('scroll', update, { passive: true });
                window.addEventListener('resize', update);
            }

            function applyLanguage(lang) {
                const langKey = lang.toUpperCase(); 

                // 1. Sauvegarde dans le navigateur
                localStorage.setItem('site_lang', langKey);
                document.documentElement.lang = langKey.toLowerCase();

                // 2. Application des traductions fixes (navigation, footer)
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    if (dictionary[langKey] && dictionary[langKey][key]) {
                        el.textContent = dictionary[langKey][key];
                    }
                });

                // 3. Application des traductions d'articles
                document.querySelectorAll('[data-fr][data-en]').forEach(el => {
                    if (el.closest('.category-badge')) return;
                    const text = langKey === 'EN' ? el.getAttribute('data-en') : el.getAttribute('data-fr');
                    if (text && text !== 'undefined') {
                        el.textContent = text;
                    }
                });

                document.querySelectorAll('.category-badge').forEach((el) => {
                    const isEn = langKey === 'EN';
                    const main = isEn ? el.getAttribute('data-en-main') : el.getAttribute('data-fr-main');
                    const sub = isEn ? el.getAttribute('data-en-sub') : el.getAttribute('data-fr-sub');
                    const mainEl = el.querySelector('.category-badge-main');
                    const sepEl = el.querySelector('.category-badge-sep');
                    const subEl = el.querySelector('.category-badge-sub');
                    if (mainEl && main) mainEl.textContent = main;
                    const hasSub = Boolean(sub) && el.getAttribute('data-main-only') !== 'true';
                    if (sepEl) sepEl.hidden = !hasSub;
                    if (subEl) {
                        subEl.hidden = !hasSub;
                        if (hasSub) subEl.textContent = sub;
                    }
                });

                // 4. Liens article (href)
                document.querySelectorAll('[data-href-fr]').forEach(el => {
                    const hrefEn = el.getAttribute('data-href-en');
                    const hrefFr = el.getAttribute('data-href-fr');
                    if (langKey === 'EN' && hrefEn) el.setAttribute('href', hrefEn);
                    else if (hrefFr) el.setAttribute('href', hrefFr);
                });

                // 5. Images
                document.querySelectorAll('[data-img-fr]').forEach(el => {
                    const imgEn = el.getAttribute('data-img-en');
                    const imgFr = el.getAttribute('data-img-fr');
                    if (langKey === 'EN' && imgEn) el.setAttribute('src', imgEn);
                    else if (imgFr) el.setAttribute('src', imgFr);
                });

                // 6. Background-images
                document.querySelectorAll('[data-bg-fr]').forEach(el => {
                    const bgEn = el.getAttribute('data-bg-en');
                    const bgFr = el.getAttribute('data-bg-fr');
                    const targetBg = (langKey === 'EN' && bgEn) ? bgEn : bgFr;
                    if (targetBg) {
                        el.style.backgroundImage = `url('${targetBg}')`;
                    }
                });

                // 7. Masquer les cartes sans version EN sans casser la grille (même layout que FR)
                document.documentElement.classList.toggle('lang-en', langKey === 'EN');
                document.querySelectorAll('.article-card-item').forEach(card => {
                    const hasEn = card.getAttribute('data-has-en') === 'true';
                    const hide = langKey === 'EN' && !hasEn;
                    card.classList.toggle('is-lang-hidden', hide);
                    card.setAttribute('aria-hidden', hide ? 'true' : 'false');
                    if (hide) card.setAttribute('tabindex', '-1');
                    else card.removeAttribute('tabindex');
                });

                // 8. Blocs de contenu long FR/EN (ex: page déontologie)
                document.querySelectorAll('[data-lang-content]').forEach(el => {
                    const blockLang = (el.getAttribute('data-lang-content') || '').toUpperCase();
                    const show = blockLang === langKey;
                    el.hidden = !show;
                    el.setAttribute('aria-hidden', show ? 'false' : 'true');
                });

                // 9. Sélecteur FR / EN à deux boutons séparés (header accueil + header
                // compact) : met en surbrillance le mode actuellement sélectionné.
                document.querySelectorAll('.hv2-lang-btn').forEach(btn => {
                    const isActive = btn.getAttribute('data-lang-btn') === langKey;
                    btn.classList.toggle('is-active', isActive);
                    btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                });

                // 9ter. Placeholders traduits (ex: champ de recherche du header accueil)
                document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                    const key = el.getAttribute('data-i18n-placeholder');
                    if (dictionary[langKey] && dictionary[langKey][key]) {
                        el.setAttribute('placeholder', dictionary[langKey][key]);
                    }
                });

                // 10. Notifier les pages (ex: brèves) qui écoutent le changement
                window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: langKey } }));
            }

            document.addEventListener('DOMContentLoaded', () => {
                const savedLang = localStorage.getItem('site_lang') || 'FR';
                applyLanguage(savedLang);
                setupHeaderV2();
                setupInnerHeaderSearch();
                setupStickyHeader();

                // Sélecteur FR / EN à deux boutons séparés (header accueil + header compact)
                document.querySelectorAll('.hv2-lang-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const target = btn.getAttribute('data-lang-btn');
                        const currentLang = localStorage.getItem('site_lang') || 'FR';
                        if (target && target !== currentLang) applyLanguage(target);
                    });
                });

                // --- MENU MOBILE (BOUTON BURGER) ---
                document.querySelectorAll('.mobile-nav-toggle').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const nav = btn.closest('nav');
                        if (!nav) return;
                        const isOpen = nav.classList.toggle('is-open');
                        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    });
                });

                // Ferme le menu déroulant quand on choisit un lien
                document.querySelectorAll('.nav-bar-inner a').forEach((link) => {
                    link.addEventListener('click', () => {
                        const nav = link.closest('nav');
                        if (!nav) return;
                        nav.classList.remove('is-open');
                        const btn = nav.querySelector('.mobile-nav-toggle');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    });
                });

                // Ferme le menu si on repasse en affichage bureau
                window.addEventListener('resize', () => {
                    if (window.innerWidth > 860) {
                        document.querySelectorAll('nav.is-open').forEach((nav) => {
                            nav.classList.remove('is-open');
                            const btn = nav.querySelector('.mobile-nav-toggle');
                            if (btn) btn.setAttribute('aria-expanded', 'false');
                        });
                    }
                });
            });
        </script>
    <Analytics />
    </body>
</html>