---
// 1. On récupère "isHome" en plus de "title" (par défaut false s'il n'est pas fourni)
const { title, isHome = false } = Astro.props;
import logoSonar from '../components/LogoSonarVdef.png';
import backgroundImage from '../assets/background.png';
---

<html lang="fr">
    <head>
        <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" type="text/javascript"></script>
        <script async src="https://platform.twitter.com/widgets.js"></script>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
        <title>{title} | Sonar</title>
        <style is:global>
            body { 
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; 
                margin: 0; 
                padding: 20px 20px 0 20px;
                background-color: #121f2f;
                background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('../assets/fond_sonar.png');
                background-repeat: repeat;
                background-position: center;
                background-size: 100% 100%;
                color: #eee; 
            }

            /* --- STYLE DE L'EN-TÊTE DE L'ACCUEIL --- */
            header { 
                position: relative;
                text-align: center; 
                line-height: 60px;
                background-color: #02001d; 
                border-bottom: 2px solid #000; 
                padding-bottom: 20px; 
                backdrop-filter: blur(8px);
                margin-left: -20px;
                margin-right: -20px;
                margin-top: -20px;
            }

            /* --- BOUTON DE LANGUE POUR LA PAGE D'ACCUEIL --- */
            .lang-selector-home-wrapper {
                position: absolute;
                top: 20px;
                right: 30px;
                z-index: 9999;
            }

            /* --- STYLE DE LA BARRE DE NAVIGATION DE L'ACCUEIL --- */
            .nav-bar { 
                display: flex; 
                justify-content: center; 
                gap: 15px; 
                background-color: #02001d; 
                border-bottom: 1px solid #000; 
                padding: 10px 0; 
                margin-bottom: 20px; 
                backdrop-filter: blur(8px);
                margin-left: -20px;
                margin-right: -20px;
            }

            .nav-bar a {
                text-decoration: none;
                color: #ffffff;
                font-weight: bold;
                transition: color 0.3s ease;
            }

            .nav-bar a:hover {
                color: #ff8826;
            }

            .fixed-logo-wrapper {
                position: absolute;
                top: -5px; 
                left: 0px;
                z-index: 9999;
            }

            /* --- STYLE DE LA BARRE COMPACTE DE NAVIGATION (HORS ACCUEIL) --- */
            .header-inner {
                display: flex;
                align-items: center;
                justify-content: space-between; 
                padding: 15px 30px;
                background-color: #02001d; 
                border-bottom: 1px solid #102136;
                backdrop-filter: blur(8px);
                margin-left: -20px;
                margin-right: -20px;
                margin-top: -20px;
                margin-bottom: 30px;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            }

            .header-inner-logo {
                display: flex;
                align-items: center;
                width: 140px;
            }
            .header-inner-logo a {
                display: block;
                width: 100%;
                text-decoration: none;
                cursor: pointer;
            }

            .header-right-group {
                display: flex;
                align-items: center;
                gap: 40px; 
            }

            .nav-bar-inner {
                display: flex;
                gap: 25px;
                align-items: center;
            }

            .nav-bar-inner a {
                text-decoration: none;
                color: #ffffff;
                font-size: 1rem;
                font-weight: bold; 
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.3s ease;
            }

            .nav-bar-inner a:hover {
                color: #ff8826;
            }

            /* Bouton sélecteur de langue (Style Pilule) */
            .lang-selector-btn {
                background-color: #ffffff;
                color: #03031a;
                border: none;
                padding: 8px 20px;
                border-radius: 50px;
                font-weight: bold; 
                font-size: 0.9rem;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                cursor: pointer;
                transition: background-color 0.3s ease, transform 0.2s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .lang-selector-btn:hover {
                background-color: #e2e8f0;
                transform: scale(1.03);
            }

            .main-grid { 
                display: grid; 
                grid-template-columns: 2fr 1fr; 
                gap: 20px; 
                max-width: 1200px; 
                margin: 0 auto; 
                color: #000; 
            }
            .article-une { 
                background: white; 
                padding: 20px; 
                border: 1px solid #ddd; 
                border-radius: 2%;
            }
            .article-sidebar { 
                background: white; 
                padding: 15px; 
                border: 1px solid #ddd; 
                margin-bottom: 10px; 
                border-radius: 2%;
            }
            .site-footer {
                background-color: #0a131d;
                color: #cccccc;
                padding: 60px 20px 30px 20px;
                margin-top: 80px;
                border-top: 2px solid #000;
                margin-left: -20px;
                margin-right: -20px;
            }
            .footer-container {
                max-width: 1200px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                gap: 40px;
                padding-bottom: 40px;
            }
            .footer-brand h3 {
                color: #ffffff;
                margin: 0 0 15px 0;
                font-size: 1.4rem;
                letter-spacing: 1px;
            }
            .footer-brand p {
                color: #8fa0b5;
                font-size: 0.95rem;
                line-height: 1.6;
                margin: 0;
            }
            .footer-links h4, .footer-contact h4 {
                color: #ff8826;
                margin: 0 0 15px 0;
                font-size: 1.1rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .footer-links ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .footer-links li {
                margin-bottom: 10px;
            }
            .footer-links a {
                display: inline-block;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .footer-links a:hover {
                color: #ff8826; 
                transform: translateY(-2px);
            }
            .footer-contact p {
                margin: 0;
                font-size: 0.95rem;
                color: #b0c0d2;
                display: inline-flex;
                align-items: center;
                height: 20px;
            }
            .footer-contact {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }
            .footer-legal-section {
                border-top: 1px solid #1f334b;
                border-bottom: 1px solid #1f334b;
                padding: 25px 20px;
                margin: 20px auto 30px auto;
                max-width: 1200px;
                text-align: center;
            }
            .legal-section-title {
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.15em;
                color: #ffffff;
                text-transform: uppercase;
                margin: 0 0 15px 0;
            }
            .legal-links {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 30px;
                padding: 0;
                margin: 0;
            }
            .legal-link {
                font-size: 0.85rem;
                color: #b0c0d2;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: color 0.3s ease;
            }
            .legal-link::before {
                content: "▪";
                color: #ff8826; 
                font-size: 0.6rem;
            }
            .legal-link:hover {
                color: #ff8826;
            }
            .footer-bottom {
                max-width: 1200px;
                margin: 0 auto;
                padding-top: 20px;
                text-align: center;
                font-size: 0.85rem;
                color: #566981;
            }
            .instagram-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                color: #b0c0d2; 
                text-decoration: none;
                font-size: 0.95rem;
                line-height: 1;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .instagram-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .instagram-icon {
                width: 20px;
                height: 20px;
                display: block;
            }
            .instagram-wrapper {
                margin-top: 0;
                text-align: left; 
            }
            .contact-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .contact-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .mail-icon {
                width: 20px;
                height: 20px;
                fill: currentColor;
                color: #eee;
            }

            /* Responsive */
            @media (max-width: 768px) {
                .header-inner {
                    flex-direction: column;
                    gap: 15px;
                    padding: 15px;
                }
                .header-right-group {
                    flex-direction: column;
                    gap: 15px;
                }
                .nav-bar-inner {
                    flex-wrap: wrap;
                    justify-content: center;
                    gap: 15px;
                }
                .footer-container {
                    grid-template-columns: 1fr;
                    gap: 30px;
                }
                .legal-links {
                    gap: 15px 20px;
                }
                .lang-selector-home-wrapper {
                    top: 15px;
                    right: 15px;
                }
            }
        </style>
    </head>
    <body>
        
        {isHome ? (
            /* ==========================================
               1. VERSION POUR LA PAGE D'ACCUEIL
               ========================================== */
            <>
                <div class="fixed-logo-wrapper">
                    <a href="/" style="text-decoration: none;">
                        <img src={logoSonar.src} alt="Logo Sonar" style="width: 140px; height: auto; display: block;" />
                    </a>
                </div>

                <header>
                    <h1 style="color: #ff8826; margin: 0; font-size: 2.5rem; letter-spacing: 2px;">
                        <a href="/" style="text-decoration: none; color: inherit;">SONAR</a>
                    </h1>

                    <!-- Bouton Sélecteur de Langue -->
                    <div class="lang-selector-home-wrapper">
                        <button class="lang-selector-btn">
                            FR | ENG
                        </button>
                    </div>
                </header>

                <nav class="nav-bar">
                    <a href="/" data-i18n="nav_home">Accueil</a>
                    <a href="/politique" data-i18n="nav_politique">Politique</a>
                    <a href="/culture" data-i18n="nav_culture">Culture</a>
                    <a href="/societe" data-i18n="nav_societe">Société</a>
                    <a href="/technologie" data-i18n="nav_tech">Technologie</a>
                </nav>
            </>
        ) : (
            /* ==========================================
               2. VERSION HORS ACCUEIL
               ========================================== */
            <header class="header-inner">
                <div class="header-inner-logo">
                    <a href="/" aria-label="Retour au menu principal">
                        <img src={logoSonar.src} alt="Logo Sonar" style="width: 100%; height: auto; display: block;" />
                    </a>
                </div>

                <div class="header-right-group">
                    <nav class="nav-bar-inner">
                        <a href="/" data-i18n="nav_home">Accueil</a>
                        <a href="/societe" data-i18n="nav_societe">Société</a>
                        <a href="/technologie" data-i18n="nav_tech">Technologie</a>
                        <a href="/politique" data-i18n="nav_politique">Politique</a>
                        <a href="/culture" data-i18n="nav_culture">Culture</a>
                    </nav>

                    <div class="lang-selector-wrapper">
                        <button class="lang-selector-btn">
                            FR | ENG
                        </button>
                    </div>
                </div>
            </header>
        )}

        <main>
            <slot /> 
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <h3>SONAR</h3>
                    <p data-i18n="footer_description">Le média qui amplifie l'information. Analyses, décryptages et perspectives sur l'actualité politique, culturelle et technologique.</p>
                </div>
                
                <div class="footer-links">
                    <h4 data-i18n="footer_nav_title">Navigation</h4>
                    <ul>
                        <li><a href="/" data-i18n="nav_home">Accueil</a></li>
                        <li><a href="/politique" data-i18n="nav_politique">Politique</a></li>
                        <li><a href="/culture" data-i18n="nav_culture">Culture</a></li>
                        <li><a href="/societe" data-i18n="nav_societe">Société</a></li>
                        <li><a href="/technologie" data-i18n="nav_tech">Technologie</a></li>
                    </ul>
                </div>

                <div class="footer-contact">
                    <h4>Contact</h4>
                    <div class="mail-wrapper">
                        <a href="mailto:contact@lesonar.media" class="contact-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b0c0d2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mail-icon">
                                <path d="M4 4h16v16H4z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>contact@lesonar.media</span>
                        </a>
                    </div>
                    <p>Maison de la presse — Paris, France</p>
                    <div class="instagram-wrapper">
                        <a href="https://www.instagram.com/banshee.international/" target="_blank" rel="noopener noreferrer" class="instagram-link" aria-label="Suivez SONAR sur Instagram">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="instagram-icon">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                            <span>@banshee.international</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-legal-section">
                <p class="legal-section-title" data-i18n="footer_legal_title">Informations légales Sonar</p>
                <div class="legal-links">
                    <a href="/deontologie" class="legal-link" data-i18n="footer_deontologie">Méthodologie et Déontologie</a>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; {new Date().getFullYear()} SONAR. <span data-i18n="footer_rights">Tous droits réservés.</span></p>
            </div>
        </footer>

        <!-- SCRIPT D'INTERACTION & GESTION DU DICTIONNAIRE ET DE LA LANGUE -->
        <script>
            import { dictionary } from '../data/dictionary.js';

            function applyLanguage(lang) {
                const langKey = lang.toUpperCase(); 

                // 1. Sauvegarde dans le navigateur
                localStorage.setItem('site_lang', langKey);
                document.documentElement.lang = langKey.toLowerCase();

                // 2. Application des traductions fixes (navigation, footer)
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    if (dictionary[langKey] && dictionary[langKey][key]) {
                        el.textContent = dictionary[langKey][key];
                    }
                });

                // 3. Application des traductions d'articles
                document.querySelectorAll('[data-fr][data-en]').forEach(el => {
                    const text = langKey === 'EN' ? el.getAttribute('data-en') : el.getAttribute('data-fr');
                    if (text && text !== 'undefined') {
                        el.textContent = text;
                    }
                });

                // 4. Filtrage / Masquage des cartes d'articles sans traduction Anglaise
                document.querySelectorAll('.article-card-item').forEach(card => {
                    const hasEn = card.getAttribute('data-has-en') === 'true';
                    if (langKey === 'EN' && !hasEn) {
                        card.style.display = 'none';
                    } else {
                        card.style.display = '';
                    }
                });

                // 5. Mise à jour visuelle des boutons de langue
                document.querySelectorAll('.lang-selector-btn').forEach(btn => {
                    btn.textContent = langKey === 'EN' ? 'ENG | FR' : 'FR | ENG';
                });
            }

            document.addEventListener('DOMContentLoaded', () => {
                const savedLang = localStorage.getItem('site_lang') || 'FR';
                applyLanguage(savedLang);

                document.querySelectorAll('.lang-selector-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const currentLang = localStorage.getItem('site_lang') || 'FR';
                        const newLang = currentLang === 'FR' ? 'EN' : 'FR';
                        applyLanguage(newLang);
                    });
                });
            });

            // Netlify Identity
            if (window.netlifyIdentity) {
                window.netlifyIdentity.on("init", user => {
                    if (!user) {
                        window.netlifyIdentity.on("login", () => {
                            document.location.href = "/admin/";
                        });
                    }
                });
            }
        </script>
    </body>
</html>