        <!-- SCRIPT D'INTERACTION & GESTION DU DICTIONNAIRE ET DE LA LANGUE -->
        <script>
            import { dictionary } from '../data/dictionary.js';

            function applyLanguage(lang) {
                const langKey = lang.toUpperCase(); 

                // 1. Sauvegarde dans le navigateur
                localStorage.setItem('site_lang', langKey);
                document.documentElement.lang = langKey.toLowerCase();

                // 2. Application des traductions fixes (navigation, footer)
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    if (dictionary[langKey] && dictionary[langKey][key]) {
                        el.textContent = dictionary[langKey][key];
                    }
                });

                // 3. Application des traductions d'articles
                document.querySelectorAll('[data-fr][data-en]').forEach(el => {
                    const text = langKey === 'EN' ? el.getAttribute('data-en') : el.getAttribute('data-fr');
                    if (text && text !== 'undefined') {
                        el.textContent = text;
                    }
                });

                // 4. Liens article (href)
                document.querySelectorAll('[data-href-fr]').forEach(el => {
                    const hrefEn = el.getAttribute('data-href-en');
                    const hrefFr = el.getAttribute('data-href-fr');
                    if (langKey === 'EN' && hrefEn) el.setAttribute('href', hrefEn);
                    else if (hrefFr) el.setAttribute('href', hrefFr);
                });

                // 5. Images
                document.querySelectorAll('[data-img-fr]').forEach(el => {
                    const imgEn = el.getAttribute('data-img-en');
                    const imgFr = el.getAttribute('data-img-fr');
                    if (langKey === 'EN' && imgEn) el.setAttribute('src', imgEn);
                    else if (imgFr) el.setAttribute('src', imgFr);
                });

                // 6. Background-images
                document.querySelectorAll('[data-bg-fr]').forEach(el => {
                    const bgEn = el.getAttribute('data-bg-en');
                    const bgFr = el.getAttribute('data-bg-fr');
                    const targetBg = (langKey === 'EN' && bgEn) ? bgEn : bgFr;
                    if (targetBg) {
                        el.style.backgroundImage = `url('${targetBg}')`;
                    }
                });

                // 7. Masquer les cartes sans version EN sans casser la grille (même layout que FR)
                document.documentElement.classList.toggle('lang-en', langKey === 'EN');
                document.querySelectorAll('.article-card-item').forEach(card => {
                    const hasEn = card.getAttribute('data-has-en') === 'true';
                    const hide = langKey === 'EN' && !hasEn;
                    card.classList.toggle('is-lang-hidden', hide);
                    card.setAttribute('aria-hidden', hide ? 'true' : 'false');
                    if (hide) card.setAttribute('tabindex', '-1');
                    else card.removeAttribute('tabindex');
                });

                // 8. Blocs de contenu long FR/EN (ex: page déontologie)
                document.querySelectorAll('[data-lang-content]').forEach(el => {
                    const blockLang = (el.getAttribute('data-lang-content') || '').toUpperCase();
                    const show = blockLang === langKey;
                    el.hidden = !show;
                    el.setAttribute('aria-hidden', show ? 'false' : 'true');
                });

                // 9. Mise à jour visuelle des boutons de langue
                document.querySelectorAll('.lang-selector-btn').forEach(btn => {
                    btn.textContent = langKey === 'EN' ? 'ENG | FR' : 'FR | ENG';
                });

                // 10. Notifier les pages (ex: brèves) qui écoutent le changement
                window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang: langKey } }));
            }

            document.addEventListener('DOMContentLoaded', () => {
                const savedLang = localStorage.getItem('site_lang') || 'FR';
                applyLanguage(savedLang);

                document.querySelectorAll('.lang-selector-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const currentLang = localStorage.getItem('site_lang') || 'FR';
                        const newLang = currentLang === 'FR' ? 'EN' : 'FR';
                        applyLanguage(newLang);
                    });
                });

                // --- MENU MOBILE (BOUTON BURGER) ---
                document.querySelectorAll('.mobile-nav-toggle').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const nav = btn.closest('nav');
                        if (!nav) return;
                        const isOpen = nav.classList.toggle('is-open');
                        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    });
                });

                // Ferme le menu déroulant quand on choisit un lien
                document.querySelectorAll('.nav-bar a, .nav-bar-inner a').forEach((link) => {
                    link.addEventListener('click', () => {
                        const nav = link.closest('nav');
                        if (!nav) return;
                        nav.classList.remove('is-open');
                        const btn = nav.querySelector('.mobile-nav-toggle');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    });
                });

                // Ferme le menu si on repasse en affichage bureau
                window.addEventListener('resize', () => {
                    if (window.innerWidth > 860) {
                        document.querySelectorAll('nav.is-open').forEach((nav) => {
                            nav.classList.remove('is-open');
                            const btn = nav.querySelector('.mobile-nav-toggle');
                            if (btn) btn.setAttribute('aria-expanded', 'false');
                        });
                    }
                });
            });

            // Netlify Identity
            if (window.netlifyIdentity) {
                window.netlifyIdentity.on("init", user => {
                    if (!user) {
                        window.netlifyIdentity.on("login", () => {
                            document.location.href = "/admin/";
                        });
                    }
                });
            }
        </script>
    <Analytics />
    </body>
</html>