// 1. On récupère "isHome" en plus de "title" (par défaut false s'il n'est pas fourni)
const { title, isHome = false } = Astro.props;
import logoSonar from '../components/LogoSonarVdef.png';
import logoEye from '../components/LogoSonar3.png';
import backgroundImage from '../assets/background.jpg';
import substackIcon from '../components/substack.png';
import Analytics from '@vercel/analytics/astro';
import AuthNav from '../components/AuthNav.astro';
import HeaderInner from '../components/HeaderInner.astro';
import AccountDrawer from '../components/AccountDrawer.astro';
import NavDomains from '../components/NavDomains.astro';
import { getCollection } from 'astro:content';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || '';

const visibleArticles = (await getCollection('articles'))
    .filter((art) => art.data.isVisible !== false);

const searchIndex = visibleArticles.map((art) => ({
    slug: art.id,
    title: art.data.title,
    titleEn: art.data.title_en || null,
    category: art.data.category,
}));
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

const articleTitlesJson = JSON.stringify(
    visibleArticles.map((art) => ({
        slug: art.id,
        title: art.data.title,
        titleEn: art.data.title_en || null,
    }))
).replace(/</g, '\\u003c');
---

<html lang="fr">
    <head>
        <script async src="https://platform.twitter.com/widgets.js"></script>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- sizes=48x48 : empêche Chrome de préférer l'ICO au PNG adaptatif -->
        <link rel="icon" type="image/png" href="/favicon.png" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/png" href="/favicon_dark.png" media="(prefers-color-scheme: dark)" />
        <!-- "Baskerville Pro" (Adobe/Linotype) n'est pas disponible pour le web sans licence.
             Libre Baskerville (Google Fonts) est l'équivalent libre le plus proche visuellement,
             utilisé uniquement pour le titre "L'Echo du Sonar" du header de l'accueil. -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
        <script is:inline>
            (function () {
                var DARK = '/favicon.png';
                var LIGHT = '/favicon_dark.png';

                function isDarkMode() {
                    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                }

                function applyFavicon() {
                    var href = (isDarkMode() ? DARK : LIGHT) + '?theme=' + (isDarkMode() ? 'dark' : 'light');

                    // Retirer tous les favicons PNG/SVG dynamiques (garder l'ICO legacy en secours)
                    document.querySelectorAll('link[rel="icon"]').forEach(function (el) {
                        var h = el.getAttribute('href') || '';
                        if (h.indexOf('favicon-legacy') !== -1) return;
                        el.parentNode.removeChild(el);
                    });

                    var link = document.createElement('link');
                    link.rel = 'icon';
                    link.type = 'image/png';
                    link.sizes = '32x32';
                    link.href = href;
                    document.head.appendChild(link);
                }

                applyFavicon();

                var mql = window.matchMedia('(prefers-color-scheme: dark)');
                if (mql.addEventListener) mql.addEventListener('change', applyFavicon);
                else if (mql.addListener) mql.addListener(applyFavicon);
            })();
        </script>
        <title>Sonar | {title}</title>
        <style is:global>
            html {
                /* Vos variables d'offset */
                --bg-offset-x: -3px;
                --bg-offset-y: -3px;

                background-color: #121f2f;
                background-image: url('../assets/background.jpg');
                background-repeat: no-repeat;
                
                /* Utilisation explicite des variables d'offset avec fallback */
                background-position: calc(50% + var(--bg-offset-x, 0px)) calc(0px + var(--bg-offset-y, 0px));
                
                background-size: cover;
                background-attachment: fixed;
                min-height: 100%;

                /* Empêche le défilement horizontal causé par les marges négatives */
                overflow-x: hidden; 
            }

            /* `background-attachment: fixed` est mal géré par les navigateurs mobiles
               (Chrome Android / Safari iOS) : l'image ne se repeint qu'une fois le
               scroll totalement arrêté, ce qui donne l'impression que le fond ne se
               met à jour qu'en bas de page. On repasse en "scroll" sous 968px. */
            @media (max-width: 968px) {
                html {
                    background-attachment: scroll;
                }
            }

            body { 
                /* Marge latérale du site : utilisée aussi par les marges négatives
                   du header/nav/footer pour qu'ils s'étendent bord à bord.
                   On la réduit en media query pour les petits écrans. */
                --page-pad: 20px;

                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; 
                margin: 0; 
                padding: var(--page-pad) var(--page-pad) 0 var(--page-pad);
                background: transparent;
                color: #eee; 
                /* S'assure que le body ne déborde pas */
                box-sizing: border-box;
            }

            /* --- STYLE DE L'EN-TÊTE DE L'ACCUEIL --- */
            header { 
                position: relative;
                text-align: center; 
                line-height: 60px;
                background-color: #02001d; 
                border-bottom: 2px solid #000; 
                padding-bottom: 20px;
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
                margin-top: calc(-1 * var(--page-pad));
            }

            /* Le header accueil doit passer AU-DESSUS de la nav, sinon le menu
               Déconnexion (qui dépasse sous le header) se retrouve derrière. */
            header:not(.header-inner) {
                z-index: 40;
                overflow: visible;
            }

            .sonar-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #ffffff;
                overflow: hidden;
                flex-shrink: 0;
                text-transform: uppercase;
                font-size: 0.95rem;
                background-color: #ea580c;
                line-height: 1;
            }

            .sonar-avatar-sm {
                width: 32px;
                height: 32px;
                font-size: 0.8rem;
            }

            .sonar-avatar-lg {
                width: 72px;
                height: 72px;
                font-size: 1.6rem;
            }

            .sonar-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                border-radius: 50%;
                image-rendering: auto;
                image-rendering: -webkit-optimize-contrast;
            }

            /* --- STYLE DU HEADER DE L'ACCUEIL (v2) --- */
            .header-v2 {
                --hv2-logo-size: 84px;
                position: relative;
                z-index: 40;
                overflow: visible;
                display: flex;
                flex-direction: column;
                align-items: stretch;
                text-align: left;
                line-height: normal;
                background-color: #02001d;
                border-bottom: 2px solid #000;
                padding: 0;
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
                margin-top: calc(-1 * var(--page-pad));
            }

            .header-v2-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 16px;
                padding: 18px 24px 16px;
            }

            .hv2-category-bar {
                display: flex;
                justify-content: center;
                align-items: center;
                flex-wrap: wrap;
                gap: 28px;
                padding: 0 28px;
                min-height: 52px;
                background-color: #02001d;
                border-top: 1px solid rgba(255, 255, 255, 0.12);
                overflow: visible;
                position: relative;
                z-index: 3;
            }
            .hv2-category-bar a {
                text-decoration: none;
                color: #ffffff;
                font-size: 1rem;
                font-weight: bold;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.3s ease;
                white-space: nowrap;
            }
            .hv2-category-bar a:hover {
                color: #ff8826;
            }

            .nav-domain {
                position: relative;
                display: inline-flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 52px;
            }
            .nav-domain-row {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 52px;
            }
            .nav-domain-toggle {
                display: none;
            }
            .nav-domain-row a {
                position: relative;
                z-index: 90;
                display: flex;
                align-items: center;
                min-height: 52px;
                padding: 0 2px;
            }
            .nav-domain-subs {
                display: none;
                position: absolute;
                top: 100%;
                left: 50%;
                transform: translateX(-50%);
                min-width: max(100%, 160px);
                padding: 10px 14px 14px;
                z-index: 80;
                flex-direction: column;
                align-items: stretch;
                gap: 2px;
                background: #02001d;
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 6px;
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
            }
            /* Pont invisible sous le lien (z-index plus bas) pour atteindre le menu. */
            .nav-domain-subs::before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: -14px;
                height: 14px;
            }
            .nav-domain:hover .nav-domain-subs,
            .nav-domain:focus-within .nav-domain-subs {
                display: flex;
            }
            .nav-domain-subs a {
                white-space: nowrap;
                font-size: 0.92rem;
                font-weight: 600;
                padding: 6px 4px;
            }
            .hv2-menu-links .nav-domain {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                min-height: 0;
            }
            .hv2-menu-links .nav-domain-row {
                display: flex;
                align-items: stretch;
                width: 100%;
                min-height: 0;
            }
            .hv2-menu-links .nav-domain-row a {
                flex: 1;
                min-width: 0;
                min-height: 0;
                z-index: auto;
            }
            .hv2-menu-links .nav-domain-toggle {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 52px;
                margin: 0;
                padding: 0;
                border: none;
                background: transparent;
                color: #ffffff;
                cursor: pointer;
            }
            .hv2-menu-links .nav-domain-toggle:hover {
                color: #ff8826;
            }
            .hv2-menu-links .nav-domain-toggle svg {
                width: 18px;
                height: 18px;
                transition: transform 0.2s ease;
            }
            .hv2-menu-links .nav-domain.is-open .nav-domain-toggle svg {
                transform: rotate(180deg);
            }
            .hv2-menu-links .nav-domain:hover .nav-domain-subs,
            .hv2-menu-links .nav-domain:focus-within .nav-domain-subs {
                display: none;
            }
            .hv2-menu-links .nav-domain-subs {
                display: none;
                position: static;
                transform: none;
                min-width: 0;
                padding: 0 0 8px 12px;
                background: transparent;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }
            .hv2-menu-links .nav-domain-subs::before {
                content: none;
            }
            .hv2-menu-links .nav-domain.is-open .nav-domain-subs,
            .hv2-menu-links .nav-domain.is-open:hover .nav-domain-subs,
            .hv2-menu-links .nav-domain.is-open:focus-within .nav-domain-subs {
                display: flex;
            }
            .hv2-menu-links .nav-domain-subs a {
                font-size: 0.95rem;
                font-weight: 600;
                padding: 8px 26px;
            }
            .footer-links .nav-domain-subs-list {
                list-style: none;
                margin: 4px 0 10px 14px;
                padding: 0;
            }
            .footer-links .nav-domain-subs-list li {
                margin-bottom: 6px;
            }
            .footer-links .nav-domain-subs-list a {
                color: #ff8826;
                font-style: italic;
            }

            .header-v2-left,
            .header-v2-right {
                display: flex;
                align-items: center;
                gap: 10px;
                flex: 1;
                /* Hauteur fixe (= taille des boutons ronds) pour que le centrage ci-dessous
                   soit exact même si le contenu (ex. bouton FR/EN) est naturellement plus bas. */
                height: 40px;
                /* Recentre les contrôles sur le milieu du logo (--hv2-logo-size),
                   pas sur le milieu du bloc logo + titre. */
                margin-top: calc((var(--hv2-logo-size) - 40px) / 2);
            }
            .header-v2-right {
                justify-content: flex-end;
            }

            .header-v2-center {
                display: flex;
                flex-shrink: 0;
            }

            .hv2-brand {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
                text-decoration: none;
            }

            .hv2-brand-logo {
                width: var(--hv2-logo-size);
                height: var(--hv2-logo-size);
                object-fit: contain;
                border-radius: 50%;
                display: block;
                transform: scale(2.5) translateX(5px);
            }

            .hv2-brand-title {
                font-family: 'Libre Baskerville', Baskerville, Georgia, serif;
                font-weight: 700;
                font-size: 20px;
                color: #ffffff;
                letter-spacing: 0.3px;
                white-space: nowrap;
            }

            .hv2-icon-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: transparent;
                border: none;
                color: #ffffff;
                cursor: pointer;
                padding: 0;
                flex-shrink: 0;
                transition: background-color 0.2s ease;
            }
            .hv2-icon-btn svg {
                width: 20px;
                height: 20px;
            }
            .hv2-icon-btn:hover,
            .hv2-icon-btn[aria-expanded="true"] {
                background-color: rgba(255, 255, 255, 0.12);
            }

            .hv2-journalists-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #ffffff;
                border-radius: 6px;
                padding: 7px 14px;
                color: #ffffff;
                font-weight: bold;
                font-size: 0.85rem;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                text-decoration: none;
                white-space: nowrap;
                transition: background-color 0.2s ease, color 0.2s ease;
            }
            .hv2-journalists-btn:hover {
                background-color: #ffffff;
                color: #02001d;
            }

            .hv2-lang-switch {
                display: flex;
                align-items: center;
                gap: 6px;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                font-weight: bold;
                font-size: 0.85rem;
            }
            .hv2-lang-btn {
                background: transparent;
                border: none;
                color: rgba(255, 255, 255, 0.55);
                cursor: pointer;
                padding: 4px 2px;
                font: inherit;
                transition: color 0.2s ease;
            }
            .hv2-lang-btn:hover {
                color: #ffffff;
            }
            .hv2-lang-btn.is-active {
                color: #ffffff;
                text-decoration: underline;
                text-decoration-color: #ff8826;
                text-decoration-thickness: 2px;
                text-underline-offset: 3px;
            }
            .hv2-lang-sep {
                color: rgba(255, 255, 255, 0.35);
            }

            /* --- MENU LATÉRAL DES CATÉGORIES (BARRE LATÉRALE + VOILE SOMBRE) --- */
            .hv2-overlay {
                position: fixed;
                inset: 0;
                background-color: rgba(0, 0, 0, 0.6);
                z-index: 999;
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.3s ease, visibility 0.3s ease;
            }
            .hv2-overlay.is-open {
                opacity: 1;
                visibility: visible;
            }

            .hv2-menu-panel {
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                width: min(300px, 82vw);
                display: flex;
                flex-direction: column;
                background-color: #02001d;
                border-right: 1px solid #1f2937;
                box-shadow: 12px 0 30px rgba(0, 0, 0, 0.5);
                z-index: 1000;
                padding: 16px 0 20px;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            .hv2-menu-panel.is-open {
                transform: translateX(0);
            }
            .hv2-menu-top {
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 0 16px 16px;
                border-bottom: 1px solid #1f2937;
                margin-bottom: 8px;
            }
            .hv2-menu-close {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                align-self: flex-start;
                width: 38px;
                height: 38px;
                margin: 0 0 4px 0;
                background: transparent;
                border: none;
                color: #ffffff;
                cursor: pointer;
                border-radius: 50%;
                flex-shrink: 0;
                transition: background-color 0.2s ease;
            }
            .hv2-menu-close:hover {
                background-color: rgba(255, 255, 255, 0.12);
            }
            .hv2-menu-close svg {
                width: 18px;
                height: 18px;
            }
            .hv2-menu-brand {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                padding: 4px 8px 10px;
            }
            .hv2-menu-brand-logo {
                width: 56px;
                height: 56px;
                object-fit: contain;
                border-radius: 50%;
                display: block;
                transform: scale(2.5) translateX(5px);
            }
            .hv2-menu-brand-title {
                font-family: 'Libre Baskerville', Baskerville, Georgia, serif;
                font-weight: 700;
                font-size: 15px;
                color: #ffffff;
                letter-spacing: 0.3px;
                text-align: center;
                transition: color 0.2s ease;
            }
            .hv2-menu-brand:hover .hv2-menu-brand-title {
                color: #ff8826;
            }
            .hv2-menu-lang {
                justify-content: center;
                padding: 4px 0 8px;
            }
            .hv2-menu-links {
                display: flex;
                flex-direction: column;
            }
            .hv2-menu-links a {
                padding: 14px 26px;
                color: #ffffff;
                text-decoration: none;
                font-weight: bold;
                font-size: 1.05rem;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.2s ease, background-color 0.2s ease;
            }
            .hv2-menu-links a:hover {
                color: #ff8826;
                background-color: rgba(255, 255, 255, 0.05);
            }

            /* --- RECHERCHE INLINE (S'ÉTEND À DROITE DE LA LOUPE, POUSSE "NOS JOURNALISTES") ---
               Le conteneur "wrap" reste en overflow visible (pour laisser dépasser la liste de
               résultats en dessous) ; seul le conteneur interne "inline" est en overflow:hidden,
               pour l'animation de largeur du champ texte. */
            .hv2-search-wrap {
                position: relative;
                display: flex;
                align-items: center;
                flex-shrink: 0;
            }
            .hv2-search-inline {
                display: flex;
                align-items: center;
                width: 0;
                overflow: hidden;
                transition: width 0.25s ease;
            }
            .hv2-search-wrap.is-open .hv2-search-inline {
                width: clamp(160px, 32vw, 260px);
            }
            .hv2-search-input {
                width: 100%;
                box-sizing: border-box;
                padding: 8px 14px;
                border-radius: 20px;
                border: 1px solid #1f2937;
                background-color: #0a1322;
                color: #ffffff;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                font-size: 0.85rem;
            }
            .hv2-search-input::placeholder {
                color: #6b7a8f;
            }
            .hv2-search-input:focus {
                outline: none;
                border-color: #ff8826;
            }
            .hv2-search-results {
                position: absolute;
                top: 100%;
                left: 0;
                margin: 8px 0 0 0;
                min-width: 280px;
                width: max-content;
                max-width: min(420px, 70vw);
                background-color: #02001d;
                border: 1px solid #1f2937;
                border-radius: 10px;
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
                list-style: none;
                padding: 4px 0;
                max-height: 280px;
                overflow-y: auto;
                text-align: left;
                line-height: 1.35;
                z-index: 41;
                scrollbar-width: thin;
                scrollbar-color: #3a4a60 transparent;
            }
            .hv2-search-results::-webkit-scrollbar {
                width: 6px;
            }
            .hv2-search-results::-webkit-scrollbar-thumb {
                background: #3a4a60;
                border-radius: 4px;
            }
            .hv2-search-results li {
                margin: 0;
                padding: 0;
                line-height: inherit;
                text-align: left;
            }
            .hv2-search-results li a {
                display: block;
                padding: 7px 14px;
                color: #ffffff;
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 400;
                line-height: 1.35;
                text-align: left;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            }
            .hv2-search-results li a:hover {
                background-color: rgba(255, 255, 255, 0.08);
                color: #ff8826;
            }
            .hv2-search-empty {
                padding: 7px 14px;
                color: #8fa0b5;
                font-size: 0.85rem;
                line-height: 1.35;
                text-align: left;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            }

            /* --- STYLE DE LA BARRE COMPACTE DE NAVIGATION (HORS ACCUEIL) --- */
            .header-inner {
                position: relative;
                z-index: 200;
                overflow: visible;
                display: flex;
                align-items: center;
                justify-content: space-between;
                text-align: left;
                line-height: normal;
                padding: 15px 30px;
                background-color: #02001d; 
                border-bottom: 1px solid #102136;
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
                margin-top: calc(-1 * var(--page-pad));
                margin-bottom: 30px;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            }

            .header-inner-left {
                display: flex;
                align-items: center;
                gap: 10px;
                min-width: 0;
                flex: 1;
            }

            .header-inner-logo {
                display: flex;
                align-items: center;
                width: 140px;
            }
            .header-inner-logo a {
                display: block;
                width: 100%;
                text-decoration: none;
                cursor: pointer;
            }

            .header-right-group {
                display: flex;
                align-items: center;
                gap: 40px;
                overflow: visible;
            }

            .header-toolbar {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-bar-inner {
                display: flex;
                gap: 25px;
                align-items: center;
                overflow: visible;
            }

            .nav-bar-inner a {
                text-decoration: none;
                color: #ffffff;
                font-size: 1rem;
                font-weight: bold; 
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.3s ease;
            }
            .nav-bar-inner .nav-domain-row a {
                min-height: 50px;
            }

            .nav-bar-inner a:hover {
                color: #ff8826;
            }

            /* --- BANDEAU DE REMPLACEMENT AU DÉFILEMENT (ACCUEIL UNIQUEMENT) ---
               Clone du header compact ("header-inner"), gardé hors du flux et masqué
               par défaut ; setupStickyHeader() lui ajoute "is-visible" une fois que le
               grand header de l'accueil a totalement défilé hors de l'écran. */
            .header-fixed-clone {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: min(50px, 92vw);
                margin: 0 auto;
                overflow: visible;
                z-index: 900;
                transform: translateY(-100%);
                opacity: 0;
                pointer-events: none;
                transition: transform 0.35s ease, opacity 0.35s ease;
            }
            .header-fixed-clone.is-visible {
                transform: translateY(0);
                opacity: 1;
                pointer-events: auto;
            }

            .main-grid { 
                display: grid; 
                grid-template-columns: 2fr 1fr; 
                gap: 20px; 
                max-width: 1200px; 
                margin: 0 auto; 
                color: #000; 
            }
            .article-une { 
                background: white; 
                padding: 20px; 
                border: 1px solid #ddd; 
                border-radius: 2%;
            }
            .article-sidebar { 
                background: white; 
                padding: 15px; 
                border: 1px solid #ddd; 
                margin-bottom: 10px; 
                border-radius: 2%;
            }
            .site-footer {
                background-color: #0a131d;
                color: #cccccc;
                padding: 60px 20px 30px 20px;
                margin-top: 80px;
                border-top: 2px solid #000;
                margin-left: calc(-1 * var(--page-pad));
                margin-right: calc(-1 * var(--page-pad));
            }
            .footer-container {
                max-width: 1200px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                gap: 40px;
                padding-bottom: 40px;
            }
            .footer-brand {
                width: 110%;
            }
            .footer-brand h3 {
                font-family: 'Libre Baskerville', Baskerville, Georgia, serif;
                color: #ffffff;
                margin: 0 0 15px 0;
                font-size: 1.4rem;
                letter-spacing: 1px;
            }
            .footer-brand p {
                color: #8fa0b5;
                font-size: 0.95rem;
                line-height: 1.6;
                margin: 0;
            }
            .footer-brand p + p {
                margin-top: 14px;
            }
            .footer-links{
                transform: translateX(80px);
            }
            .footer-links h4, .footer-contact h4 {
                color: #ff8826;
                margin: 0 0 15px 0;
                font-size: 1.1rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .footer-links ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .footer-links li {
                margin-bottom: 10px;
            }
            .footer-links a {
                display: inline-block;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .footer-links a:hover {
                color: #ff8826; 
                transform: translateY(-2px);
            }
            .footer-contact p {
                margin: 0;
                font-size: 0.95rem;
                color: #b0c0d2;
                display: inline-flex;
                align-items: center;
                height: 20px;
            }
            .footer-contact h4 {
                /* La colonne "Navigation" n'a que sa marge de titre (15px) avant sa
                   1ère ligne ; ici le "gap" du flex (12px) s'y ajoutait en plus,
                   décalant "contact@..." plus bas que "Accueil". On retire l'excédent
                   pour retrouver le même total (15px) et aligner les deux 1ères lignes. */
                margin-bottom: 3px;
            }
            .footer-contact {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }
            .footer-legal-section {
                border-top: 1px solid #1f334b;
                border-bottom: 1px solid #1f334b;
                padding: 25px 20px;
                margin: 20px auto 30px auto;
                max-width: 1200px;
                text-align: center;
            }
            .legal-section-title {
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.15em;
                color: #ffffff;
                text-transform: uppercase;
                margin: 0 0 15px 0;
            }
            .legal-links {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 30px;
                padding: 0;
                margin: 0;
            }
            .legal-link {
                font-size: 0.85rem;
                color: #b0c0d2;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: color 0.3s ease;
            }
            .legal-link::before {
                content: "▪";
                color: #ff8826; 
                font-size: 0.6rem;
            }
            .legal-link:hover {
                color: #ff8826;
            }
            .footer-bottom {
                max-width: 1200px;
                margin: 0 auto;
                padding-top: 20px;
                text-align: center;
                font-size: 0.85rem;
                color: #566981;
            }
            .instagram-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                color: #b0c0d2; 
                text-decoration: none;
                font-size: 0.95rem;
                line-height: 1;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .instagram-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .instagram-icon {
                width: 20px;
                height: 20px;
                display: block;
            }
            .instagram-wrapper {
                margin-top: 0;
                text-align: left; 
            }
            .contact-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #b0c0d2;
                text-decoration: none;
                transition: color 0.3s ease, transform 0.2s ease;
            }
            .contact-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }
            .mail-icon {
                width: 20px;
                height: 20px;
                fill: currentColor;
                color: #eee;
            }

            /* --- MENU MOBILE (BOUTON BURGER) --- */
            .mobile-nav-toggle {
                display: none;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 5px;
                width: 40px;
                height: 40px;
                padding: 0;
                background: transparent;
                border: none;
                cursor: pointer;
                flex-shrink: 0;
            }
            .mobile-nav-toggle span {
                display: block;
                width: 22px;
                height: 2px;
                background-color: #ffffff;
                border-radius: 2px;
                transition: transform 0.25s ease, opacity 0.25s ease;
            }
            nav.is-open .mobile-nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
            nav.is-open .mobile-nav-toggle span:nth-child(2) { opacity: 0; }
            nav.is-open .mobile-nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

            /* Responsive */
            /* EN : masquer sans retirer du flux → même grille / emplacements que FR */
            .article-card-item.is-lang-hidden {
                visibility: hidden;
                pointer-events: none;
            }
            @media (max-width: 968px) {
                body {
                    --page-pad: 14px;
                }

                /* --- En-tête page d'accueil (v2) --- */
                .header-v2-row {
                    flex-wrap: wrap;
                    justify-content: center;
                    row-gap: 10px;
                    padding: 12px 16px;
                }
                .hv2-category-bar {
                    justify-content: flex-end;
                    gap: 16px;
                    padding: 8px 16px 12px;
                    min-height: 0;
                }
                .hv2-category-bar a {
                    font-size: 0.9rem;
                }
                .header-v2-center {
                    order: -1;
                    flex-basis: 100%;
                    justify-content: center;
                }
                .header-v2-left,
                .header-v2-right {
                    flex: 1 1 auto;
                    gap: 6px;
                    /* Sur mobile, le logo passe en 2e ligne (voir .header-v2-center
                       plus haut) : plus besoin de recentrer sur son milieu. */
                    margin-top: 0;
                }
                .hv2-brand-logo {
                    width: 56px;
                    height: 56px;
                }
                .hv2-brand-title {
                    font-size: 17px;
                }
                .hv2-journalists-btn {
                    padding: 6px 10px;
                    font-size: 0.75rem;
                }
                .hv2-search-wrap.is-open .hv2-search-inline {
                    width: clamp(120px, 40vw, 200px);
                }

                /* --- En-tête interne (hors accueil) --- */
                .header-inner {
                    flex-direction: row;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 15px;
                }
                .header-inner-logo {
                    width: 105px;
                }
                .header-inner .hv2-search-wrap.is-open .hv2-search-inline {
                    width: clamp(120px, 28vw, 200px);
                }
                .header-right-group {
                    flex-direction: row;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    width: 100%;
                }
                .header-toolbar {
                    margin-left: auto;
                }
                .nav-bar-inner {
                    flex-wrap: wrap;
                    gap: 0;
                }
                .nav-bar-inner .mobile-nav-toggle {
                    margin-right: 4px;
                }
                .nav-bar-inner a {
                    display: none;
                    width: 100%;
                    text-align: center;
                    padding: 10px 0;
                    box-sizing: border-box;
                    border-top: 1px solid rgba(255, 255, 255, 0.08);
                }
                .nav-bar-inner.is-open {
                    width: 100%;
                    order: -1;
                    flex-direction: column;
                    align-items: stretch;
                }
                .nav-bar-inner.is-open a {
                    display: block;
                }
                .nav-bar-inner .nav-domain {
                    display: none;
                    width: 100%;
                }
                .nav-bar-inner.is-open .nav-domain {
                    display: flex;
                    flex-direction: column;
                    align-items: stretch;
                    min-height: 0;
                }
                .nav-bar-inner.is-open .nav-domain-subs {
                    display: flex;
                    position: static;
                    transform: none;
                    min-width: 0;
                    padding: 0 0 8px;
                    background: transparent;
                    border: none;
                    box-shadow: none;
                }
                .nav-bar-inner.is-open .nav-domain-subs a {
                    display: block;
                    font-size: 0.9rem;
                    font-weight: 600;
                }

                /* --- Footer --- */
                .site-footer {
                    padding: 40px 16px 20px 16px;
                }
                .footer-container {
                    grid-template-columns: 1fr;
                    gap: 30px;
                    text-align: center;
                }
                .footer-contact {
                    align-items: center;
                }
                .instagram-wrapper {
                    text-align: center;
                }
                .legal-links {
                    gap: 12px 18px;
                }
                .footer-legal-section {
                    padding: 20px 15px;
                }
            }

            @media (max-width: 968px) {
                .header-inner-logo {
                    width: 85px;
                }
                .footer-brand h3 {
                    font-size: 1.2rem;
                }
                .legal-links {
                    flex-direction: column;
                    gap: 10px;
                }
                .footer-legal-section {
                    padding: 18px 12px;
                }
            }
            .substack-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                color: #b0c0d2; 
                text-decoration: none;
                font-size: 0.95rem;
                line-height: 1;
                transition: color 0.3s ease, transform 0.2s ease;
            }

            /* Style de l'icône Substack par défaut (Blanc) */
            .substack-icon {
                width: 20px;
                height: 20px;
                max-width: 20px;
                max-height: 20px;
                display: block;
                object-fit: contain;
                /* Rend le logo complètement blanc */
                filter: brightness(0) invert(1);
                transition: filter 0.3s ease, transform 0.2s ease;
            }

            /* Au survol du lien Substack */
            .substack-link:hover {
                color: #ff7900;
                transform: translateY(-2px);
            }

            /* Au survol : l'icône retrouve sa couleur originale (orange Substack) */
            .substack-link:hover .substack-icon {
                filter: none;
            }

            html[data-article-font="serif"] .prose-content,
            html[data-article-font="serif"] .prose-content h2 {
                font-family: 'Libre Baskerville', Baskerville, Georgia, serif !important;
            }
            html[data-article-font="editorial"] .prose-content,
            html[data-article-font="editorial"] .prose-content h2 {
                font-family: Georgia, 'Times New Roman', serif !important;
            }
            html[data-article-font-size="small"] .prose-content {
                font-size: 1.1rem !important;
            }
            html[data-article-font-size="small"] .prose-content h2 {
                font-size: 1.4rem !important;
            }
            html[data-article-font-size="large"] .prose-content {
                font-size: 1.55rem !important;
            }
            html[data-article-font-size="large"] .prose-content h2 {
                font-size: 2rem !important;
            }
        </style>
        <script is:inline>
            (function () {
                try {
                    var font = localStorage.getItem('sonar_article_font');
                    if (font && font !== 'sans') {
                        document.documentElement.setAttribute('data-article-font', font);
                    }
                    var size = localStorage.getItem('sonar_article_font_size');
                    if (size && size !== 'medium') {
                        document.documentElement.setAttribute('data-article-font-size', size);
                    }
                } catch (e) {}
            })();
        </script>
    </head>
