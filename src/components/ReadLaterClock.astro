---
interface Props {
  slug: string;
  title: string;
  titleEn?: string;
}

const { slug, title, titleEn = '' } = Astro.props;
---

<button
  type="button"
  class="read-later-clock"
  data-article-slug={slug}
  data-title-fr={title}
  data-title-en={titleEn}
  aria-pressed="false"
  aria-label="Ajouter à lire plus tard"
  title="Ajouter à lire plus tard"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle class="read-later-clock__face" cx="12" cy="12" r="8.25"></circle>
    <polyline class="read-later-clock__hands" points="12 8 12 12.2 15.2 14"></polyline>
  </svg>
</button>

<script>
  import { getBrowserSupabase, isArticleReadLater, setArticleReadLater } from '../utils/supabase-browser';
  import { READ_LATER_DEFAULT_REMIND_DAYS, remindAtFromDays } from '../data/read-later';

  const LABELS = {
    FR: { add: 'Ajouter à lire plus tard', remove: 'Retirer de à lire plus tard' },
    EN: { add: 'Save for later', remove: 'Remove from read later' },
  };

  function currentLang(): 'FR' | 'EN' {
    return (localStorage.getItem('site_lang') || 'FR').toUpperCase() === 'EN' ? 'EN' : 'FR';
  }

  function applyClockState(btn: HTMLButtonElement, on: boolean) {
    const lang = currentLang();
    const label = on ? LABELS[lang].remove : LABELS[lang].add;
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }

  function loginRedirect(slug: string) {
    window.location.href = `/connexion?redirect=${encodeURIComponent(`/articles/${slug}`)}`;
  }

  async function initClock(btn: HTMLButtonElement) {
    const slug = btn.getAttribute('data-article-slug');
    if (!slug) return;

    try {
      applyClockState(btn, await isArticleReadLater(slug));
    } catch {
      applyClockState(btn, false);
    }

    btn.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (btn.disabled) return;

      try {
        const supabase = getBrowserSupabase();
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          loginRedirect(slug);
          return;
        }
      } catch {
        loginRedirect(slug);
        return;
      }

      const next = !btn.classList.contains('is-on');
      applyClockState(btn, next);
      btn.disabled = true;

      try {
        const saved = await setArticleReadLater(slug, next, {
          title: btn.getAttribute('data-title-fr') || '',
          title_en: btn.getAttribute('data-title-en') || '',
          next_remind_at: remindAtFromDays(READ_LATER_DEFAULT_REMIND_DAYS),
        });
        applyClockState(btn, saved);
      } catch (err) {
        applyClockState(btn, !next);
        if (err instanceof Error && (err.name === 'AuthRequired' || err.message === 'AUTH_REQUIRED')) {
          loginRedirect(slug);
        }
      } finally {
        btn.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.read-later-clock').forEach((btn) => {
    if (btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';
    void initClock(btn);
  });

  window.addEventListener('languageChanged', () => {
    document.querySelectorAll<HTMLButtonElement>('.read-later-clock').forEach((btn) => {
      applyClockState(btn, btn.classList.contains('is-on'));
    });
  });
</script>

<style>
  .read-later-clock {
    position: absolute;
    top: 16px;
    right: 60px;
    z-index: 50;
    width: 40px;
    height: 40px;
    padding: 0;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 999px;
    background: rgba(2, 0, 29, 0.45);
    cursor: pointer;
    color: #ffffff;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .read-later-clock:hover,
  .read-later-clock:focus-visible {
    transform: scale(1.08);
    background: rgba(2, 0, 29, 0.7);
    outline: none;
  }

  .read-later-clock:disabled {
    cursor: wait;
  }

  .read-later-clock svg {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
  }

  .read-later-clock__face {
    fill: transparent;
    stroke: #ffffff;
    stroke-width: 1.7;
    transition: fill 0.18s ease, stroke 0.18s ease;
  }

  .read-later-clock__hands {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.18s ease;
  }

  .read-later-clock.is-on .read-later-clock__face {
    fill: #ea580c;
    stroke: #ea580c;
  }

  .read-later-clock.is-on .read-later-clock__hands {
    stroke: #ffffff;
  }
</style>
