                <path d="M14 11v6"></path>
                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
              </svg>
            </button>
          </div>
          <div class="account-notif-copy">
            <p class="account-notif-title">${escapeHtml(title)}</p>
            ${articleTitle && item.article_slug ? `<p class="account-notif-article"><span class="account-notif-article-prep" data-i18n="notif_on_article">${escapeHtml(t('notif_on_article'))}</span> <a class="account-notif-article-title" href="${escapeHtml(articleHref)}">${escapeHtml(articleTitle)}</a></p>` : ''}
            ${excerpt ? `<p class="account-notif-excerpt">« ${escapeHtml(excerpt)} »</p>` : ''}
            ${body ? `<p class="account-notif-body account-notif-body--reply">${replyArrow}<span>${isLikeOnReply ? formatCommentBody(body) : escapeHtml(body)}</span></p>` : ''}
            ${item.article_slug ? `<a class="account-notif-link" href="${escapeHtml(commentHref)}" data-i18n="${linkKey}">${escapeHtml(t(linkKey))}</a>` : ''}
            ${isReadLater ? `<div class="account-notif-snooze">
              <span data-i18n="notif_remind_in">${escapeHtml(t('notif_remind_in'))}</span>
              ${snoozeBtns}
            </div>` : ''}
          </div>
        </article>
      `;
    }).join('');

    updateSelectionUi();
  }

  async function enrichLikeReplyContext(items: AppNotification[]): Promise<AppNotification[]> {
    const likeIds = items
      .filter((item) => item.type === 'comment_like' && item.comment_id && !item.body)
      .map((item) => item.comment_id)
      .filter(Boolean);
    if (likeIds.length === 0) return items;

    try {
      const supabase = getBrowserSupabase();
      const { data: comments, error } = await supabase
        .from('comments')
        .select('id, content, parent_id, reply_to_id')
        .in('id', likeIds);
      const rows = error
        ? (await supabase.from('comments').select('id, content, parent_id').in('id', likeIds)).data
        : comments;
      const list = rows || [];
      const parentIds = [...new Set(list.map((row: any) => row.reply_to_id || row.parent_id).filter(Boolean))];
      let parents: { id: any; content: string }[] = [];
      if (parentIds.length > 0) {
        const { data } = await supabase.from('comments').select('id, content').in('id', parentIds);
        parents = data || [];
      }
      const byId = Object.fromEntries(list.map((row: any) => [String(row.id), row]));
      const parentById = Object.fromEntries(parents.map((row) => [String(row.id), row]));

      return items.map((item) => {
        if (item.type !== 'comment_like' || item.body) return item;
        const comment = byId[String(item.comment_id)];
        if (!comment || !(comment.parent_id || comment.reply_to_id)) return item;
        const parent = parentById[String(comment.reply_to_id || comment.parent_id)];
        return {
          ...item,
          title: parent?.content ? String(parent.content).slice(0, 140) : item.title,
          body: comment.content || item.title,
        };
      });
    } catch {
      return items;
    }
  }

  async function rescheduleSlugs(slugs: string[]) {
    await snoozeReadLaterMany(slugs, defaultRemindAt());
  }

  async function refreshNotifications() {
    const selected = selectedNotifIds();
    const previous = notificationsCache.map((item) => `${item.id}:${item.read_at || ''}:${(item.actor_usernames || []).join(',')}:${item.body || ''}`).join('|');
    try {
      await syncReadLaterReminders(defaultRemindAt());
      notificationsCache = await listNotifications();
      notificationsCache = await enrichLikeReplyContext(notificationsCache);
      const names = notificationsCache.flatMap((item) => item.actor_usernames || []);
      const missing = names.filter((name) => name && !actorProfiles.has(name.trim().toLowerCase()));
      if (missing.length > 0) {
        const found = await listAccountPreviewsByUsernames(missing);
        found.forEach((preview, key) => actorProfiles.set(key, preview));
      }
    } catch {
      notificationsCache = [];
    }
    const next = notificationsCache.map((item) => `${item.id}:${item.read_at || ''}:${(item.actor_usernames || []).join(',')}:${item.body || ''}`).join('|');
    if (next !== previous || (notificationsCache.length > 0 && notifListEl.childElementCount === 0)) {
      renderNotifications();
      selected.forEach((id) => {
        const box = notifListEl?.querySelector<HTMLInputElement>(`.account-notif-item[data-notif-id="${id}"] .account-notif-select`);
        if (box) box.checked = true;
      });
      updateSelectionUi();
      return;
    }
    updateUnreadBadge(notificationsCache.filter((item) => !item.read_at).length);
  }

  let notifPollId = 0;

  function stopNotifPoll() {
    if (!notifPollId) return;
    window.clearInterval(notifPollId);
    notifPollId = 0;
  }

  function startNotifPoll() {
    stopNotifPoll();
    notifPollId = window.setInterval(() => {
      if (!isDrawerOpen()) {
        stopNotifPoll();
        return;
      }
      void refreshNotifications();
    }, 2000);
  }

  const FONT_VALUES = ['sans', 'serif', 'editorial'] as const;
  const FONT_SIZE_VALUES = ['small', 'medium', 'large'] as const;

  function isFont(value: string): value is ArticleFont {
    return (FONT_VALUES as readonly string[]).includes(value);
  }

  function isFontSize(value: string): value is ArticleFontSize {
    return (FONT_SIZE_VALUES as readonly string[]).includes(value);
  }

  function currentFont(): ArticleFont {
    const value = localStorage.getItem(FONT_KEY) || 'sans';
    return isFont(value) ? value : 'sans';
  }

  function currentFontSize(): ArticleFontSize {
    const value = localStorage.getItem(FONT_SIZE_KEY) || 'medium';
    return isFontSize(value) ? value : 'medium';
  }

  function applyArticleFont(value: string) {
    const font = isFont(value) ? value : 'sans';
    localStorage.setItem(FONT_KEY, font);
    if (font === 'sans') document.documentElement.removeAttribute('data-article-font');
    else document.documentElement.setAttribute('data-article-font', font);

    document.querySelectorAll<HTMLInputElement>('input[name="article-font"]').forEach((input) => {
      input.checked = input.value === font;
    });
  }

  function applyArticleFontSize(value: string) {
    const size = isFontSize(value) ? value : 'medium';
    localStorage.setItem(FONT_SIZE_KEY, size);
    if (size === 'medium') document.documentElement.removeAttribute('data-article-font-size');
    else document.documentElement.setAttribute('data-article-font-size', size);

    document.querySelectorAll<HTMLInputElement>('input[name="article-font-size"]').forEach((input) => {
      input.checked = input.value === size;
    });
  }

  async function persistArticlePrefs(prefs: {
    article_font?: ArticleFont;
    article_font_size?: ArticleFontSize;
  }) {
    try {
      const account = await getCurrentAccount();
      if (!account) return;
      await saveArticlePrefs(account.id, prefs);
    } catch {
      /* localStorage reste à jour même si Supabase n'est pas encore migré */
    }
  }

  async function syncPrefsFromAccount() {
    try {
      const account = await getCurrentAccount();
      if (!account) return;
      if (account.article_font) applyArticleFont(account.article_font);
      if (account.article_font_size) applyArticleFontSize(account.article_font_size);
    } catch {
      /* colonnes absentes : on reste sur localStorage */
    }
  }

  window.addEventListener('sonar:account-toggle', () => {
    if (isDrawerOpen()) closeDrawer();
    else openDrawer();
  });

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  document.getElementById('account-open-notifications')?.addEventListener('click', async () => {
    await refreshNotifications();
    openSubdrawer(notifDrawer);
  });
  document.getElementById('account-open-settings')?.addEventListener('click', () => {
    applyArticleFont(currentFont());
    applyArticleFontSize(currentFontSize());
    openSubdrawer(settingsDrawer);
  });
  document.querySelectorAll('[data-close-subdrawer]').forEach((btn) => {
    btn.addEventListener('click', closeSubdrawers);
  });
  markAllBtn?.addEventListener('click', async () => {
    try {
      const unreadSlugs = readLaterSlugsFrom(
        notificationsCache.filter((item) => !item.read_at)
      );
      await rescheduleSlugs(unreadSlugs);
      await markAllNotificationsRead();
      await refreshNotifications();
    } catch {
      /* ignore */
    }
  });

  clearAllBtn?.addEventListener('click', async () => {
    if (!confirm(t('notif_clear_confirm'))) return;
    try {
      await rescheduleSlugs(readLaterSlugsFrom(notificationsCache));
      await deleteAllNotifications();
      await refreshNotifications();
    } catch {
      /* ignore */
    }
  });

  deleteSelectedBtn?.addEventListener('click', async () => {
    const ids = selectedNotifIds();
    if (ids.length === 0) return;
    try {
      await rescheduleSlugs(selectedNotifSlugs());
      await deleteNotifications(ids);
      await refreshNotifications();
    } catch {
      /* ignore */
    }
  });

  selectAllInput?.addEventListener('change', () => {
    if (!notifListEl) return;
    notifListEl.querySelectorAll<HTMLInputElement>('.account-notif-select').forEach((box) => {
      box.checked = Boolean(selectAllInput.checked);
    });
    updateSelectionUi();
  });

  notifListEl?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    const item = target.closest<HTMLElement>('.account-notif-item');
    if (!item) return;
    const id = item.dataset.notifId;
    const slug = item.dataset.slug;
    if (!id) return;

    if (target.closest('.account-notif-check') || target.closest('.account-notif-select')) {
      updateSelectionUi();
      return;
    }

    if (target.closest('.account-notif-delete')) {
      try {
        if (item.dataset.type === 'read_later' && slug) await rescheduleSlugs([slug]);
        await deleteNotifications([id]);
        await refreshNotifications();
      } catch {
        /* ignore */
      }
      return;
    }

    if (target.closest('.account-notif-link') || target.closest('.account-notif-article-title')) {
      event.preventDefault();
      const link = target.closest<HTMLAnchorElement>('a');
      const href = link?.getAttribute('href') || '';
      try {
        if (item.dataset.type === 'read_later' && slug) await rescheduleSlugs([slug]);
        await setNotificationRead(id, true);
      } catch {
        /* on navigue quand même */
      }
      if (href && href !== '#') window.location.href = href;
      return;
    }

    if (target.closest('.account-notif-toggle')) {
      const nextRead = item.dataset.read !== 'true';
      try {
        if (nextRead && item.dataset.type === 'read_later' && slug) await rescheduleSlugs([slug]);
        await setNotificationRead(id, nextRead);
        await refreshNotifications();
      } catch {
        /* ignore */
      }
      return;
    }

    const snoozeBtn = target.closest<HTMLButtonElement>('.account-notif-snooze-btn');
    if (snoozeBtn && slug && item.dataset.type === 'read_later') {
      const days = Number(snoozeBtn.dataset.snoozeDays);
      if (!days) return;
      try {
        await snoozeReadLater(slug, remindAtFromDays(days));
        await setNotificationRead(id, true);
        await refreshNotifications();
      } catch {
        /* ignore */
      }
    }
  });

  window.addEventListener('languageChanged', () => {
    renderNotifications();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="article-font"]').forEach((input) => {
    input.addEventListener('change', () => {
      if (!input.checked || !isFont(input.value)) return;
      applyArticleFont(input.value);
      persistArticlePrefs({ article_font: input.value });
    });
  });
  document.querySelectorAll<HTMLInputElement>('input[name="article-font-size"]').forEach((input) => {
    input.addEventListener('change', () => {
      if (!input.checked || !isFontSize(input.value)) return;
      applyArticleFontSize(input.value);
      persistArticlePrefs({ article_font_size: input.value });
    });
  });

  document.getElementById('account-logout')?.addEventListener('click', async () => {
    const supabase = getBrowserSupabase();
    await supabase.auth.signOut();
    window.location.reload();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (notifDrawer?.classList.contains('is-open') || settingsDrawer?.classList.contains('is-open')) {
      closeSubdrawers();
      return;
    }
    if (isDrawerOpen()) closeDrawer();
  });

  applyArticleFont(currentFont());
  applyArticleFontSize(currentFontSize());
  syncPrefsFromAccount();
  void refreshNotifications();
</script>

