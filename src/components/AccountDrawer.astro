  }

  .account-drawer-inner {
    padding: 8px 20px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    max-width: 100%;
  }

  .account-drawer-profile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    width: auto;
    margin-right: calc(-1 * var(--page-pad, 20px));
    padding: 12px calc(20px + var(--page-pad, 20px)) 16px 20px;
    background: #02001d;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
