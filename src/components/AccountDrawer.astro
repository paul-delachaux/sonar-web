    font-size: 1.25rem;
  }
  .account-drawer-profile .sonar-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .account-drawer-username {
    font-size: 0.98rem;
