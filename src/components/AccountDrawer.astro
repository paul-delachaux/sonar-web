<div class="account-overlay" id="account-overlay"></div>

<aside class="account-drawer" id="account-drawer" aria-label="Menu du compte" aria-hidden="true">
  <header class="account-drawer-profile">
    <button type="button" class="account-drawer-close" id="account-drawer-close" aria-label="Fermer le menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
    <span class="sonar-avatar sonar-avatar-lg" data-account-avatar aria-hidden="true"></span>
    <strong class="account-drawer-username" data-account-username></strong>
    <span class="account-drawer-email" data-account-email></span>
  </header>

  <div class="account-drawer-inner">

    <nav class="account-drawer-nav" aria-label="Compte">
      <a href="/compte" class="account-drawer-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"></path>
        </svg>
        <span data-i18n="account_title">Mon compte</span>
      </a>
      <a href="/admin/" class="account-drawer-item" id="account-cms-link" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <path d="M7 8h10M7 12h6"></path>
        </svg>
        <span data-i18n="account_cms">Administration</span>
      </a>
      <a href="/favoris" class="account-drawer-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span data-i18n="account_favorites">Mes favoris</span>
      </a>
      <a href="/lire-plus-tard" class="account-drawer-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <polyline points="12 7 12 12 16 14"></polyline>
        </svg>
        <span data-i18n="account_read_later">À lire plus tard</span>
      </a>
      <button type="button" class="account-drawer-item" id="account-open-notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16v16H4z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span data-i18n="account_notifications">Notifications</span>
        <span class="account-notif-badge" data-unread-count hidden>0</span>
        <svg class="account-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </button>
      <button type="button" class="account-drawer-item" id="account-open-settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span data-i18n="account_settings">Paramètres</span>
        <svg class="account-drawer-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </button>
    </nav>

    <div class="account-drawer-footer">
      <button type="button" class="account-drawer-item" id="account-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span data-i18n="auth_logout">Déconnexion</span>
      </button>
    </div>
  </div>
</aside>

<aside class="account-subdrawer" id="notifications-drawer" aria-label="Notifications" aria-hidden="true">
  <header class="account-subdrawer-header">
    <button type="button" class="account-subdrawer-back" data-close-subdrawer aria-label="Retour">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="15 6 9 12 15 18"></polyline>
      </svg>
    </button>
    <h2 data-i18n="account_notifications">Notifications</h2>
    <button type="button" class="account-mark-all-read" id="account-mark-all-read" data-i18n="account_notifications_mark_all">
      Tout lire
    </button>
    <button type="button" class="account-mark-all-read" id="account-notif-clear" data-i18n="notif_clear_all">
      Tout supprimer
    </button>
  </header>
  <div class="account-notif-toolbar" id="notifications-toolbar">
    <label class="account-notif-select-all">
      <input type="checkbox" id="account-notif-select-all" />
      <span data-i18n="notif_select_all">Tout sélectionner</span>
    </label>
    <button type="button" class="account-notif-delete-selected" id="account-notif-delete-selected" disabled data-i18n="notif_delete_selected">
      Supprimer la sélection
    </button>
  </div>
  <p id="notifications-empty" class="account-subdrawer-empty" data-i18n="account_notifications_empty">
    Aucune notification pour le moment.
  </p>
  <div id="notifications-list" class="account-notif-list" hidden></div>
</aside>

<aside class="account-subdrawer" id="settings-drawer" aria-label="Paramètres" aria-hidden="true">
  <header class="account-subdrawer-header">
    <button type="button" class="account-subdrawer-back" data-close-subdrawer aria-label="Retour">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="15 6 9 12 15 18"></polyline>
      </svg>
    </button>
    <h2 data-i18n="account_settings">Paramètres</h2>
  </header>

  <fieldset class="account-font-fieldset">
    <legend data-i18n="account_font_legend">Police des articles</legend>
    <p class="account-font-help" data-i18n="account_font_help">
      Choisissez la police utilisée pour le texte des articles.
    </p>
    <label class="account-font-option">
      <input type="radio" name="article-font" value="sans" />
      <span>
        <strong data-i18n="account_font_sans">Classique</strong>
        <em>Helvetica Neue</em>
      </span>
    </label>
    <label class="account-font-option">
      <input type="radio" name="article-font" value="serif" />
      <span>
        <strong data-i18n="account_font_serif">Lecture</strong>
        <em>Libre Baskerville</em>
      </span>
    </label>
    <label class="account-font-option">
      <input type="radio" name="article-font" value="editorial" />
      <span>
        <strong data-i18n="account_font_editorial">Éditoriale</strong>
        <em>Georgia</em>
      </span>
    </label>
  </fieldset>

  <fieldset class="account-font-fieldset">
    <legend data-i18n="account_font_size_legend">Taille du texte</legend>
    <p class="account-font-help" data-i18n="account_font_size_help">
      Ajuste la taille du texte des articles.
    </p>
    <label class="account-font-option">
      <input type="radio" name="article-font-size" value="small" />
      <span>
        <strong data-i18n="account_font_size_small">Petite</strong>
      </span>
    </label>
    <label class="account-font-option">
      <input type="radio" name="article-font-size" value="medium" />
      <span>
        <strong data-i18n="account_font_size_medium">Moyenne</strong>
      </span>
    </label>
    <label class="account-font-option">
      <input type="radio" name="article-font-size" value="large" />
      <span>
        <strong data-i18n="account_font_size_large">Grande</strong>
      </span>
    </label>
  </fieldset>
</aside>

<script>
  import {
    getBrowserSupabase,
    getCurrentAccount,
    saveArticlePrefs,
    listNotifications,
    setNotificationRead,
    markAllNotificationsRead,
    snoozeReadLater,
    snoozeReadLaterMany,
    syncReadLaterReminders,
    deleteNotifications,
    deleteAllNotifications,
    listAccountPreviewsByUsernames,
    type Account,
    type ArticleFont,
    type ArticleFontSize,
    type AppNotification,
    type AccountPreview,
  } from '../utils/supabase-browser';
  import { avatarInitial, avatarImgHtml } from '../utils/avatar';
  import { t as translate } from '../utils/i18n.js';
  import { formatCommentBody, formatLikeActors, formatReplyActor, commentPermalink, stripLeadingMentions } from '../utils/comment-text';
  import { READ_LATER_DEFAULT_REMIND_DAYS, READ_LATER_SNOOZE_DAYS, remindAtFromDays } from '../data/read-later';
  import { accountHasCmsLink } from '../utils/cms-accounts';

  const FONT_KEY = 'sonar_article_font';
  const FONT_SIZE_KEY = 'sonar_article_font_size';
  const overlay = document.getElementById('account-overlay');
  const drawer = document.getElementById('account-drawer');
  const closeBtn = document.getElementById('account-drawer-close');
  const notifDrawer = document.getElementById('notifications-drawer');
  const settingsDrawer = document.getElementById('settings-drawer');

  function fillAvatar(el: HTMLElement, account: Account) {
    el.style.backgroundColor = account.avatar_url ? 'transparent' : (account.avatar_color || '#ea580c');
    if (account.avatar_url) {
      el.innerHTML = avatarImgHtml(account.avatar_url);
    } else {
      el.textContent = avatarInitial(account.username);
    }
  }

  function syncUserButtons(expanded: boolean) {
    document.querySelectorAll('.auth-nav-user-btn').forEach((btn) => {
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      btn.setAttribute('aria-controls', 'account-drawer');
    });
  }

  function isDrawerOpen() {
    return Boolean(drawer?.classList.contains('is-open'));
  }

  function closeSubdrawers() {
    notifDrawer?.classList.remove('is-open');
    settingsDrawer?.classList.remove('is-open');
    notifDrawer?.setAttribute('aria-hidden', 'true');
    settingsDrawer?.setAttribute('aria-hidden', 'true');
  }

  function closeDrawer() {
    if (!drawer || !overlay) return;
    closeSubdrawers();
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    syncUserButtons(false);
    stopNotifPoll();
  }

  async function openDrawer() {
    if (!drawer || !overlay) return;
    const account = await getCurrentAccount();
    if (!account) return;

    const avatarEl = drawer.querySelector('[data-account-avatar]') as HTMLElement | null;
    const usernameEl = drawer.querySelector('[data-account-username]') as HTMLElement | null;
    const emailEl = drawer.querySelector('[data-account-email]') as HTMLElement | null;
    if (avatarEl) fillAvatar(avatarEl, account);
    if (usernameEl) usernameEl.textContent = account.username;
    if (emailEl) emailEl.textContent = account.email;

    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    syncUserButtons(true);
    void refreshNotifications();
    startNotifPoll();
    void syncCmsLink(account);
  }

  async function syncCmsLink(account: Account) {
    const cmsLink = document.getElementById('account-cms-link');
    if (!cmsLink) return;
    try {
      const res = await fetch('/api/site-cms-access', { cache: 'no-store' });
      const data = res.ok ? await res.json() : { siteAccess: [] };
      cmsLink.hidden = !accountHasCmsLink(account, Array.isArray(data.siteAccess) ? data.siteAccess : []);
    } catch {
      cmsLink.hidden = true;
    }
  }

  function openSubdrawer(panel: HTMLElement | null) {
    closeSubdrawers();
    if (!panel) return;
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
  }

  function currentLang(): 'FR' | 'EN' {
    return (localStorage.getItem('site_lang') || 'FR').toUpperCase() === 'EN' ? 'EN' : 'FR';
  }

  function t(key: string): string {
    return translate(key, currentLang());
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function snoozeLabel(days: number) {
    const unit = days <= 1 ? t('notif_day') : t('notif_days');
    return `${days} ${unit}`;
  }

  function updateUnreadBadge(count: number) {
    document.querySelectorAll<HTMLElement>('[data-unread-count]').forEach((el) => {
      if (count > 0) {
        el.hidden = false;
        el.textContent = count > 99 ? '99+' : String(count);
      } else {
        el.hidden = true;
      }
    });
  }

  const notifListEl = document.getElementById('notifications-list');
  const notifEmptyEl = document.getElementById('notifications-empty');
  const markAllBtn = document.getElementById('account-mark-all-read') as HTMLButtonElement | null;
  const clearAllBtn = document.getElementById('account-notif-clear') as HTMLButtonElement | null;
  const selectAllInput = document.getElementById('account-notif-select-all') as HTMLInputElement | null;
  const deleteSelectedBtn = document.getElementById('account-notif-delete-selected') as HTMLButtonElement | null;
  let notificationsCache: AppNotification[] = [];
  const actorProfiles = new Map<string, AccountPreview>();

  function defaultRemindAt() {
    return remindAtFromDays(READ_LATER_DEFAULT_REMIND_DAYS);
  }

  function formatNotifDate(iso: string) {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return '';
    if (currentLang() === 'EN') {
      return date.toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    }
    return date.toLocaleString('fr-FR', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function selectedNotifIds() {
    if (!notifListEl) return [];
    return Array.from(notifListEl.querySelectorAll<HTMLInputElement>('.account-notif-select:checked'))
      .map((input) => input.closest<HTMLElement>('.account-notif-item')?.dataset.notifId)
      .filter((id): id is string => Boolean(id));
  }

  function selectedNotifSlugs() {
    if (!notifListEl) return [];
    return Array.from(notifListEl.querySelectorAll<HTMLInputElement>('.account-notif-select:checked'))
      .map((input) => input.closest<HTMLElement>('.account-notif-item'))
      .filter((item) => item?.dataset.type === 'read_later')
      .map((item) => item?.dataset.slug || '')
      .filter(Boolean);
  }

  function readLaterSlugsFrom(items: AppNotification[]) {
    return items
      .filter((item) => item.type === 'read_later' || !item.type)
      .map((item) => item.article_slug || '')
      .filter(Boolean);
  }

  function notifKindKey(type: string) {
    if (type === 'comment_reply') return 'notif_comment_reply_prefix';
    if (type === 'comment_like') return 'notif_comment_like_prefix';
    return 'notif_read_later_prefix';
  }

  function notifHeadline(item: AppNotification, lang: 'FR' | 'EN') {
    if (item.type === 'comment_like') {
      return formatLikeActors(item.actor_usernames || [], lang);
    }
    if (item.type === 'comment_reply') {
      return formatReplyActor(item.actor_usernames?.[0], lang);
    }
    return lang === 'EN' && item.title_en ? item.title_en : item.title;
  }

  type ArticleTitleEntry = { slug: string; title: string; titleEn?: string | null };
  let articleTitlesCache: ArticleTitleEntry[] | null = null;

  function articleTitles(): ArticleTitleEntry[] {
    if (articleTitlesCache) return articleTitlesCache;
    const node = document.getElementById('sonar-article-titles');
    try {
      articleTitlesCache = node?.textContent ? JSON.parse(node.textContent) : [];
    } catch {
      articleTitlesCache = [];
    }
    return articleTitlesCache || [];
  }

  function articleTitleForSlug(slug: string | null | undefined, lang: 'FR' | 'EN') {
    if (!slug) return '';
    const entry = articleTitles().find((item) => item.slug === slug);
    if (!entry) return '';
    if (lang === 'EN' && entry.titleEn) return entry.titleEn;
    return entry.title || '';
  }

  function actorPreview(username: string) {
    return actorProfiles.get(username.trim().toLowerCase()) || null;
  }

  function notifAvatarHtml(username: string) {
    const profile = actorPreview(username);
    const color = profile?.avatar_color || '#ea580c';
    const url = profile?.avatar_url || null;
    if (url) {
      return `<span class="sonar-avatar account-notif-avatar" title="${escapeHtml(username)}">${avatarImgHtml(url)}</span>`;
    }
    return `<span class="sonar-avatar account-notif-avatar" title="${escapeHtml(username)}" style="background-color:${escapeHtml(color)}">${escapeHtml(avatarInitial(username || '?'))}</span>`;
  }

  function notifAvatarsHtml(item: AppNotification) {
    const names = (item.actor_usernames || []).map((name) => String(name || '').trim()).filter(Boolean).slice(0, 3);
    if (names.length === 0) return '';
    return `<div class="account-notif-avatars" aria-hidden="true">${names.map(notifAvatarHtml).join('')}</div>`;
  }

  function updateSelectionUi() {
    if (!notifListEl) return;
    const boxes = Array.from(notifListEl.querySelectorAll<HTMLInputElement>('.account-notif-select'));
    const checked = boxes.filter((box) => box.checked).length;
    if (selectAllInput) {
      selectAllInput.checked = boxes.length > 0 && checked === boxes.length;
      selectAllInput.indeterminate = checked > 0 && checked < boxes.length;
    }
    if (deleteSelectedBtn) deleteSelectedBtn.disabled = checked === 0;
  }

  function renderNotifications() {
    if (!notifListEl) return;
    const lang = currentLang();
    const unread = notificationsCache.filter((item) => !item.read_at).length;
    updateUnreadBadge(unread);

    if (markAllBtn) markAllBtn.disabled = unread === 0;
    if (clearAllBtn) clearAllBtn.disabled = notificationsCache.length === 0;
    if (selectAllInput) {
      selectAllInput.disabled = notificationsCache.length === 0;
      if (notificationsCache.length === 0) {
        selectAllInput.checked = false;
        selectAllInput.indeterminate = false;
      }
    }
    if (notifEmptyEl) notifEmptyEl.hidden = notificationsCache.length > 0;
    notifListEl.hidden = notificationsCache.length === 0;

    notifListEl.innerHTML = notificationsCache.map((item) => {
      const isRead = Boolean(item.read_at);
      const type = item.type || 'read_later';
      const isReadLater = type === 'read_later';
      const title = notifHeadline(item, lang);
      const commentHref = item.article_slug
        ? commentPermalink(item.article_slug, item.comment_id)
        : '#';
      const articleHref = item.article_slug ? `/articles/${item.article_slug}` : '#';
      const when = formatNotifDate(item.created_at);
      const kindKey = notifKindKey(type);
      const linkKey = isReadLater ? 'notif_read_article' : 'notif_see_comment';
      const snoozeBtns = READ_LATER_SNOOZE_DAYS.map((days) => (
        `<button type="button" class="account-notif-snooze-btn" data-snooze-days="${days}">${escapeHtml(snoozeLabel(days))}</button>`
      )).join('');
      const isLikeOnReply = type === 'comment_like' && Boolean(item.body);
      const excerpt = isReadLater ? '' : item.title;
      const body = type === 'comment_reply'
        ? stripLeadingMentions(item.body || '')
        : isLikeOnReply
          ? String(item.body || '')
          : '';
      const articleTitle = isReadLater ? '' : articleTitleForSlug(item.article_slug, lang);
      const kindIcon = type === 'comment_like'
        ? `<svg class="account-notif-kind-icon account-notif-kind-heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`
        : type === 'comment_reply'
          ? `<svg class="account-notif-kind-icon account-notif-kind-reply" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>`
          : '';
      const replyArrow = `<svg class="account-notif-reply-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polyline points="9 17 4 12 9 7"></polyline><path d="M20 18v-2a4 4 0 0 0-4-4H4"></path></svg>`;

      const avatars = isReadLater ? '' : notifAvatarsHtml(item);

      return `
        <article class="account-notif-item${isRead ? '' : ' is-unread'}${avatars ? ' has-avatars' : ''}" data-notif-id="${escapeHtml(item.id)}" data-slug="${escapeHtml(item.article_slug || '')}" data-type="${escapeHtml(type)}" data-read="${isRead ? 'true' : 'false'}">
          <label class="account-notif-check">
            <input type="checkbox" class="account-notif-select" />
          </label>
          ${avatars}
          <div class="account-notif-top">
            <p class="account-notif-kind${type === 'comment_like' ? ' account-notif-kind--like' : ''}${type === 'comment_reply' ? ' account-notif-kind--reply' : ''}">
              ${kindIcon}
              <span data-i18n="${kindKey}">${escapeHtml(t(kindKey))}</span>
            </p>
            <time class="account-notif-date" datetime="${escapeHtml(item.created_at)}">${escapeHtml(when)}</time>
            <button type="button" class="account-notif-toggle${isRead ? ' is-read' : ''}" title="${escapeHtml(isRead ? t('notif_mark_unread') : t('notif_mark_read'))}" aria-label="${escapeHtml(isRead ? t('notif_mark_unread') : t('notif_mark_read'))}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
