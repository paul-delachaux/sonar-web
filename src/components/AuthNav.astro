---
interface Props {
  variant?: 'home' | 'inner' | 'home-v2';
}

const { variant = 'inner' } = Astro.props;
const isIconVariant = variant === 'home-v2';
const currentPath = Astro.url.pathname;
const redirectPath = (currentPath === '/connexion' || currentPath === '/inscription')
  ? '/'
  : currentPath + Astro.url.search;
const loginHref = `/connexion?redirect=${encodeURIComponent(redirectPath)}`;
---

<div class:list={['auth-nav', `auth-nav--${variant}`]} data-auth-nav data-state="loading">
  {/* Le bouton "Connexion" reste en texte même pour la variante icône (home-v2) :
      seul l'état "connecté" ci-dessous passe en icône seule (avatar). */}
  <a href={loginHref} class="auth-nav-login" data-guest data-i18n="auth_login">Connexion</a>

  <div class="auth-nav-user" data-user hidden>
    <button
      type="button"
      class:list={['auth-nav-user-btn', isIconVariant && 'auth-nav-user-btn--icon']}
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="account-drawer"
    >
      <span class="sonar-avatar sonar-avatar-sm" data-auth-avatar aria-hidden="true"></span>
      {!isIconVariant && <span class="auth-nav-username" data-auth-username></span>}
    </button>
  </div>
</div>

<script>
  import { getBrowserSupabase, getCurrentAccount, type Account } from '../utils/supabase-browser';
  import { avatarInitial, avatarImgHtml, flushPendingAvatar } from '../utils/avatar';

  function fillAvatar(el: HTMLElement, account: Account) {
    el.style.backgroundColor = account.avatar_url ? 'transparent' : (account.avatar_color || '#ea580c');
    if (account.avatar_url) {
      el.innerHTML = avatarImgHtml(account.avatar_url);
    } else {
      el.textContent = avatarInitial(account.username);
    }
  }

  async function applyAuthState(nav: HTMLElement) {
    const guestEl = nav.querySelector('[data-guest]') as HTMLElement | null;
    const userEl = nav.querySelector('[data-user]') as HTMLElement | null;
    const usernameEl = nav.querySelector('[data-auth-username]') as HTMLElement | null;
    const avatarEl = nav.querySelector('[data-auth-avatar]') as HTMLElement | null;

    try {
      const supabase = getBrowserSupabase();
      try {
        await flushPendingAvatar(supabase);
      } catch {
        /* l'upload pourra être retenté au prochain chargement */
      }

      const account = await getCurrentAccount();
      if (!account) {
        nav.dataset.state = 'guest';
        guestEl?.removeAttribute('hidden');
        userEl?.setAttribute('hidden', '');
        return;
      }

      nav.dataset.state = 'user';
      guestEl?.setAttribute('hidden', '');
      userEl?.removeAttribute('hidden');
      if (usernameEl) usernameEl.textContent = account.username;
      if (avatarEl) fillAvatar(avatarEl, account);
    } catch {
      nav.dataset.state = 'guest';
      guestEl?.removeAttribute('hidden');
      userEl?.setAttribute('hidden', '');
    }
  }

  function setupNav(nav: HTMLElement) {
    const userBtn = nav.querySelector('.auth-nav-user-btn') as HTMLButtonElement | null;

    userBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      window.dispatchEvent(new CustomEvent('sonar:account-toggle'));
    });

    applyAuthState(nav);
  }

  document.querySelectorAll<HTMLElement>('[data-auth-nav]').forEach(setupNav);
</script>

<style>
  .auth-nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    line-height: 1;
  }

  .auth-nav[data-state="loading"] {
    visibility: hidden;
  }

  /* display: inline-flex plus bas écrase l'attribut HTML hidden :
     on pilote la visibilité via data-state. */
  .auth-nav[data-state="user"] .auth-nav-login,
  .auth-nav[data-state="guest"] .auth-nav-user,
  .auth-nav-user[hidden] {
    display: none !important;
  }

  .auth-nav-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ea580c;
    color: #ffffff;
    border-radius: 50px;
    font-weight: bold;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-decoration: none;
    white-space: nowrap;
    box-sizing: border-box;
    line-height: 1.2;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .auth-nav-login:hover {
    background-color: #d4510b;
    transform: scale(1.03);
  }

  /* Accueil : calé sur le bouton FR | ENG de l'accueil */
  .auth-nav--home .auth-nav-login {
    padding: 8px 20px;
    font-size: 0.9rem;
  }

  /* Pages internes : calé sur le bouton FR | ENG du header compact */
  .auth-nav--inner .auth-nav-login {
    padding: 8px 20px;
    font-size: 0.9rem;
  }

  /* Header accueil v2 : le bouton "Connexion" garde son texte, calé sur les
     autres boutons du header (ex. "Nos Journalistes"). */
  .auth-nav--home-v2 .auth-nav-login {
    padding: 7px 16px;
    font-size: 0.85rem;
  }

  /* Variante icône seule (header accueil v2, uniquement une fois connecté) :
     cercle avec l'avatar, sans pseudo affiché à côté. */
  .auth-nav-user-btn--icon {
    background-color: transparent;
    padding: 0;
    border-radius: 50%;
  }
  .auth-nav-user-btn--icon .sonar-avatar {
    width: 40px;
    height: 40px;
    font-size: 0.95rem;
  }

  .auth-nav-user-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: #ffffff;
    color: #03031a;
    border: none;
    border-radius: 100px;
    padding: 4px 4px 4px 4px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.85rem;
    font-family: inherit;
    line-height: 1.2;
    max-width: 180px;
  }

  .auth-nav-username {
    /* Sans min-width:0, un enfant flex refuse de rétrécir en dessous de la largeur
       de son texte : les "..." ci-dessous ne se déclenchaient donc jamais. */
    min-width: 0;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 968px) {
    .auth-nav--home .auth-nav-login {
      padding: 6px 14px;
      font-size: 0.8rem;
    }

    .auth-nav--inner .auth-nav-login {
      padding: 6px 14px;
      font-size: 0.8rem;
    }

    .auth-nav-username {
      display: none;
    }

    .auth-nav-user-btn {
      padding: 4px;
      max-width: none;
    }
  }
</style>
