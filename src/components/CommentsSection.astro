---
import { supabase } from '../utils/supabase';
import UserAvatar from './UserAvatar.astro';
import { formatCommentBody } from '../utils/comment-text';
import { detectCommentLang } from '../utils/comment-translate';

interface Props {
  articleSlug: string;
}

const { articleSlug } = Astro.props;

const redirectTo = `/articles/${articleSlug}`;

const { data: comments } = await supabase
  .from('comments')
  .select('*')
  .eq('article_slug', articleSlug)
  .order('created_at', { ascending: true });

const allComments = comments || [];
const commentIds = allComments.map((c: any) => c.id).filter(Boolean);

let likeCountById: Record<string, number> = {};
if (commentIds.length > 0) {
  const { data: likes, error: likesError } = await supabase
    .from('comment_likes')
    .select('comment_id')
    .in('comment_id', commentIds);

  if (!likesError) {
    for (const row of likes || []) {
      const id = String(row.comment_id);
      likeCountById[id] = (likeCountById[id] || 0) + 1;
    }
  }
}

const accountIds = [...new Set(allComments.map((c: any) => c.account_id).filter(Boolean))];

let accountsById: Record<string, { username: string; avatar_url: string | null; avatar_color: string }> = {};

if (accountIds.length > 0) {
  const { data: accounts } = await supabase
    .from('accounts')
    .select('id, username, avatar_url, avatar_color')
    .in('id', accountIds);

  accountsById = Object.fromEntries(
    (accounts || []).map((account: any) => [account.id, account])
  );
}

function commentAuthor(comment: any) {
  const account = comment.account_id ? accountsById[comment.account_id] : null;
  const username = account?.username || comment.author_name || 'Anonyme';
  return {
    username,
    avatarUrl: account?.avatar_url || null,
    avatarColor: account?.avatar_color || '#ea580c',
  };
}

function formatCommentStamp(iso: string) {
  const commentDate = new Date(iso);
  return {
    ts: commentDate.getTime(),
    dateFR: commentDate.toLocaleString('fr-FR', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }),
    dateEN: commentDate.toLocaleString('en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    }),
  };
}

const roots = allComments.filter((c: any) => !c.parent_id).reverse();
const repliesByParent = new Map<string, any[]>();
for (const comment of allComments) {
  if (!comment.parent_id) continue;
  const key = String(comment.parent_id);
  const list = repliesByParent.get(key) || [];
  list.push(comment);
  repliesByParent.set(key, list);
}

function repliesLabel(count: number, lang: 'FR' | 'EN') {
  if (lang === 'EN') return count === 1 ? '1 reply' : `${count} replies`;
  return count === 1 ? '1 réponse' : `${count} réponses`;
}

function sourceLangOf(comment: any) {
  if (comment.source_lang === 'en' || comment.source_lang === 'fr') return comment.source_lang;
  return detectCommentLang(String(comment.content || ''));
}

const commentCount = allComments.length;
---

<section class="comments-section">
  <button
    type="button"
    class="comments-toggle"
    id="comments-toggle"
    aria-expanded="false"
    aria-controls="comments-drawer"
  >
    <span data-i18n="comments_title">Espace Commentaires</span>
  </button>
</section>

<div class="comments-overlay" id="comments-overlay"></div>

<aside class="comments-drawer" id="comments-drawer" aria-label="Espace commentaires" aria-hidden="true">
  <div class="comments-drawer-inner">
    <header class="comments-drawer-header">
      <h2 class="comments-drawer-title" data-i18n="comments_title">Espace Commentaires</h2>

      <div class="comments-filters" role="tablist" aria-label="Trier les commentaires">
        <button type="button" class="comments-filter is-active" data-sort="recent" data-i18n="comments_filter_recent">
          les plus récents
        </button>
        <button type="button" class="comments-filter" data-sort="popular" data-i18n="comments_filter_popular">
          les plus likes
        </button>
        <button type="button" class="comments-filter" data-sort="debate" data-i18n="comments_filter_debate">
          les plus débattus
        </button>
      </div>

      <aside class="comments-charter-box">
        <p>
          <span data-i18n="comments_charter_before">Respectez notre </span>
          <a href="/charte-commentaires" data-i18n="comments_charter_link">charte des commentaires</a>
          <span data-i18n="comments_charter_after"> ou assistez impuissants à la suppression de votre misérable commentaire</span>
        </p>
      </aside>

      <button type="button" class="comments-drawer-close" id="comments-drawer-close" aria-label="Fermer les commentaires">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </header>

    <div id="comment-login-prompt" class="comment-login-prompt">
      <p data-i18n="comments_login_prompt">Connectez-vous pour publier un commentaire.</p>
      <div class="comment-login-actions">
        <a href={`/connexion?redirect=${encodeURIComponent(redirectTo)}`} class="comment-login-btn" data-i18n="auth_login">
          Connexion
        </a>
        <a href={`/inscription?redirect=${encodeURIComponent(redirectTo)}`} class="comment-signup-link" data-i18n="auth_create_account">
          Créer un compte
        </a>
      </div>
    </div>

    <form id="comment-form" data-slug={articleSlug} class="comment-form" hidden>
      <div class="comment-as">
        <span id="comment-form-avatar" class="sonar-avatar" aria-hidden="true"></span>
        <p>
          <span data-i18n="comments_as">Vous commentez en tant que</span>
          {' '}
          <strong id="comment-form-username"></strong>
        </p>
      </div>

      <div class="form-group">
        <label for="content" data-i18n="comments_label">Votre commentaire :</label>
        <textarea id="content" name="content" rows="4" required placeholder="Votre message..." data-i18n-placeholder="comments_placeholder"></textarea>
      </div>

      <button type="submit" id="submit-btn" data-i18n="comments_submit">Publier le commentaire</button>
      <p id="form-message"></p>
    </form>

    <div class="comments-list" data-count={commentCount}>
      {roots.length > 0 ? (
        roots.map((comment: any) => {
          const author = commentAuthor(comment);
          const stamp = formatCommentStamp(comment.created_at);
          const replies = repliesByParent.get(String(comment.id)) || [];
          const likes = likeCountById[String(comment.id)] || 0;

          return (
            <article
              class="comment-thread"
              data-id={comment.id}
              data-created-at={stamp.ts}
              data-likes={likes}
              data-replies={replies.length}
            >
              <div class="comment-card" id={`comment-${comment.id}`} data-comment-id={comment.id} data-author={author.username} data-account-id={comment.account_id || ''} data-source-lang={sourceLangOf(comment)}>
                <div class="comment-header">
                  <UserAvatar
                    username={author.username}
                    avatarUrl={author.avatarUrl}
                    avatarColor={author.avatarColor}
                  />
                  <strong class="author">{author.username}</strong>
                  <time class="date" datetime={comment.created_at} data-fr={stamp.dateFR} data-en={stamp.dateEN}>
                    {stamp.dateFR}
                  </time>
                </div>
                <p class="comment-body" data-original={comment.content} set:html={formatCommentBody(comment.content)} />
                <div class="comment-actions">
                  <button type="button" class="comment-like" data-comment-id={comment.id} aria-pressed="false" title="J'aime">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                    <span class="comment-like-count">{likes}</span>
                  </button>
                  <button type="button" class="comment-reply-btn" data-i18n="comments_reply">Répondre</button>
                  <button type="button" class="comment-translate-btn" data-i18n="comments_translate" hidden>Traduire</button>
                  <button type="button" class="comment-report-btn" data-i18n="comments_report">Signaler</button>
                  <button type="button" class="comment-delete-btn" hidden data-i18n="comments_delete">Supprimer</button>
                </div>
              </div>

              <button
                type="button"
                class="comment-replies-toggle"
                aria-expanded="false"
                hidden={replies.length === 0}
              >
                <span class="comment-replies-caret" aria-hidden="true"></span>
                <span
                  class="comment-replies-label"
                  data-fr={repliesLabel(replies.length, 'FR')}
                  data-en={repliesLabel(replies.length, 'EN')}
                >
                  {repliesLabel(replies.length, 'FR')}
                </span>
              </button>

              <div class="comment-replies" hidden>
                {replies.map((reply: any) => {
                  const replyAuthor = commentAuthor(reply);
                  const replyStamp = formatCommentStamp(reply.created_at);
                  const replyLikes = likeCountById[String(reply.id)] || 0;
                  return (
                    <div class="comment-card comment-card--reply" id={`comment-${reply.id}`} data-comment-id={reply.id} data-author={replyAuthor.username} data-account-id={reply.account_id || ''} data-source-lang={sourceLangOf(reply)}>
                      <div class="comment-header">
                        <UserAvatar
                          username={replyAuthor.username}
                          avatarUrl={replyAuthor.avatarUrl}
                          avatarColor={replyAuthor.avatarColor}
                          size="sm"
                        />
                        <strong class="author">{replyAuthor.username}</strong>
                        <time class="date" datetime={reply.created_at} data-fr={replyStamp.dateFR} data-en={replyStamp.dateEN}>
                          {replyStamp.dateFR}
                        </time>
                      </div>
                      <p class="comment-body" data-original={reply.content} set:html={formatCommentBody(reply.content)} />
                      <div class="comment-actions">
                        <button type="button" class="comment-like" data-comment-id={reply.id} aria-pressed="false" title="J'aime">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                          </svg>
                          <span class="comment-like-count">{replyLikes}</span>
                        </button>
                        <button type="button" class="comment-reply-btn" data-i18n="comments_reply">Répondre</button>
                        <button type="button" class="comment-translate-btn" data-i18n="comments_translate" hidden>Traduire</button>
                        <button type="button" class="comment-report-btn" data-i18n="comments_report">Signaler</button>
                        <button type="button" class="comment-delete-btn" hidden data-i18n="comments_delete">Supprimer</button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </article>
          );
        })
      ) : (
        <p class="no-comments" data-i18n="comments_empty">Soyez le premier à laisser un commentaire !</p>
      )}
    </div>
  </div>
</aside>

<dialog class="comment-report-dialog" id="comment-report-dialog" aria-labelledby="comment-report-title">
  <form id="comment-report-form">
    <h3 id="comment-report-title" data-i18n="comments_report_title">Signaler ce commentaire</h3>
    <p class="comment-report-lead" data-i18n="comments_report_lead">Confirmez le signalement. Un modérateur l’examinera.</p>
    <fieldset class="comment-report-reasons">
      <legend data-i18n="comments_report_reason">Motif</legend>
      <label><input type="radio" name="reason" value="insult" required /> <span data-i18n="comments_report_reason_insult">Insultes ou harcèlement</span></label>
      <label><input type="radio" name="reason" value="spam" /> <span data-i18n="comments_report_reason_spam">Spam</span></label>
      <label><input type="radio" name="reason" value="illegal" /> <span data-i18n="comments_report_reason_illegal">Contenu illégal ou dangereux</span></label>
      <label><input type="radio" name="reason" value="offtopic" /> <span data-i18n="comments_report_reason_offtopic">Hors-sujet</span></label>
      <label><input type="radio" name="reason" value="other" /> <span data-i18n="comments_report_reason_other">Autre</span></label>
    </fieldset>
    <label class="comment-report-details-label" for="comment-report-details" data-i18n="comments_report_details">Précisions (optionnel)</label>
    <textarea id="comment-report-details" name="details" rows="3" maxlength="500"></textarea>
    <p class="comment-report-message" id="comment-report-message" hidden></p>
    <div class="comment-report-actions">
      <button type="submit" class="comment-report-submit" data-i18n="comments_report_submit">Envoyer le signalement</button>
      <button type="button" class="comment-report-cancel" id="comment-report-cancel" data-i18n="comments_report_cancel">Annuler</button>
    </div>
  </form>
</dialog>

<script>
  import { getBrowserSupabase, getCurrentAccount, listMyCommentLikes, setCommentLiked, deleteOwnComment, type Account } from '../utils/supabase-browser';
  import { avatarInitial, avatarImgHtml } from '../utils/avatar';
  import { t as translate } from '../utils/i18n.js';
  import { escapeHtml, formatCommentBody } from '../utils/comment-text';
  import { detectCommentLang } from '../utils/comment-translate';

  const form = document.getElementById('comment-form') as HTMLFormElement | null;
  const loginPrompt = document.getElementById('comment-login-prompt');
  const messageEl = document.getElementById('form-message');
  const usernameEl = document.getElementById('comment-form-username');
  const avatarEl = document.getElementById('comment-form-avatar');
  const toggleBtn = document.getElementById('comments-toggle');
  const closeBtn = document.getElementById('comments-drawer-close');
  const overlay = document.getElementById('comments-overlay');
  const drawer = document.getElementById('comments-drawer');
  const listEl = document.querySelector('.comments-list');
  const reportDialog = document.getElementById('comment-report-dialog') as HTMLDialogElement | null;
  const reportForm = document.getElementById('comment-report-form') as HTMLFormElement | null;
  const reportMessageEl = document.getElementById('comment-report-message');
  const redirectTo = `/articles/${form?.dataset.slug || ''}`;
  let currentAccount: Account | null = null;
  let reportTargetId = '';
  let reportTargetBtn: HTMLButtonElement | null = null;

  function currentLang(): 'FR' | 'EN' {
    return (localStorage.getItem('site_lang') || 'FR').toUpperCase() === 'EN' ? 'EN' : 'FR';
  }

  function t(key: string) {
    return translate(key, currentLang());
  }

  function loginRedirect() {
    window.location.href = `/connexion?redirect=${encodeURIComponent(redirectTo)}`;
  }

  function closeReportDialog() {
    reportDialog?.close();
    reportTargetId = '';
    reportTargetBtn = null;
  }

  function setReportMessage(text: string, kind: 'ok' | 'err' | '') {
    if (!reportMessageEl) return;
    if (!text) {
      reportMessageEl.hidden = true;
      reportMessageEl.textContent = '';
      return;
    }
    reportMessageEl.hidden = false;
    reportMessageEl.textContent = text;
    reportMessageEl.style.color = kind === 'ok' ? '#4ade80' : '#ef4444';
  }

  function markReported(btn: HTMLButtonElement | null) {
    if (!btn) return;
    btn.dataset.reported = '1';
    btn.disabled = true;
    btn.textContent = t('comments_reported');
  }

  function openReportDialog(commentId: string, btn: HTMLButtonElement) {
    if (!reportDialog || !reportForm) return;
    reportTargetId = commentId;
    reportTargetBtn = btn;
    reportForm.reset();
    setReportMessage('', '');
    const submitBtn = reportForm.querySelector<HTMLButtonElement>('.comment-report-submit');
    if (submitBtn) submitBtn.disabled = false;
    if (typeof reportDialog.showModal === 'function') reportDialog.showModal();
    else reportDialog.setAttribute('open', '');
  }

  if (reportDialog && reportDialog.parentElement !== document.body) {
    document.body.appendChild(reportDialog);
  }

  document.getElementById('comment-report-cancel')?.addEventListener('click', () => {
    closeReportDialog();
  });
  reportDialog?.addEventListener('click', (event) => {
    if (event.target === reportDialog) closeReportDialog();
  });

  reportForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!reportForm || !reportTargetId) return;
    const payload = new FormData(reportForm);
    const reason = String(payload.get('reason') || '');
    const details = String(payload.get('details') || '').trim();
    const submitBtn = reportForm.querySelector<HTMLButtonElement>('.comment-report-submit');
    if (submitBtn) submitBtn.disabled = true;
    setReportMessage('', '');
    try {
      const supabase = getBrowserSupabase();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        loginRedirect();
        return;
      }
      const res = await fetch('/api/comments/report', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({
          comment_id: reportTargetId,
          reason,
          details,
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        setReportMessage(result.message || t('comments_report_error'), 'err');
        if (submitBtn) submitBtn.disabled = false;
        if (res.status === 409) markReported(reportTargetBtn);
        return;
      }
      markReported(reportTargetBtn);
      setReportMessage(t('comments_report_thanks'), 'ok');
      window.setTimeout(() => closeReportDialog(), 1200);
    } catch {
      setReportMessage(t('comments_report_error'), 'err');
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  function fillAvatar(el: HTMLElement, account: Account) {
    el.style.backgroundColor = account.avatar_url ? 'transparent' : (account.avatar_color || '#ea580c');
    if (account.avatar_url) {
      el.innerHTML = avatarImgHtml(account.avatar_url);
    } else {
      el.textContent = avatarInitial(account.username);
    }
  }

  function avatarMarkup(username: string, avatarUrl: string | null, avatarColor: string, small = false) {
    const sizeClass = small ? ' sonar-avatar-sm' : '';
    if (avatarUrl) {
      return `<span class="sonar-avatar${sizeClass}">${avatarImgHtml(avatarUrl)}</span>`;
    }
    return `<span class="sonar-avatar${sizeClass}" style="background-color:${escapeHtml(avatarColor)}">${escapeHtml(avatarInitial(username))}</span>`;
  }

  function formatStamp(iso: string) {
    const commentDate = new Date(iso);
    return {
      ts: commentDate.getTime(),
      dateFR: commentDate.toLocaleString('fr-FR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }),
      dateEN: commentDate.toLocaleString('en-US', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      }),
    };
  }

  function isDrawerOpen() {
    return Boolean(drawer && drawer.classList.contains('is-open'));
  }

  function openDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer || !overlay || !isDrawerOpen()) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggleBtn?.focus();
  }

  if (overlay && overlay.parentElement !== document.body) {
    document.body.appendChild(overlay);
  }
  if (drawer && drawer.parentElement !== document.body) {
    document.body.appendChild(drawer);
  }

  function currentSort() {
    const active = document.querySelector('.comments-filter.is-active') as HTMLElement | null;
    return active?.dataset.sort || 'recent';
  }

  function sortComments(mode: string) {
    if (!listEl) return;
    const threads = Array.from(listEl.querySelectorAll('.comment-thread'));
    threads.sort((a, b) => {
      const elA = a as HTMLElement;
      const elB = b as HTMLElement;
      if (mode === 'popular') {
        const likes = Number(elB.dataset.likes || 0) - Number(elA.dataset.likes || 0);
        if (likes) return likes;
      }
      if (mode === 'debate') {
        const replies = Number(elB.dataset.replies || 0) - Number(elA.dataset.replies || 0);
        if (replies) return replies;
      }
      return Number(elB.dataset.createdAt || 0) - Number(elA.dataset.createdAt || 0);
    });
    threads.forEach((thread) => listEl.appendChild(thread));
  }

  toggleBtn?.addEventListener('click', () => {
    if (isDrawerOpen()) closeDrawer();
    else openDrawer();
  });
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const reportDialog = document.getElementById('comment-report-dialog') as HTMLDialogElement | null;
      if (reportDialog?.open) return;
      closeDrawer();
    }
  });

  document.querySelectorAll('.comments-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.comments-filter').forEach((el) => el.classList.remove('is-active'));
      btn.classList.add('is-active');
      sortComments((btn as HTMLElement).dataset.sort || 'recent');
    });
  });

  const HEART_SVG = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;

  function repliesLabel(count: number, lang: 'FR' | 'EN' = currentLang()) {
    if (lang === 'EN') return count === 1 ? '1 reply' : `${count} replies`;
    return count === 1 ? '1 réponse' : `${count} réponses`;
  }

  function applyLikeState(btn: HTMLButtonElement, liked: boolean) {
    btn.classList.toggle('is-liked', liked);
    btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
  }

  async function markLikedComments() {
    if (!listEl || !currentAccount) return;
    const ids = Array.from(listEl.querySelectorAll<HTMLElement>('[data-comment-id]'))
      .map((el) => el.dataset.commentId || '')
      .filter(Boolean);
    try {
      const liked = await listMyCommentLikes(ids);
      listEl.querySelectorAll<HTMLButtonElement>('.comment-like').forEach((btn) => {
        applyLikeState(btn, liked.has(btn.dataset.commentId || ''));
      });
    } catch {
      /* table absente ou hors ligne */
    }
  }

  function commentCardHtml(opts: {
    id: string;
    username: string;
    avatarUrl: string | null;
    avatarColor: string;
    content: string;
    rawDate: string;
    likes?: number;
    isReply?: boolean;
    accountId?: string | null;
    sourceLang?: string | null;
  }) {
    const stamp = formatStamp(opts.rawDate);
    const dateToDisplay = currentLang() === 'EN' ? stamp.dateEN : stamp.dateFR;
    const isOwn = Boolean(currentAccount && opts.accountId && currentAccount.id === opts.accountId);
    const sourceLang = opts.sourceLang === 'en' || opts.sourceLang === 'fr' ? opts.sourceLang : detectCommentLang(opts.content);
    return `
      <div class="comment-card${opts.isReply ? ' comment-card--reply' : ''}" id="comment-${escapeHtml(opts.id)}" data-comment-id="${escapeHtml(opts.id)}" data-author="${escapeHtml(opts.username)}" data-account-id="${escapeHtml(opts.accountId || '')}" data-source-lang="${sourceLang}">
        <div class="comment-header">
          ${avatarMarkup(opts.username, opts.avatarUrl, opts.avatarColor, opts.isReply)}
          <strong class="author">${escapeHtml(opts.username)}</strong>
          <time class="date" datetime="${escapeHtml(opts.rawDate)}" data-fr="${escapeHtml(stamp.dateFR)}" data-en="${escapeHtml(stamp.dateEN)}">${escapeHtml(dateToDisplay)}</time>
        </div>
        <p class="comment-body" data-original="${escapeHtml(opts.content)}">${formatCommentBody(opts.content)}</p>
        <div class="comment-actions">
          <button type="button" class="comment-like" data-comment-id="${escapeHtml(opts.id)}" aria-pressed="false" title="${escapeHtml(t('comments_like'))}">
            ${HEART_SVG}
            <span class="comment-like-count">${opts.likes || 0}</span>
          </button>
          <button type="button" class="comment-reply-btn" data-i18n="comments_reply">${escapeHtml(t('comments_reply'))}</button>
          <button type="button" class="comment-translate-btn" data-i18n="comments_translate" hidden>${escapeHtml(t('comments_translate'))}</button>
          <button type="button" class="comment-report-btn" data-i18n="comments_report"${isOwn ? ' hidden' : ''}>${escapeHtml(t('comments_report'))}</button>
          <button type="button" class="comment-delete-btn" data-i18n="comments_delete"${isOwn ? '' : ' hidden'}>${escapeHtml(t('comments_delete'))}</button>
        </div>
      </div>
    `;
  }

  function syncTranslateButtons() {
    const lang = currentLang() === 'EN' ? 'en' : 'fr';
    listEl?.querySelectorAll<HTMLElement>('.comment-card').forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('.comment-translate-btn');
      const body = card.querySelector<HTMLElement>('.comment-body');
      if (!btn || !body) return;
      const source = (card.dataset.sourceLang || detectCommentLang(body.dataset.original || body.textContent || '')).toLowerCase();
      const showingTranslated = body.dataset.showing === 'translated';
      const needsTranslate = source !== lang;
      btn.hidden = !needsTranslate && !showingTranslated;
      btn.textContent = showingTranslated ? t('comments_show_original') : t('comments_translate');
    });
  }

  function setThreadReplyCount(thread: HTMLElement, count: number) {
    thread.dataset.replies = String(count);
    const toggle = thread.querySelector<HTMLButtonElement>('.comment-replies-toggle');
    const label = thread.querySelector<HTMLElement>('.comment-replies-label');
    if (toggle) toggle.hidden = count === 0;
    if (label) {
      label.setAttribute('data-fr', repliesLabel(count, 'FR'));
      label.setAttribute('data-en', repliesLabel(count, 'EN'));
      label.textContent = repliesLabel(count);
    }
  }

  function revealOwnDeleteButtons() {
    if (!listEl) return;
    listEl.querySelectorAll<HTMLElement>('.comment-card').forEach((card) => {
      const isOwn = Boolean(currentAccount && card.dataset.accountId && card.dataset.accountId === currentAccount.id);
      const deleteBtn = card.querySelector<HTMLButtonElement>('.comment-delete-btn');
      const reportBtn = card.querySelector<HTMLButtonElement>('.comment-report-btn');
      if (deleteBtn) deleteBtn.hidden = !isOwn;
      if (reportBtn && reportBtn.dataset.reported !== '1') reportBtn.hidden = isOwn;
    });
  }

  function closeReplyForms(except?: HTMLElement | null) {
    listEl?.querySelectorAll<HTMLElement>('.comment-reply-form').forEach((formEl) => {
      if (formEl !== except) formEl.remove();
    });
  }

  function openReplyForm(card: HTMLElement) {
    if (!currentAccount) {
      loginRedirect();
      return;
    }
    const existing = card.querySelector<HTMLElement>('.comment-reply-form');
    if (existing) {
      existing.remove();
      return;
    }
    closeReplyForms();
    const author = card.dataset.author || '';
    const formEl = document.createElement('form');
    formEl.className = 'comment-reply-form';
    formEl.innerHTML = `
      <textarea name="content" rows="3" required placeholder="${escapeHtml(t('comments_reply_placeholder'))}">${author ? `@${escapeHtml(author)} ` : ''}</textarea>
      <div class="comment-reply-form-actions">
        <button type="submit">${escapeHtml(t('comments_reply'))}</button>
        <button type="button" class="comment-reply-cancel">${escapeHtml(t('comments_reply_cancel'))}</button>
        <p class="comment-reply-message"></p>
      </div>
    `;
    card.appendChild(formEl);
    formEl.querySelector('textarea')?.focus();
  }

  async function setupCommentsAuth() {
    currentAccount = await getCurrentAccount();
    if (!currentAccount) {
      loginPrompt?.removeAttribute('hidden');
      form?.setAttribute('hidden', '');
      return null;
    }

    loginPrompt?.setAttribute('hidden', '');
    form?.removeAttribute('hidden');
    if (usernameEl) usernameEl.textContent = currentAccount.username;
    if (avatarEl) fillAvatar(avatarEl, currentAccount);
    await markLikedComments();
    revealOwnDeleteButtons();
    syncTranslateButtons();
    return currentAccount;
  }

  const currentAccountPromise = setupCommentsAuth();
  syncTranslateButtons();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!messageEl || !form) return;

    const account = currentAccount || await currentAccountPromise;
    if (!account) {
      messageEl.textContent = 'Vous devez être connecté pour commenter.';
      messageEl.style.color = '#ef4444';
      return;
    }

    messageEl.textContent = 'Publication en cours...';
    messageEl.style.color = '#9ca3af';

    const formData = new FormData(form);
    const content = formData.get('content') as string;

    const payload = {
      article_slug: form.dataset.slug,
      content: content,
    };

    try {
      const supabase = getBrowserSupabase();
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        messageEl.textContent = 'Session expirée. Reconnectez-vous.';
        messageEl.style.color = '#ef4444';
        return;
      }

      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify(payload),
      });

      const result = await res.json();

      if (res.ok) {
        messageEl.textContent = 'Commentaire publié avec succès !';
        messageEl.style.color = '#22c55e';

        if (listEl) {
          const noCommentsEl = listEl.querySelector('.no-comments');
          if (noCommentsEl) noCommentsEl.remove();

          const insertedComment = result.data || result.comment;
          const rawDate = insertedComment && insertedComment.created_at
            ? insertedComment.created_at
            : new Date().toISOString();
          const stamp = formatStamp(rawDate);
          const username = insertedComment?.username || account.username;
          const avatarUrl = insertedComment?.avatar_url ?? account.avatar_url;
          const avatarColor = insertedComment?.avatar_color || account.avatar_color;
          const commentId = String(insertedComment?.id || `tmp-${Date.now()}`);

          const thread = document.createElement('article');
          thread.className = 'comment-thread';
          thread.dataset.id = commentId;
          thread.dataset.createdAt = String(stamp.ts);
          thread.dataset.likes = '0';
          thread.dataset.replies = '0';
          thread.innerHTML = `
            ${commentCardHtml({
              id: commentId,
              username,
              avatarUrl,
              avatarColor,
              content,
              rawDate,
              accountId: account.id,
              sourceLang: insertedComment?.source_lang || detectCommentLang(content),
            })}
            <button type="button" class="comment-replies-toggle" aria-expanded="false" hidden>
              <span class="comment-replies-caret" aria-hidden="true"></span>
              <span class="comment-replies-label" data-fr="${escapeHtml(repliesLabel(0, 'FR'))}" data-en="${escapeHtml(repliesLabel(0, 'EN'))}">${escapeHtml(repliesLabel(0))}</span>
            </button>
            <div class="comment-replies" hidden></div>
          `;

          listEl.prepend(thread);
          sortComments(currentSort());
          syncTranslateButtons();
        }

        form.reset();
      } else {
        messageEl.textContent = result.message || 'Une erreur est survenue.';
        messageEl.style.color = '#ef4444';
      }
    } catch (err) {
      messageEl.textContent = 'Erreur de connexion au serveur.';
      messageEl.style.color = '#ef4444';
    }
  });

  listEl?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const likeBtn = target.closest<HTMLButtonElement>('.comment-like');
    if (likeBtn) {
      if (!currentAccount) {
        loginRedirect();
        return;
      }
      const commentId = likeBtn.dataset.commentId;
      if (!commentId || likeBtn.dataset.busy === '1') return;
      likeBtn.dataset.busy = '1';
      const nextLiked = !likeBtn.classList.contains('is-liked');
      const countEl = likeBtn.querySelector('.comment-like-count');
      const currentCount = Number(countEl?.textContent || 0);
      applyLikeState(likeBtn, nextLiked);
      if (countEl) countEl.textContent = String(Math.max(0, currentCount + (nextLiked ? 1 : -1)));

      const thread = likeBtn.closest<HTMLElement>('.comment-thread');
      if (thread && thread.dataset.id === commentId) {
        thread.dataset.likes = countEl?.textContent || '0';
      }

      try {
        await setCommentLiked(commentId, nextLiked);
        sortComments(currentSort());
      } catch (err) {
        applyLikeState(likeBtn, !nextLiked);
        if (countEl) countEl.textContent = String(currentCount);
        if (thread && thread.dataset.id === commentId) thread.dataset.likes = String(currentCount);
        if (err instanceof Error && (err.name === 'AuthRequired' || err.message === 'AUTH_REQUIRED')) {
          loginRedirect();
        }
      } finally {
        delete likeBtn.dataset.busy;
      }
      return;
    }

    const replyBtn = target.closest<HTMLElement>('.comment-reply-btn');
    if (replyBtn) {
      const card = replyBtn.closest<HTMLElement>('.comment-card');
      if (card) openReplyForm(card);
      return;
    }

    const translateBtn = target.closest<HTMLButtonElement>('.comment-translate-btn');
    if (translateBtn) {
      const card = translateBtn.closest<HTMLElement>('.comment-card');
      const body = card?.querySelector<HTMLElement>('.comment-body');
      const commentId = card?.dataset.commentId;
      if (!card || !body || !commentId) return;
      if (body.dataset.showing === 'translated') {
        body.innerHTML = formatCommentBody(body.dataset.original || '');
        delete body.dataset.showing;
        translateBtn.textContent = t('comments_translate');
        return;
      }
      if (body.dataset.translated) {
        body.innerHTML = formatCommentBody(body.dataset.translated);
        body.dataset.showing = 'translated';
        translateBtn.textContent = t('comments_show_original');
        return;
      }
      const previous = translateBtn.textContent;
      translateBtn.disabled = true;
      translateBtn.textContent = currentLang() === 'EN' ? 'Translating…' : 'Traduction…';
      try {
        const res = await fetch('/api/comments/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: commentId,
            target: currentLang() === 'EN' ? 'en' : 'fr',
          }),
        });
        const result = await res.json();
        if (!res.ok || !result.translated) {
          translateBtn.textContent = result.message || t('comments_translate_error');
          window.setTimeout(() => {
            translateBtn.textContent = previous || t('comments_translate');
            translateBtn.disabled = false;
          }, 2200);
          return;
        }
        body.dataset.translated = result.translated;
        if (result.source_lang) card.dataset.sourceLang = result.source_lang;
        body.innerHTML = formatCommentBody(result.translated);
        body.dataset.showing = 'translated';
        translateBtn.textContent = t('comments_show_original');
        translateBtn.disabled = false;
      } catch {
        translateBtn.textContent = t('comments_translate_error');
        window.setTimeout(() => {
          translateBtn.textContent = previous || t('comments_translate');
          translateBtn.disabled = false;
        }, 2200);
      }
      return;
    }

    const cancelBtn = target.closest<HTMLElement>('.comment-reply-cancel');
    if (cancelBtn) {
      cancelBtn.closest('.comment-reply-form')?.remove();
      return;
    }

    const reportBtn = target.closest<HTMLButtonElement>('.comment-report-btn');
    if (reportBtn) {
      if (reportBtn.dataset.reported === '1') return;
      const card = reportBtn.closest<HTMLElement>('.comment-card');
      const commentId = card?.dataset.commentId;
      if (!commentId) return;
      if (!currentAccount) {
        loginRedirect();
        return;
      }
      openReportDialog(commentId, reportBtn);
      return;
    }

    const deleteBtn = target.closest<HTMLButtonElement>('.comment-delete-btn');
    if (deleteBtn) {
      const card = deleteBtn.closest<HTMLElement>('.comment-card');
      const commentId = card?.dataset.commentId;
      if (!commentId || !currentAccount) {
        loginRedirect();
        return;
      }
      if (!confirm(t('comments_delete_confirm'))) return;
      try {
        await deleteOwnComment(commentId);
        const thread = card?.closest<HTMLElement>('.comment-thread');
        const isReply = card?.classList.contains('comment-card--reply');
        card?.remove();
        if (thread && isReply) {
          setThreadReplyCount(thread, Math.max(0, Number(thread.dataset.replies || 0) - 1));
        } else if (thread) {
          thread.remove();
        }
        if (listEl && !listEl.querySelector('.comment-thread') && !listEl.querySelector('.no-comments')) {
          const empty = document.createElement('p');
          empty.className = 'no-comments';
          empty.setAttribute('data-i18n', 'comments_empty');
          empty.textContent = t('comments_empty');
          listEl.appendChild(empty);
        }
      } catch (err) {
        if (err instanceof Error && (err.name === 'AuthRequired' || err.message === 'AUTH_REQUIRED')) {
          loginRedirect();
        }
      }
      return;
    }

    const toggleReplies = target.closest<HTMLButtonElement>('.comment-replies-toggle');
    if (toggleReplies) {
      const thread = toggleReplies.closest<HTMLElement>('.comment-thread');
      const replies = thread?.querySelector<HTMLElement>('.comment-replies');
      if (!replies) return;
      const open = toggleReplies.getAttribute('aria-expanded') === 'true';
      toggleReplies.setAttribute('aria-expanded', open ? 'false' : 'true');
      replies.querySelectorAll('.is-highlighted').forEach((el) => el.classList.remove('is-highlighted'));
      replies.hidden = open;
    }
  });

  listEl?.addEventListener('submit', async (event) => {
    const replyForm = (event.target as HTMLElement | null)?.closest<HTMLFormElement>('.comment-reply-form');
    if (!replyForm) return;
    event.preventDefault();

    const account = currentAccount;
    const messageBox = replyForm.querySelector<HTMLElement>('.comment-reply-message');
    if (!account) {
      loginRedirect();
      return;
    }

    const card = replyForm.closest<HTMLElement>('.comment-card');
    const thread = replyForm.closest<HTMLElement>('.comment-thread');
    const parentId = thread?.dataset.id || card?.dataset.commentId;
    const textarea = replyForm.querySelector<HTMLTextAreaElement>('textarea');
    const content = String(textarea?.value || '').trim();
    if (!content || !parentId || !form || replyForm.dataset.busy === '1') return;
    replyForm.dataset.busy = '1';

    if (messageBox) {
      messageBox.textContent = '...';
      messageBox.style.color = '#9ca3af';
    }

    try {
      const supabase = getBrowserSupabase();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        loginRedirect();
        return;
      }

      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({
          article_slug: form.dataset.slug,
          content,
          parent_id: parentId,
          reply_to_id: card?.dataset.commentId || parentId,
        }),
      });
      const result = await res.json();
      if (!res.ok) {
        if (messageBox) {
          messageBox.textContent = result.message || 'Erreur';
          messageBox.style.color = '#ef4444';
        }
        delete replyForm.dataset.busy;
        return;
      }

      const inserted = result.data || {};
      const rawDate = inserted.created_at || new Date().toISOString();
      const repliesBox = thread?.querySelector<HTMLElement>('.comment-replies');
      if (thread && repliesBox) {
        const wrap = document.createElement('div');
        wrap.innerHTML = commentCardHtml({
          id: String(inserted.id || `tmp-${Date.now()}`),
          username: inserted.username || account.username,
          avatarUrl: inserted.avatar_url ?? account.avatar_url,
          avatarColor: inserted.avatar_color || account.avatar_color,
          content,
          rawDate,
          isReply: true,
          accountId: account.id,
          sourceLang: inserted.source_lang || detectCommentLang(content),
        });
        const node = wrap.firstElementChild;
        if (node) repliesBox.appendChild(node);
        repliesBox.hidden = false;
        const toggle = thread.querySelector<HTMLButtonElement>('.comment-replies-toggle');
        toggle?.setAttribute('aria-expanded', 'true');
        setThreadReplyCount(thread, Number(thread.dataset.replies || 0) + 1);
        sortComments(currentSort());
        syncTranslateButtons();
      }
      replyForm.remove();
    } catch {
      delete replyForm.dataset.busy;
      if (messageBox) {
        messageBox.textContent = 'Erreur de connexion au serveur.';
        messageBox.style.color = '#ef4444';
      }
    }
  });

  window.addEventListener('languageChanged', () => {
    document.querySelectorAll<HTMLElement>('.comment-replies-label').forEach((label) => {
      const count = Number(label.closest('.comment-thread')?.getAttribute('data-replies') || 0);
      label.setAttribute('data-fr', repliesLabel(count, 'FR'));
      label.setAttribute('data-en', repliesLabel(count, 'EN'));
      label.textContent = repliesLabel(count);
    });
    document.querySelectorAll<HTMLElement>('.comment-reply-btn').forEach((btn) => {
      btn.textContent = t('comments_reply');
    });
    document.querySelectorAll<HTMLElement>('.comment-delete-btn').forEach((btn) => {
      btn.textContent = t('comments_delete');
    });
    document.querySelectorAll<HTMLElement>('.comment-report-btn').forEach((btn) => {
      btn.textContent = btn.dataset.reported === '1' ? t('comments_reported') : t('comments_report');
    });
    const reportDialog = document.getElementById('comment-report-dialog');
    reportDialog?.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) el.textContent = t(key);
    });
    syncTranslateButtons();
    document.querySelectorAll<HTMLElement>('.comment-reply-cancel').forEach((btn) => {
      btn.textContent = t('comments_reply_cancel');
    });
    document.querySelectorAll<HTMLButtonElement>('.comment-like').forEach((btn) => {
      btn.title = t('comments_like');
    });
  });

  function commentIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const fromQuery = params.get('comment');
    if (fromQuery) return fromQuery;
    const hash = window.location.hash;
    if (hash.startsWith('#comment-')) return hash.slice('#comment-'.length);
    return '';
  }

  function clearCommentQuery() {
    const url = new URL(window.location.href);
    const hadQuery = url.searchParams.has('comment');
    const hadHash = url.hash.startsWith('#comment-');
    if (!hadQuery && !hadHash) return;
    url.searchParams.delete('comment');
    if (hadHash) url.hash = '';
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
  }

  function focusComment(commentId: string) {
    const card = listEl?.querySelector<HTMLElement>(`[data-comment-id="${CSS.escape(commentId)}"]`);
    if (!card) return false;
    const thread = card.closest<HTMLElement>('.comment-thread');
    if (card.classList.contains('comment-card--reply') && thread) {
      const toggle = thread.querySelector<HTMLButtonElement>('.comment-replies-toggle');
      const replies = thread.querySelector<HTMLElement>('.comment-replies');
      if (toggle && replies) {
        toggle.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        replies.hidden = false;
      }
    }
    card.classList.remove('is-highlighted');
    void card.offsetWidth;
    card.classList.add('is-highlighted');
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const clearHighlight = () => card.classList.remove('is-highlighted');
    card.addEventListener('animationend', clearHighlight, { once: true });
    window.setTimeout(clearHighlight, 3000);
    clearCommentQuery();
    return true;
  }

  const focusId = commentIdFromUrl();
  if (focusId) {
    openDrawer();
    window.setTimeout(() => {
      if (!focusComment(focusId)) {
        window.setTimeout(() => focusComment(focusId), 400);
      }
    }, 320);
  }
</script>

<style is:global>
  .comments-section {
    width: calc(100% + (2 * var(--page-pad, 20px)));
    max-width: none;
    margin: 2.5rem 0 0 calc(-1 * var(--page-pad, 20px));
    padding: 0 0 40px 0;
    box-sizing: border-box;
  }

  .comments-toggle {
    display: inline-flex;
    align-items: center;
    background: #01002d;
    color: #ffffff;
    border: none;
    border-radius: 0 999px 999px 0;
    padding: 12px 22px 12px 16px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    cursor: pointer;
    text-shadow: 1px 1px 0 #ff7900;
    box-shadow: 2px 0 0 rgba(255, 121, 0, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .comments-toggle:hover {
    transform: translateX(2px);
    box-shadow: 4px 0 10px rgba(0, 0, 0, 0.28);
  }

  .comments-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1090;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .comments-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .comments-drawer {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: min(980px, 94vw);
    z-index: 1100;
    background: #01002d;
    border-right: 1px solid #1f2937;
    box-shadow: 18px 0 40px rgba(0, 0, 0, 0.5);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow: auto;
    box-sizing: border-box;
    padding: 32px;
    color: #ffffff;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }
  .comments-drawer.is-open {
    transform: translateX(0);
  }

  .comments-drawer-inner {
    padding: 0;
    box-sizing: border-box;
  }

  .comments-drawer-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px) 38px;
    grid-template-rows: auto auto;
    gap: 18px 16px;
    align-items: start;
    margin-bottom: 28px;
  }

  .comments-drawer-title {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    text-align: left;
    font-family: 'Libre Baskerville', Baskerville, Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    transform: translateX(10px) translateY(5px);
  }

  .comments-drawer-close {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin: 0;
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    border-radius: 50%;
  }
  .comments-drawer-close:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .comments-drawer-close svg {
    width: 18px;
    height: 18px;
  }

  .comments-filters {
    grid-column: 1;
    grid-row: 2;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    padding: 2px 3px;
    background: #1a1a4a;
    border-radius: 999px;
    width: fit-content;
    transform: translateX(5px);
  }
  .comments-filter {
    background: transparent;
    border: none;
    color: #ffffff;
    font: inherit;
    font-size: 0.85rem;
