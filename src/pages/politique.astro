---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import { getCollection } from 'astro:content';

const tousLesArticles = await getCollection('articles');
const articlesPolitique = tousLesArticles
    .filter(art => art.data.category?.toLowerCase() === 'politique' && art.data.isVisible !== false)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<CategoryLayout 
  categoryTitle="Politique" 
  categorySlug="politique" 
  articles={articlesPolitique} 
/>