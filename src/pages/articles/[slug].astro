---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/Layout.astro';
import { Tweet } from 'astro-embed';
import { t, categoryLabel } from '../../utils/i18n.js';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  
  // On ne garde QUE les articles visibles pour générer des pages
  const visibleArticles = articles.filter(article => article.data.isVisible !== false);

  return visibleArticles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const AUTHORS_DATA: Record<string, { avatarUrl: string }> = {
  "Victor Zhâ": { avatarUrl: "/assets/uploads/avatar-victor.jpg" },
  "Paul Delachaux": { avatarUrl: "/assets/uploads/avatar-paul.jpg" }
};

const markdownToHtml = (md: string) => {
  const escaped = String(md || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped
    .split(/\n\n+/)
    .map((block) => {
      const withInline = block
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br/>');
      return `<p>${withInline}</p>`;
    })
    .join('');
};

const { article } = Astro.props;
// 🔒 Sécurité : Si l'article est masqué, on redirige vers la page 404 (ou l'accueil)
if (article.data.isVisible === false) {
  return Astro.redirect('/404'); // ou Astro.redirect('/') selon ta préférence
}
const { Content } = await render(article);

const isBreve = article.data.layout_type === 'breve';

const hasEn = Boolean(article.data.title_en && String(article.data.title_en).trim() !== "");
const bodyEnHtml = article.data.body_en ? markdownToHtml(String(article.data.body_en)) : "";

const tousLesArticles = await getCollection('articles');
const checkHasEnArt = (art: any) =>
  Boolean(art?.data?.title_en && String(art.data.title_en).trim() !== "");

const similaires = tousLesArticles
  .filter(art =>
    art.data.isVisible !== false &&
    art.data.category.toLowerCase() === article.data.category.toLowerCase() &&
    art.id !== article.id
  )
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const autresRecents = tousLesArticles
  .filter(art =>
    art.data.isVisible !== false &&
    art.id !== article.id &&
    !similaires.find(s => s.id === art.id)
  )
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const articlesSimilairesFR = [...similaires, ...autresRecents].slice(0, 3);

const poolEN = [
  ...similaires.filter(checkHasEnArt),
  ...autresRecents.filter(checkHasEnArt),
];

const usedEnIds = new Set<string>();
const sidebarSlots = articlesSimilairesFR.map((artFR) => {
  if (checkHasEnArt(artFR) && !usedEnIds.has(artFR.id)) {
    usedEnIds.add(artFR.id);
    return { artFR, artEN: artFR, hasEn: true };
  }
  const fill = poolEN.find((a) => !usedEnIds.has(a.id));
  if (fill) {
    usedEnIds.add(fill.id);
    return { artFR, artEN: fill, hasEn: true };
  }
  return { artFR, artEN: null, hasEn: false };
});

const currentAuthorName = article.data.author || "Auteur Anonyme";
const authorInfo = AUTHORS_DATA[currentAuthorName] || { avatarUrl: "/assets/uploads/avatar-default.jpg"};
const articleHeroImage = article.data.article_image || article.data.image;

// --------------------------------------------------------------------------
// Extractions multilingues des Légendes d'Images (avec Fallbacks)
// --------------------------------------------------------------------------
const imageInfoData = article.data.image_info?.[0];

const imageCaptionFR = 
  imageInfoData?.image_caption || 
  article.data.article_image_caption || 
  article.data.image_caption || 
  "";

const imageCaptionEN =
  imageInfoData?.image_caption_en ||
  article.data.article_image_caption_en ||
  article.data.image_caption_en ||
  imageCaptionFR;

// Extrait du tableau author_info (avec fallback rétrocompatible)
const authorData = article.data.author_info?.[0];

const authorAboutFR = authorData?.author_about || article.data.author_about || t('author_about_empty', 'FR');
const authorAboutEN = authorData?.author_about_en || article.data.author_about_en || authorData?.author_about || article.data.author_about || t('author_about_empty', 'EN');

const authorInterestsFR = authorData?.author_interests || article.data.author_interests || "";
const authorInterestsEN = authorData?.author_interests_en || article.data.author_interests_en || authorInterestsFR;

// 0 = image au-dessus de tout le texte, N = après le N-ème paragraphe
const imagePos = article.data.image_position ?? 0;
// Idem pour le tweet intégré (articles classiques uniquement)
const tweetPos = article.data.tweet_position ?? 0;

const categoryFR = categoryLabel(article.data.category, 'FR');
const categoryEN = article.data.category_en || categoryLabel(article.data.category, 'EN');

const rawDate = article.data.date;
const dateObj = rawDate instanceof Date ? rawDate : new Date(rawDate);
const dateOptions: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit' };
const dateAfficheeFR = dateObj.toLocaleDateString('fr-FR', dateOptions);
const heureAfficheeFR = dateObj.toLocaleTimeString('fr-FR', timeOptions);
const dateAfficheeEN = dateObj.toLocaleDateString('en-US', dateOptions);
const heureAfficheeEN = dateObj.toLocaleTimeString('en-US', timeOptions);

const readingTime = article.data.reading_time || (isBreve ? 2 : 5);
const titleFR = article.data.title;
const titleEN = hasEn ? String(article.data.title_en) : titleFR;
const descFR = article.data.description || "";
const descEN = hasEn && article.data.description_en
  ? String(article.data.description_en)
  : descFR;
---

<MainLayout title={article.data.title}>
  {isBreve ? (
    /* ========================================================================
       LAYOUT 1 : BRÈVES
       ======================================================================== */
    <div class="breve-wrapper">
      <article class="breve-layout-container">
        
        <!-- Header : Catégorie en haut à gauche, Titre (gauche) & Description (droite) -->
        <header class="breve-header">
          <div class="breve-theme" data-fr={categoryFR} data-en={categoryEN}>
            {categoryFR}
          </div>

          <div class="breve-header-main">
            <h1 class="breve-title" data-fr={titleFR} data-en={titleEN}>
              {titleFR}
            </h1>

            {descFR && (
              <div class="breve-description" data-fr={descFR} data-en={descEN}>
                {descFR}
              </div>
            )}
          </div>
        </header>

        <!-- Trait horizontal -->
        <hr class="breve-divider" />

        <!-- Section principale : Contenu + Image dynamique / Auteur à droite -->
        <div class="breve-body-grid">
          
          <main class="breve-main-content">
            <div class="prose-content breve-prose" data-lang-content="FR" data-image-position={imagePos}>
              <Content />
            </div>

            {bodyEnHtml ? (
              <div class="prose-content breve-prose" data-lang-content="EN" data-image-position={imagePos} hidden set:html={bodyEnHtml} />
            ) : (
              <div class="prose-content breve-prose" data-lang-content="EN" data-image-position={imagePos} hidden>
                <p data-i18n="no_english_version">{t('no_english_version', 'FR')}</p>
              </div>
            )}

            {article.data.tweet_url && (
              <div class="tweet-embed-wrapper">
                <Tweet id={article.data.tweet_url} theme="dark" />
              </div>
            )}
          </main>

          <!-- Bloc Auteur Fléché sur la droite -->
          <aside class="breve-sidebar">
            <div class="breve-author-block">
              <div class="breve-avatar-wrapper">
                <img src={authorInfo.avatarUrl} alt={currentAuthorName} class="breve-avatar" />
                <div class="breve-avatar-pointer"></div>
              </div>
              
              <div class="breve-author-bio">
                <p class="breve-author-name">{currentAuthorName}</p>
                <p data-fr={authorAboutFR} data-en={authorAboutEN}>{authorAboutFR}</p>
                
                {(authorInterestsFR || authorInterestsEN) && (
                  <p class="breve-author-interests" data-fr={authorInterestsFR} data-en={authorInterestsEN}>
                    {authorInterestsFR}
                  </p>
                )}
              </div>
            </div>
          </aside>

        </div>

        <!-- Trait horizontal bas de page -->
        <hr class="breve-divider" />

        <!-- Sources cliquables en puces -->
        {article.data.consulted_sources && article.data.consulted_sources.length > 0 && (
          <footer class="breve-sources-section">
            <h3 class="breve-sources-title" data-i18n="transparency_sources">Sources :</h3>
            <ul class="breve-sources-list">
              {article.data.consulted_sources.map((src: any) => {
                const titleFR = src.source_title;
                const titleEN = src.source_title_en || titleFR;

                return (
                  <li class="breve-source-item">
                    {src.source_url ? (
                      <a 
                        href={src.source_url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="breve-source-link"
                        data-fr={titleFR}
                        data-en={titleEN}
                      >
                        {titleFR}
                      </a>
                    ) : (
                      <span 
                        class="breve-source-text"
                        data-fr={titleFR}
                        data-en={titleEN}
                      >
                        {titleFR}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </footer>
        )}

        <!-- Template HTML caché pour l'image -->
        {articleHeroImage && (
          <template id="breve-hero-template">
            <figure class="breve-figure">
              <img src={articleHeroImage} alt={article.data.title} class="breve-image" />
              {(imageCaptionFR || imageCaptionEN) && (
                <figcaption class="breve-caption" data-fr={imageCaptionFR} data-en={imageCaptionEN}>
                  {imageCaptionFR}
                </figcaption>
              )}
            </figure>
          </template>
        )}

      </article>
    </div>
  ) : (
    /* ========================================================================
       LAYOUT 2 : ARTICLE CLASSIQUE
       ======================================================================== */
    <div class="article-wrapper">
      <div class="article-container">

        <header class="article-header">
          <h1 class="main-title" data-fr={titleFR} data-en={titleEN}>{titleFR}</h1>
          {descFR && <p class="main-description" data-fr={descFR} data-en={descEN}>{descFR}</p>}

          <a href="#author-info-section" class="author-meta-block">
            <img src={authorInfo.avatarUrl} alt={`Portrait de ${currentAuthorName}`} class="author-avatar" />
            <div class="author-text-meta">
              <p class="author-name">
                <span data-i18n="by_author">{t('by_author', 'FR')}</span>{" "}{currentAuthorName}
              </p>
              <p class="publication-date">
                {readingTime}{" "}
                <span data-i18n="read_time">{t('read_time', 'FR')}</span>
                {" — "}
                <span data-i18n="published_on">{t('published_on', 'FR')}</span>{" "}
                <span data-fr={dateAfficheeFR} data-en={dateAfficheeEN}>{dateAfficheeFR}</span>{" "}
                <span data-i18n="published_at">{t('published_at', 'FR')}</span>{" "}
                <span data-fr={heureAfficheeFR} data-en={heureAfficheeEN}>{heureAfficheeFR}</span>
              </p>
            </div>
          </a>
        </header>

        <div class="article-grid">

          <main class="article-main-content">
            {article.data.tweet_url && (
              <div class="tweet-embed-wrapper" id="tweet-embed-mount" data-tweet-position={tweetPos}>
                <Tweet id={article.data.tweet_url} theme="dark" />
              </div>
            )}

            <div class="prose-content" data-lang-content="FR" data-image-position={imagePos}>
              <Content />
            </div>

            {bodyEnHtml ? (
              <div class="prose-content" data-lang-content="EN" data-image-position={imagePos} hidden set:html={bodyEnHtml} />
            ) : (
              <div class="prose-content" data-lang-content="EN" data-image-position={imagePos} hidden>
                <p data-i18n="no_english_version">{t('no_english_version', 'FR')}</p>
              </div>
            )}
          </main>

          <aside class="article-sidebar">
            <div class="sidebar-sticky-box">
              {sidebarSlots.length > 0 && (
                <>
                  <!-- Le titre est maintenant EN DEHORS de la div scrollable -->
                  <p class="sidebar-label" data-i18n="sidebar_read_also">{t('sidebar_read_also', 'FR')}</p>
                  
                  <div class="sidebar-similaires">
                    {sidebarSlots.map(({ artFR, artEN, hasEn: slotHasEn }) => {
                      const imgFR = artFR.data.image || artFR.data.article_image || "";
                      const imgEN = slotHasEn && artEN
                        ? (artEN.data.image || artEN.data.article_image || "")
                        : "";
                      const imgShow = imgFR || imgEN;
                      return (
                        <a
                          href={`/articles/${artFR.id}`}
                          class="sidebar-card article-card-item"
                          data-has-en={slotHasEn ? "true" : "false"}
                          data-href-fr={`/articles/${artFR.id}`}
                          data-href-en={slotHasEn && artEN ? `/articles/${artEN.id}` : ""}
                        >
                          {imgShow && (
                            <img
                              src={imgFR || imgEN}
                              alt={artFR.data.title}
                              class="sidebar-card-img"
                              data-img-fr={imgFR || imgEN}
                              data-img-en={imgEN || imgFR}
                            />
                          )}
                          <div class="sidebar-card-body">
                            <p
                              class="sidebar-card-tag"
                              data-fr={categoryLabel(artFR.data.category, 'FR')}
                              data-en={slotHasEn && artEN ? categoryLabel(artEN.data.category, 'EN') : ""}
                            >
                              {categoryLabel(artFR.data.category, 'FR')}
                            </p>
                            <p
                              class="sidebar-card-title"
                              data-fr={artFR.data.title}
                              data-en={slotHasEn && artEN ? String(artEN.data.title_en) : ""}
                            >
                              {artFR.data.title}
                            </p>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </>
              )}
            </div>
          </aside>

        </div>

        <footer id="author-info-section" class="article-footer-transparency">
          <div class="transparency-card">
            <div class="card-accent-bar"></div>
            <h3 data-i18n="transparency_author">{t('transparency_author', 'FR')}</h3>
            <p data-fr={authorAboutFR} data-en={authorAboutEN}>{authorAboutFR}</p>
          </div>

          <div class="transparency-card">
            <div class="card-accent-bar"></div>
            <h3 data-i18n="transparency_interests">{t('transparency_interests', 'FR')}</h3>
            {authorInterestsFR || authorInterestsEN ? (
              <p data-fr={authorInterestsFR} data-en={authorInterestsEN}>{authorInterestsFR}</p>
            ) : (
              <p data-i18n="author_interests_empty">{t('author_interests_empty', 'FR')}</p>
            )}
          </div>

          <div class="transparency-card">
            <div class="card-accent-bar"></div>
            <h3 data-i18n="transparency_sources">{t('transparency_sources', 'FR')}</h3>
            {article.data.consulted_sources && article.data.consulted_sources.length > 0 ? (
              <ul class="sources-list">
                {article.data.consulted_sources.map((src: any) => {
                  const titleFR = src.source_title;
                  const titleEN = src.source_title_en || titleFR;

                  return (
                    <li>
                      {src.source_url ? (
                        <a 
                          href={src.source_url} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          data-fr={titleFR}
                          data-en={titleEN}
                        >
                          {titleFR}
                        </a>
                      ) : (
                        <span 
                          data-fr={titleFR}
                          data-en={titleEN}
                        >
                          {titleFR}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p data-i18n="transparency_no_sources">{t('transparency_no_sources', 'FR')}</p>
            )}
          </div>
        </footer>

        <!-- Ancre : point d'insertion du bloc "à lire aussi" en version mobile (voir script) -->
        <div id="read-also-anchor"></div>

        <!-- Template HTML caché pour l'image (positionnée dans le texte via script) -->
        {articleHeroImage && (
          <template id="article-hero-template">
            <figure class="hero-image-wrapper">
              <img src={articleHeroImage} alt={`Illustration : ${article.data.title}`} class="hero-img" />
              {(imageCaptionFR || imageCaptionEN) && (
                <figcaption class="image-caption" data-fr={imageCaptionFR} data-en={imageCaptionEN}>
                  {imageCaptionFR}
                </figcaption>
              )}
            </figure>
          </template>
        )}

      </div>
    </div>
  )}
</MainLayout>

<!-- Script JS : injection de l'image positionnée dans le texte + sync langue (site_lang, comme le Layout) -->
<script is:inline>
  function setupArticlePage() {
    // Un seul des deux templates existe selon le layout (brève ou classique)
    const heroTemplate = document.getElementById('breve-hero-template') || document.getElementById('article-hero-template');

    function getSiteLang() {
      return (localStorage.getItem('site_lang') || 'FR').toUpperCase();
    }

    function applyDataLangAttributes(lang) {
      document.querySelectorAll('[data-fr][data-en]').forEach(el => {
        const valFr = el.getAttribute('data-fr');
        const valEn = el.getAttribute('data-en');
        if (lang === 'EN' && valEn) el.textContent = valEn;
        else if (valFr) el.textContent = valFr;
      });
    }

    // Place un élément dans un conteneur de texte : 0 = au-dessus de tout, N = après le N-ème paragraphe
    function insertAtParagraphPosition(container, element, targetPos) {
      const paragraphs = Array.from(container.querySelectorAll(':scope > p')).filter(
        p => p.textContent.trim().length > 0
      );

      if (paragraphs.length === 0) {
        // Pas de paragraphe détecté (ex : message "non disponible en anglais") : on colle l'élément en bas
        container.appendChild(element);
      } else if (targetPos <= 0) {
        container.insertBefore(element, paragraphs[0]);
      } else {
        const targetIndex = Math.min(targetPos, paragraphs.length) - 1;
        paragraphs[targetIndex].insertAdjacentElement('afterend', element);
      }
    }

    // Insère l'image dans le texte selon data-image-position
    function injectHeroImages() {
      if (!heroTemplate) return;
      const proseContainers = document.querySelectorAll('.prose-content[data-image-position]');

      proseContainers.forEach(container => {
        if (container.querySelector('.injected-hero-figure')) return;

        const posRaw = container.getAttribute('data-image-position');
        const parsedPos = parseInt(posRaw, 10);
        const targetPos = isNaN(parsedPos) ? 0 : parsedPos;

        const clone = heroTemplate.content.cloneNode(true);
        const figureElement = clone.querySelector('figure');
        if (!figureElement) return;
        figureElement.classList.add('injected-hero-figure');

        insertAtParagraphPosition(container, figureElement, targetPos);
      });
    }

    // Déplace le bloc tweet (articles classiques) dans le texte actuellement visible, selon data-tweet-position
    function positionTweetEmbed() {
      const tweetBlock = document.getElementById('tweet-embed-mount');
      if (!tweetBlock) return;

      const visibleProse = document.querySelector('.prose-content[data-lang-content]:not([hidden])');
      if (!visibleProse) return;

      const posRaw = tweetBlock.getAttribute('data-tweet-position');
      const parsedPos = parseInt(posRaw, 10);
      const targetPos = isNaN(parsedPos) ? 0 : parsedPos;

      insertAtParagraphPosition(visibleProse, tweetBlock, targetPos);
    }

    function updateLanguageUI(lang) {
      const currentLang = (lang || getSiteLang()).toUpperCase();

      document.querySelectorAll('.prose-content[data-lang-content]').forEach(el => {
        const isTargetLang = el.getAttribute('data-lang-content') === currentLang;
        if (isTargetLang) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });

      injectHeroImages();
      positionTweetEmbed();
      // Après injection : appliquer FR/EN sur la légende fraîchement insérée (et le reste de la page)
      applyDataLangAttributes(currentLang);
    }

    updateLanguageUI(getSiteLang());

    window.addEventListener('languageChanged', (e) => {
      const newLang = (e.detail && e.detail.lang) || e.detail || getSiteLang();
      updateLanguageUI(newLang);
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'site_lang') updateLanguageUI(e.newValue);
    });

    // Sur mobile : le bloc "à lire aussi" quitte la colonne latérale pour
    // devenir le tout dernier bloc de la page, juste avant le footer.
    // Sur desktop : il retrouve sa place dans la sidebar sticky.
    const readAlsoAside = document.querySelector('.article-sidebar');
    const readAlsoGrid = document.querySelector('.article-grid');
    const readAlsoAnchor = document.getElementById('read-also-anchor');

    if (readAlsoAside && readAlsoGrid && readAlsoAnchor) {
      const mobileQuery = window.matchMedia('(max-width: 968px)');

      const positionReadAlso = () => {
        if (mobileQuery.matches) {
          if (readAlsoAnchor.nextElementSibling !== readAlsoAside) {
            readAlsoAnchor.insertAdjacentElement('afterend', readAlsoAside);
          }
        } else if (readAlsoAside.parentElement !== readAlsoGrid) {
          readAlsoGrid.appendChild(readAlsoAside);
        }
      };

      positionReadAlso();
      if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', positionReadAlso);
      else if (mobileQuery.addListener) mobileQuery.addListener(positionReadAlso);
    }
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', setupArticlePage);
  } else {
    setupArticlePage();
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  /* ==========================================
     1. STYLES POUR LES BRÈVES
     ========================================== */
  .breve-wrapper { background-color: #02001d; max-width: 1200px; margin: 40px auto; border-radius: 8px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }

  .breve-layout-container { padding: 50px 40px; color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }

  .breve-header { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; width: 100%; border-bottom: none; }

  .breve-theme { color: #ea580c; font-weight: 800; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; text-align: left; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; margin-left: 25px; }

  .breve-header-main { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; width: 100%; }

  .breve-title { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 2.2rem; font-weight: 800; line-height: 1.15; color: #ffffff; margin: 0; letter-spacing: -0.02em; text-align: left; flex: 1; margin-left: 25px; }

  .breve-description { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 0.9rem; line-height: 1.5; color: #e5e7eb; font-weight: 400; text-align: left; margin: 0; width: 500px; flex-shrink: 0; }

  .breve-divider { border: none; border-top: 1px solid #1f2937; height: 0; margin: 25px 0 35px 0; }

  .breve-body-grid { display: grid; grid-template-columns: 7fr 3fr; gap: 50px; align-items: start; }

  .breve-main-content { display: flex; flex-direction: column; gap: 20px; }

  .breve-figure { margin: 25px 0; width: 100%; }

  .breve-image { width: 100%; height: auto; display: block; object-fit: cover; border-radius: 4px; }

  .breve-caption { margin-top: 8px; font-size: 0.8rem; color: #9ca3af; font-style: italic; line-height: 1.3; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }

  .breve-sidebar { position: sticky; top: 30px; }

  .breve-author-block { display: flex; flex-direction: column; align-items: center; text-align: left; }

