---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/Layout.astro';
import { Tweet } from 'astro-embed';
import { categoryLabel, t } from '../../utils/i18n.js';
import CommentsSection from '../../components/CommentsSection.astro';
import DefinitionTooltips from '../../components/DefinitionTooltips.astro';
import FavoriteStar from '../../components/FavoriteStar.astro';
import ReadLaterClock from '../../components/ReadLaterClock.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import BriefRecommendationCard from '../../components/BriefRecommendationCard.astro';
import RevueMusicaleLayout from '../../components/RevueMusicaleLayout.astro';
import AuthorProfileHover from '../../components/AuthorProfileHover.astro';
import { supabase } from '../../utils/supabase';
import { normalizeMediaBlocks } from '../../utils/body-blocks';
import { articleAuthorNames, authorAvatarUrl, getAuthorProfile, normalizeAuthorName } from '../../utils/authors';
import { loadAuthorProfilesOrBundled } from '../../utils/author-profiles-store';

// 1. Force le rendu dynamique (SSR) quand l'adaptateur le permet.
//    getStaticPaths reste obligatoire si Astro tourne en mode statique.
export const prerender = false;

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
  }));
}

// 2. Récupération du slug depuis l'URL
const { slug } = Astro.params;

// 3. Recherche de l'article correspondant dans la collection
const articles = await getCollection('articles');
const article = articles.find((a) => a.id === slug);

// 4. Si l'article n'existe pas ou qu'il est masqué, redirection vers la page 404
if (!article || article.data.isVisible === false) {
  return Astro.redirect('/404');
}

const markdownToHtml = (md: string) => {
  const escaped = String(md || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return escaped
    .split(/\n\n+/)
    .map((block) => {
      const withInline = block
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br/>');
      return `<p>${withInline}</p>`;
    })
    .join('');
};

const { Content } = await render(article);

const isBreve = article.data.layout_type === 'breve';
const isRevue = article.data.layout_type === 'revue_musicale';

const hasEn = Boolean(article.data.title_en && String(article.data.title_en).trim() !== "");
const bodyEnHtml = article.data.body_en ? markdownToHtml(String(article.data.body_en)) : "";

const checkHasEnArt = (art: any) =>
  Boolean(art?.data?.title_en && String(art.data.title_en).trim() !== "");

const similaires = articles
  .filter(art =>
    art.data.isVisible !== false &&
    art.data.category.toLowerCase() === article.data.category.toLowerCase() &&
    art.id !== article.id
  )
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const autresRecents = articles
  .filter(art =>
    art.data.isVisible !== false &&
    art.id !== article.id &&
    !similaires.find(s => s.id === art.id)
  )
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const articlesSimilairesFR = [...similaires, ...autresRecents].slice(0, 3);

const poolEN = [
  ...similaires.filter(checkHasEnArt),
  ...autresRecents.filter(checkHasEnArt),
];

const usedEnIds = new Set<string>();
const sidebarSlots = articlesSimilairesFR.map((artFR) => {
  if (checkHasEnArt(artFR) && !usedEnIds.has(artFR.id)) {
    usedEnIds.add(artFR.id);
    return { artFR, artEN: artFR, hasEn: true };
  }
  const fill = poolEN.find((a) => !usedEnIds.has(a.id));
  if (fill) {
    usedEnIds.add(fill.id);
    return { artFR, artEN: fill, hasEn: true };
  }
  return { artFR, artEN: null, hasEn: false };
});

const recentVisibleArticles = articles
  .filter((candidate) =>
    candidate.id !== article.id &&
    candidate.data.isVisible !== false
  )
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const briefRecommendationsByDate = recentVisibleArticles.slice(0, 15);
const briefAuthorNames = articleAuthorNames(article);
const briefRecommendationsByAuthor = recentVisibleArticles
  .filter((candidate) =>
    articleAuthorNames(candidate).some((candidateName) =>
      briefAuthorNames.some((authorName) =>
        normalizeAuthorName(candidateName) === normalizeAuthorName(authorName)
      )
    )
  )
  .slice(0, 15);
const briefRecommendationsByCategory = Array.from(
  briefRecommendationsByDate.reduce((groups, candidate) => {
    const category = String(candidate.data.category || '').trim() || 'autres';
    const group = groups.get(category) || [];
    group.push(candidate);
    groups.set(category, group);
    return groups;
  }, new Map<string, typeof briefRecommendationsByDate>())
    .entries()
).sort(([a], [b]) => categoryLabel(a, 'FR').localeCompare(categoryLabel(b, 'FR'), 'fr'));

const mediaBlocks = isRevue ? [] : normalizeMediaBlocks(article.data);
const tweetBlocks = mediaBlocks.filter((block) => block.type === 'tweet' && block.url);

const selectedAuthors = [article.data.author, article.data.author2]
  .map((name, index) => ({ name, index }))
  .filter((author, index, authors): author is { name: string; index: number } =>
    Boolean(author.name?.trim()) &&
    authors.findIndex((candidate) => candidate.name === author.name) === index
  );
if (selectedAuthors.length === 0) selectedAuthors.push({ name: 'Auteur Anonyme', index: 0 });
const authorProfilesData = await loadAuthorProfilesOrBundled();

const articleAuthorText = (values: unknown[], placeholders: string[] = []) => {
  const ignored = new Set(placeholders.map((value) => value.trim().toLocaleLowerCase()));
  return values
    .map((value) => String(value || '').trim())
    .find((value) => value && !ignored.has(value.toLocaleLowerCase())) || '';
};

const defaultAboutValues = [
  t('author_about_empty', 'FR'),
  t('author_about_empty', 'EN'),
  'No information provided at this time.',
];

const authorProfiles = selectedAuthors.map(({ name, index }) => {
  const authorData = article.data.author_info?.[index];
  const profile = getAuthorProfile(name, authorProfilesData);
  const legacyAbout = index === 0 ? article.data.author_about : undefined;
  const legacyAboutEN = index === 0 ? article.data.author_about_en : undefined;
  const aboutFR = articleAuthorText(
    [authorData?.author_about, legacyAbout],
    defaultAboutValues,
  ) || profile.about?.trim() || t('author_about_empty', 'FR');
  const aboutEN = articleAuthorText(
    [authorData?.author_about_en, legacyAboutEN],
    defaultAboutValues,
  ) || profile.about_en?.trim() || aboutFR;
  const interestsFR = articleAuthorText([
    authorData?.author_interests,
    index === 0 ? article.data.author_interests : '',
  ]) || profile.interests?.trim() || '';
  const interestsEN = articleAuthorText([
    authorData?.author_interests_en,
    index === 0 ? article.data.author_interests_en : '',
  ]) || profile.interests_en?.trim() || interestsFR;
  const partnersFR = articleAuthorText([
    authorData?.author_partners,
    index === 0 ? article.data.author_partners : '',
  ]) || profile.partners?.trim() || '';
  const partnersEN = articleAuthorText([
    authorData?.author_partners_en,
    index === 0 ? article.data.author_partners_en : '',
  ]) || profile.partners_en?.trim() || partnersFR;
  const authorArticles = articles
    .filter((candidate) =>
      candidate.id !== article.id &&
      candidate.data.isVisible !== false &&
      articleAuthorNames(candidate).some((candidateName) =>
        normalizeAuthorName(candidateName) === normalizeAuthorName(name)
      )
    )
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  const latestArticleFR = authorArticles[0];
  const latestArticleEN = authorArticles.find((candidate) =>
    Boolean(candidate.data.title_en?.trim())
  );
  const latestArticleENTitle = latestArticleEN?.data.title_en?.trim() || '';

  return {
    name,
    avatarUrl: authorAvatarUrl(name, authorProfilesData),
    aboutFR,
    aboutEN,
    interestsFR,
    interestsEN,
    partnersFR,
    partnersEN,
    latestArticleFR: latestArticleFR
      ? {
          href: `/articles/${latestArticleFR.id}`,
          titleFR: latestArticleFR.data.title,
          titleEN: latestArticleFR.data.title_en?.trim() || latestArticleFR.data.title,
        }
      : null,
    latestArticleEN: latestArticleEN
      ? {
          href: `/articles/${latestArticleEN.id}`,
          titleFR: latestArticleEN.data.title,
          titleEN: latestArticleENTitle,
        }
      : null,
  };
});

const mediaBlocksJson = JSON.stringify(mediaBlocks).replace(/</g, '\\u003c');

const rawDate = article.data.date;
const dateObj = rawDate instanceof Date ? rawDate : new Date(rawDate);
const dateOptions: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit' };
const dateAfficheeFR = dateObj.toLocaleDateString('fr-FR', dateOptions);
const heureAfficheeFR = dateObj.toLocaleTimeString('fr-FR', timeOptions);
const dateAfficheeEN = dateObj.toLocaleDateString('en-US', dateOptions);
const heureAfficheeEN = dateObj.toLocaleTimeString('en-US', timeOptions);

const readingTime = article.data.reading_time || (isBreve ? 2 : 5);
const titleFR = article.data.title;
const titleEN = hasEn ? String(article.data.title_en) : titleFR;
const descFR = article.data.description || "";
const descEN = hasEn && article.data.description_en
  ? String(article.data.description_en)
  : descFR;
---

<MainLayout title={article.data.title}>
  {isRevue ? (
    <RevueMusicaleLayout
      slug={article.id}
      titleFR={titleFR}
      titleEN={titleEN}
      descFR={descFR}
      descEN={descEN}
      authors={authorProfiles}
      readingTime={readingTime}
      dateAfficheeFR={dateAfficheeFR}
      dateAfficheeEN={dateAfficheeEN}
      heureAfficheeFR={heureAfficheeFR}
      heureAfficheeEN={heureAfficheeEN}
      sources={article.data.consulted_sources || []}
      rows={article.data.revue_rows || []}
    />
  ) : isBreve ? (
    <div class="breve-wrapper">
      <FavoriteStar slug={article.id} />
      <ReadLaterClock slug={article.id} title={titleFR} titleEn={titleEN} />
      <article class="breve-layout-container">
        <header class="breve-header">
          <div class="breve-theme">
            <CategoryBadge slug={article.data.category} />
          </div>

          <div class="breve-header-main">
            <h1 class="breve-title" data-fr={titleFR} data-en={titleEN}>
              {titleFR}
            </h1>

            {descFR && (
              <div class="breve-description" data-fr={descFR} data-en={descEN}>
                {descFR}
              </div>
            )}
          </div>
        </header>

        <hr class="breve-divider" />

        <div class="breve-body-grid">
          <main class="breve-main-content">
            <div class="prose-content breve-prose" data-lang-content="FR">
              <Content />
            </div>

            {bodyEnHtml ? (
              <div class="prose-content breve-prose" data-lang-content="EN" hidden set:html={bodyEnHtml} />
            ) : (
              <div class="prose-content breve-prose" data-lang-content="EN" hidden>
                <p data-i18n="no_english_version">{t('no_english_version', 'FR')}</p>
              </div>
            )}
          </main>

          <aside class="breve-sidebar">
            <div class="breve-author-block">
              <div class="breve-author-header">
                <div class="breve-avatar-group">
                  {authorProfiles.map((author) => (
                    <img src={author.avatarUrl} alt={author.name} class="breve-avatar" />
                  ))}
                </div>
                <div class="breve-author-header-text">
                  <p class="breve-author-name">
                    {authorProfiles.map((author, index) => (
                      <>
                        {index > 0 && <>{" "}<span data-i18n="author_separator">et</span>{" "}</>}
                        <AuthorProfileHover {...author} />
                      </>
                    ))}
                  </p>
                </div>
              </div>
            </div>
            <section class="breve-related" data-brief-related>
              <header class="breve-related-header">
                <h2 id="brief-related-title" data-fr={t('brief_recommendations_title', 'FR')} data-en={t('brief_recommendations_title', 'EN')}>
                  {t('brief_recommendations_title', 'FR')}
                </h2>
                <button
                  type="button"
                  class="breve-related-toggle"
                  data-brief-related-toggle
                  aria-expanded="true"
                  aria-controls="brief-related-content"
                  data-fr="Réduire"
                  data-en="Minimize"
                >Réduire</button>
              </header>
              <div class="breve-related-content" id="brief-related-content" data-brief-related-content>
                <div class="breve-related-modes" role="group" aria-labelledby="brief-related-title">
                  <button type="button" class="is-active" data-brief-related-mode="author" aria-pressed="true" data-fr={t('brief_recommendations_author', 'FR')} data-en={t('brief_recommendations_author', 'EN')}>
                    Du même auteur
                  </button>
                  <button type="button" data-brief-related-mode="date" aria-pressed="false" data-fr={t('brief_recommendations_all', 'FR')} data-en={t('brief_recommendations_all', 'EN')}>
                    Tous les articles
                  </button>
                  <button type="button" data-brief-related-mode="category" aria-pressed="false" data-fr={t('brief_recommendations_category', 'FR')} data-en={t('brief_recommendations_category', 'EN')}>
                    Par catégorie
                  </button>
                </div>

                <div class="breve-related-view" data-brief-related-view="author">
                  {briefRecommendationsByAuthor.length ? (
                    briefRecommendationsByAuthor.map((recommendation) => <BriefRecommendationCard article={recommendation} />)
                  ) : (
                    <p class="breve-related-empty" data-fr={t('brief_recommendations_empty_author', 'FR')} data-en={t('brief_recommendations_empty_author', 'EN')}>
                      {t('brief_recommendations_empty_author', 'FR')}
                    </p>
                  )}
                </div>

                <div class="breve-related-view" data-brief-related-view="date" hidden>
                  {briefRecommendationsByDate.length ? briefRecommendationsByDate.map((recommendation) => (
                    <BriefRecommendationCard article={recommendation} />
                  )) : (
                    <p class="breve-related-empty" data-fr={t('brief_recommendations_empty_all', 'FR')} data-en={t('brief_recommendations_empty_all', 'EN')}>
                      {t('brief_recommendations_empty_all', 'FR')}
                    </p>
                  )}
                </div>

                <div class="breve-related-view" data-brief-related-view="category" hidden>
                  {briefRecommendationsByCategory.map(([category, recommendations]) => (
                    <details class="breve-related-category">
                      <summary data-fr={categoryLabel(category, 'FR')} data-en={categoryLabel(category, 'EN')}>
                        {categoryLabel(category, 'FR')}
                      </summary>
                      {recommendations.map((recommendation) => <BriefRecommendationCard article={recommendation} />)}
                    </details>
                  ))}
                  {!briefRecommendationsByCategory.length && (
                    <p class="breve-related-empty" data-fr={t('brief_recommendations_empty_all', 'FR')} data-en={t('brief_recommendations_empty_all', 'EN')}>
                      {t('brief_recommendations_empty_all', 'FR')}
                    </p>
                  )}
                </div>
              </div>
            </section>
          </aside>
        </div>

        <hr class="breve-divider" />

        {article.data.consulted_sources && article.data.consulted_sources.length > 0 && (
          <footer class="breve-sources-section">
            <h3 class="breve-sources-title" data-i18n="transparency_sources">Sources :</h3>
            <ul class="breve-sources-list">
              {article.data.consulted_sources.map((src: any) => {
                const titleFR = src.source_title;
                const titleEN = src.source_title_en || titleFR;

                return (
                  <li class="breve-source-item">
                    {src.source_url ? (
                      <a 
                        href={src.source_url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="breve-source-link"
                        data-fr={titleFR}
                        data-en={titleEN}
                      >
                        {titleFR}
                      </a>
                    ) : (
                      <span 
                        class="breve-source-text"
                        data-fr={titleFR}
                        data-en={titleEN}
                      >
                        {titleFR}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </footer>
        )}

      </article>
    </div>
  ) : (
    <div class="article-wrapper">
      <FavoriteStar slug={article.id} />
      <ReadLaterClock slug={article.id} title={titleFR} titleEn={titleEN} />
      <div class="article-container">

        <header class="article-header">
          <h1 class="main-title" data-fr={titleFR} data-en={titleEN}>{titleFR}</h1>
          {descFR && <p class="main-description" data-fr={descFR} data-en={descEN}>{descFR}</p>}

          <div class="author-meta-block">
            <div class="author-avatar-group">
              {authorProfiles.map((author) => (
                <img src={author.avatarUrl} alt={`Portrait de ${author.name}`} class="author-avatar" />
              ))}
            </div>
            <div class="author-text-meta">
              <p class="author-name">
                <span data-i18n="by_author">{t('by_author', 'FR')}</span>{" "}
                {authorProfiles.map((author, index) => (
                  <>
                    {index > 0 && <>{" "}<span data-i18n="author_separator">et</span>{" "}</>}
                    <AuthorProfileHover {...author} />
                  </>
                ))}
              </p>
              <p class="publication-date">
                {readingTime}{" "}
                <span data-i18n="read_time">{t('read_time', 'FR')}</span>
                {" — "}
                <span data-i18n="published_on">{t('published_on', 'FR')}</span>{" "}
                <span data-fr={dateAfficheeFR} data-en={dateAfficheeEN}>{dateAfficheeFR}</span>{" "}
                <span data-i18n="published_at">{t('published_at', 'FR')}</span>{" "}
                <span data-fr={heureAfficheeFR} data-en={heureAfficheeEN}>{heureAfficheeFR}</span>
              </p>
            </div>
          </div>
        </header>

        <div class="article-grid">

          <main class="article-main-content">
            <div class="prose-content" data-lang-content="FR">
              <Content />
            </div>

            {bodyEnHtml ? (
              <div class="prose-content" data-lang-content="EN" hidden set:html={bodyEnHtml} />
            ) : (
              <div class="prose-content" data-lang-content="EN" hidden>
                <p data-i18n="no_english_version">{t('no_english_version', 'FR')}</p>
              </div>
            )}
          </main>

          <aside class="article-sidebar">
            <div class="sidebar-sticky-box">
              {sidebarSlots.length > 0 && (
                <>
                  <p class="sidebar-label" data-i18n="sidebar_read_also">{t('sidebar_read_also', 'FR')}</p>
                  
                  <div class="sidebar-similaires">
                    {sidebarSlots.map(({ artFR, artEN, hasEn: slotHasEn }) => {
                      const imgFR = artFR.data.image || artFR.data.article_image || "";
                      const imgEN = slotHasEn && artEN
                        ? (artEN.data.image || artEN.data.article_image || "")
                        : "";
                      const imgShow = imgFR || imgEN;
                      return (
                        <a
                          href={`/articles/${artFR.id}`}
                          class="sidebar-card article-card-item"
                          data-has-en={slotHasEn ? "true" : "false"}
                          data-href-fr={`/articles/${artFR.id}`}
                          data-href-en={slotHasEn && artEN ? `/articles/${artEN.id}` : ""}
                        >
                          {imgShow && (
                            <img
                              src={imgFR || imgEN}
                              alt={artFR.data.title}
                              class="sidebar-card-img"
                              data-img-fr={imgFR || imgEN}
                              data-img-en={imgEN || imgFR}
                            />
                          )}
                          <div class="sidebar-card-body">
                            <p class="sidebar-card-tag">
                              <CategoryBadge slug={artFR.data.category} slugEn={slotHasEn && artEN ? artEN.data.category : undefined} />
                            </p>
                            <p
                              class="sidebar-card-title"
                              data-fr={artFR.data.title}
                              data-en={slotHasEn && artEN ? String(artEN.data.title_en) : ""}
                            >
                              {artFR.data.title}
                            </p>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </>
              )}
            </div>
          </aside>

        </div>

        <footer id="author-info-section" class="article-sources">
          <h2 data-i18n="transparency_sources">{t('transparency_sources', 'FR')}</h2>
          {article.data.consulted_sources && article.data.consulted_sources.length > 0 ? (
            <ul class="sources-list">
              {article.data.consulted_sources.map((src: any) => {
                const titleFR = src.source_title;
                const titleEN = src.source_title_en || titleFR;

                return (
                  <li>
                    {src.source_url ? (
                      <a
                        href={src.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-fr={titleFR}
                        data-en={titleEN}
                      >
                        {titleFR}
                      </a>
                    ) : (
                      <span data-fr={titleFR} data-en={titleEN}>{titleFR}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="article-sources-empty" data-i18n="transparency_no_sources">{t('transparency_no_sources', 'FR')}</p>
          )}
        </footer>

        <div id="read-also-anchor"></div>

      </div>
    </div>
  )}
  {!isRevue && mediaBlocks.length > 0 && (
    <>
      <script id="article-media-blocks" type="application/json" set:html={mediaBlocksJson} />
      <div id="article-tweet-source" hidden>
        {tweetBlocks.map((block) => (
          <div class="tweet-embed-wrapper" data-media-id={block.id} data-media-after={String(block.after)}>
            <Tweet id={block.url} theme="dark" />
          </div>
        ))}
      </div>
    </>
  )}
  <!-- Section commentaire à la fin de l'article -->
  <CommentsSection articleSlug={slug} />
  <DefinitionTooltips items={article.data.definitions} />
</MainLayout>

<!-- Script JS -->
<script is:inline>
  function setupArticlePage() {
    function getSiteLang() {
      return (localStorage.getItem('site_lang') || 'FR').toUpperCase();
    }

    function applyDataLangAttributes(lang) {
      document.querySelectorAll('[data-fr][data-en]').forEach(el => {
        if (el.closest('.category-badge')) return;
        const valFr = el.getAttribute('data-fr');
        const valEn = el.getAttribute('data-en');
        if (lang === 'EN' && valEn) el.textContent = valEn;
        else if (valFr) el.textContent = valFr;
      });
    }

    function insertAtParagraphPosition(container, element, targetPos) {
      const paragraphs = Array.from(container.querySelectorAll(':scope > p')).filter(
        p => p.textContent.trim().length > 0
      );

      if (paragraphs.length === 0) {
        container.appendChild(element);
      } else if (targetPos <= 0) {
        container.insertBefore(element, paragraphs[0]);
      } else {
        const targetIndex = Math.min(targetPos, paragraphs.length) - 1;
        paragraphs[targetIndex].insertAdjacentElement('afterend', element);
      }
    }

    function readMediaBlocks() {
      const node = document.getElementById('article-media-blocks');
      if (!node || !node.textContent) return [];
      try {
        const parsed = JSON.parse(node.textContent);
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function mediaPercent(value) {
      var n = Number(value);
      if (!isFinite(n) || n <= 0) return 100;
      return Math.min(100, Math.max(1, n));
    }

    function applyAlign(el, block) {
      var left = block && block.align === 'left';
      el.classList.toggle('is-align-left', left);
      el.classList.toggle('is-align-center', !left);
      el.style.marginLeft = left ? '0' : 'auto';
      el.style.marginRight = left ? 'auto' : 'auto';
    }

    function applyImageLayout(figure, img, block) {
      var wPct = mediaPercent(block && block.width);
      var hPct = mediaPercent(block && block.height);
      applyAlign(figure, block);
      function layout() {
        var nw = img.naturalWidth;
        var nh = img.naturalHeight;
        if (!nw || !nh) return;
        img.style.width = '100%';
        img.style.height = 'auto';
        img.style.maxHeight = '';
        img.style.objectFit = '';
        figure.style.width = wPct + '%';
        figure.style.maxWidth = '100%';
        var cssMax = parseFloat(window.getComputedStyle(img).maxHeight);
        if (!isFinite(cssMax) || cssMax <= 0) cssMax = Infinity;
        var boxW = figure.getBoundingClientRect().width || img.clientWidth;
        var baseH = boxW * (nh / nw);
        if (baseH > cssMax) {
          baseH = cssMax;
          boxW = baseH * (nw / nh);
        }
        var displayH = baseH * (hPct / 100);
        var displayW = displayH * (nw / nh);
        img.style.width = displayW + 'px';
        img.style.height = displayH + 'px';
        img.style.maxHeight = 'none';
        img.style.objectFit = 'contain';
        figure.style.width = displayW + 'px';
        figure.style.overflow = 'visible';
      }
      if (img.complete && img.naturalHeight) requestAnimationFrame(layout);
      else img.addEventListener('load', function onLoad() {
        img.removeEventListener('load', onLoad);
        requestAnimationFrame(layout);
      });
    }

    var TWEET_NATIVE_W = 550;

    function ensureTweetInner(wrapper) {
      var inner = wrapper.querySelector('.tweet-scale-inner');
      if (inner) return inner;
      inner = document.createElement('div');
      inner.className = 'tweet-scale-inner';
      while (wrapper.firstChild) inner.appendChild(wrapper.firstChild);
      wrapper.appendChild(inner);
      return inner;
    }

    function tweetScaleFor(wrapper, wPct, hPct) {
      var parentW = wrapper.parentElement ? wrapper.parentElement.clientWidth : TWEET_NATIVE_W;
      var maxW = parentW * (wPct / 100);
      var scaleW = Math.min(1, maxW / TWEET_NATIVE_W);
      var scale = scaleW * (hPct / 100);
      if (!isFinite(scale) || scale <= 0) return 1;
      return Math.min(1, scale);
    }

    function collapseTweetLayout(wrapper, scale) {
      wrapper.style.width = Math.round(TWEET_NATIVE_W * scale) + 'px';
      wrapper.style.maxWidth = '100%';
      wrapper.style.height = 'auto';
      wrapper.style.overflow = 'visible';
    }

    function applyTweetLayout(wrapper, block) {
      var wPct = mediaPercent(block && block.width);
      var hPct = mediaPercent(block && block.height);
      var scale = tweetScaleFor(wrapper, wPct, hPct);
      applyAlign(wrapper, block);
      wrapper.dataset.heightPct = String(hPct);
      wrapper.dataset.tweetScale = String(scale);
      var inner = ensureTweetInner(wrapper);
      inner.style.width = TWEET_NATIVE_W + 'px';
      inner.style.maxWidth = 'none';
      inner.style.transform = 'none';
      inner.style.zoom = String(scale);
      var frame = wrapper.querySelector('iframe, .twitter-tweet');
      if (frame) {
        frame.style.width = TWEET_NATIVE_W + 'px';
        frame.style.maxWidth = 'none';
        frame.style.minWidth = TWEET_NATIVE_W + 'px';
      }
      collapseTweetLayout(wrapper, scale);
    }

    function applyMediaSize(el, block) {
      if (!el) return;
      if (el.classList.contains('tweet-embed-wrapper')) {
        applyTweetLayout(el, block);
        return;
      }
      var img = el.querySelector('img');
      if (img) applyImageLayout(el, img, block);
      else applyAlign(el, block);
    }

    if (!window.__sonarTweetResize) {
      window.__sonarTweetResize = true;
      window.addEventListener('message', function (event) {
        var origin = String(event.origin || '');
        if (origin.indexOf('twitter.com') === -1 && origin.indexOf('x.com') === -1 && origin.indexOf('twimg.com') === -1) return;
        var data = event.data;
        if (typeof data === 'string') {
          try { data = JSON.parse(data); } catch (e) { return; }
        }
        var height = data && ((data.params && data.params.height) || data.height);
        if (!height || !event.source) return;
        document.querySelectorAll('.tweet-embed-wrapper iframe').forEach(function (frame) {
          if (frame.contentWindow !== event.source) return;
          frame.dataset.baseHeight = String(height);
          frame.style.height = height + 'px';
          var wrap = frame.closest('.tweet-embed-wrapper');
          if (!wrap) return;
          wrap.dataset.baseHeight = String(height);
          var scale = Number(wrap.dataset.tweetScale || 1);
          if (!isFinite(scale) || scale <= 0) scale = 1;
          if (!frame.isConnected || !wrap.isConnected) return;
          collapseTweetLayout(wrap, scale);
        });
      });
    }

    function buildImageFigure(block, isBreve) {
      const figure = document.createElement('figure');
      figure.className = isBreve ? 'breve-figure injected-media-block' : 'hero-image-wrapper injected-media-block';
      const img = document.createElement('img');
      img.src = block.src || '';
      img.alt = block.caption || '';
      img.className = isBreve ? 'breve-image' : 'hero-img';
      figure.appendChild(img);
      if (block.caption || block.caption_en) {
        const cap = document.createElement('figcaption');
        cap.className = isBreve ? 'breve-caption' : 'image-caption';
        cap.setAttribute('data-fr', block.caption || '');
        cap.setAttribute('data-en', block.caption_en || block.caption || '');
        cap.textContent = block.caption || block.caption_en || '';
        figure.appendChild(cap);
      }
      return figure;
    }

    function injectMediaBlocks() {
      const blocks = readMediaBlocks();
      const source = document.getElementById('article-tweet-source');
      const isBreve = Boolean(document.querySelector('.breve-wrapper'));
      document.querySelectorAll('.prose-content[data-lang-content]').forEach(container => {
        container.querySelectorAll('.injected-media-block').forEach(el => el.remove());
      });
      if (source) {
        document.querySelectorAll('.prose-content .tweet-embed-wrapper[data-media-id]').forEach(el => {
          source.appendChild(el);
        });
      }
      if (!blocks.length) return;
      const ordered = blocks.slice().map((block, index) => Object.assign({}, block, { _i: index }));
      ordered.sort((a, b) => (Number(a.after) || 0) - (Number(b.after) || 0) || a._i - b._i);
      document.querySelectorAll('.prose-content[data-lang-content]').forEach(container => {
        const visible = !container.hasAttribute('hidden');
        for (let i = ordered.length - 1; i >= 0; i--) {
          const block = ordered[i];
          const after = Number(block.after) || 0;
          if (block.type === 'tweet') {
            if (!visible || !source) continue;
            const tweet = source.querySelector('[data-media-id="' + block.id + '"]');
            if (tweet) {
              insertAtParagraphPosition(container, tweet, after);
              applyMediaSize(tweet, block);
            }
          } else if (block.src) {
            const figure = buildImageFigure(block, isBreve);
            insertAtParagraphPosition(container, figure, after);
            applyMediaSize(figure, block);
          }
        }
      });
    }

    function updateLanguageUI(lang) {
      const currentLang = (lang || getSiteLang()).toUpperCase();

      document.querySelectorAll('.prose-content[data-lang-content]').forEach(el => {
        const isTargetLang = el.getAttribute('data-lang-content') === currentLang;
        if (isTargetLang) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });

      injectMediaBlocks();
      applyDataLangAttributes(currentLang);
    }

    updateLanguageUI(getSiteLang());

    window.addEventListener('languageChanged', (e) => {
      const newLang = (e.detail && e.detail.lang) || e.detail || getSiteLang();
      updateLanguageUI(newLang);
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'site_lang') updateLanguageUI(e.newValue);
    });

    const briefRelated = document.querySelector('.breve-related[data-brief-related]');
    if (briefRelated) {
      const toggle = briefRelated.querySelector('[data-brief-related-toggle]');
      const modeButtons = Array.from(briefRelated.querySelectorAll('[data-brief-related-mode]'));
      const views = Array.from(briefRelated.querySelectorAll('[data-brief-related-view]'));
      const mainContent = document.querySelector('.breve-main-content');
      const authorBlock = briefRelated.previousElementSibling;
      const collapsedKey = 'sonar:brief-related:collapsed';

      const setCollapsed = (collapsed, animate = true) => {
        if (!animate) briefRelated.classList.add('is-initializing');
        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.textContent = collapsed
          ? (getSiteLang() === 'EN' ? 'Show' : 'Afficher')
          : (getSiteLang() === 'EN' ? 'Minimize' : 'Réduire');
        toggle.setAttribute('data-fr', collapsed ? 'Afficher' : 'Réduire');
        toggle.setAttribute('data-en', collapsed ? 'Show' : 'Minimize');
        briefRelated.classList.toggle('is-collapsed', collapsed);
        const sidebar = briefRelated.closest('.breve-sidebar');
        if (sidebar) sidebar.classList.toggle('has-collapsed-related', collapsed);
        try {
          localStorage.setItem(collapsedKey, collapsed ? 'true' : 'false');
        } catch {}
        if (!animate) {
          window.requestAnimationFrame(() => briefRelated.classList.remove('is-initializing'));
        }
      };

      let isCollapsed = false;
      try {
        isCollapsed = localStorage.getItem(collapsedKey) === 'true';
      } catch {}
      setCollapsed(isCollapsed, false);

      toggle.addEventListener('click', () => {
        setCollapsed(toggle.getAttribute('aria-expanded') === 'true');
      });

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.getAttribute('data-brief-related-mode');
          modeButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
          });
          views.forEach((view) => {
            view.hidden = view.getAttribute('data-brief-related-view') !== mode;
          });
        });
      });

      const syncBriefRelatedHeight = () => {
        if (!mainContent || window.matchMedia('(max-width: 968px)').matches) {
          briefRelated.style.removeProperty('--brief-related-max-height');
          return;
        }
        const reservedHeight = authorBlock ? authorBlock.getBoundingClientRect().height + 16 : 0;
        const availableHeight = Math.max(280, Math.ceil(mainContent.getBoundingClientRect().height - reservedHeight));
        briefRelated.style.setProperty('--brief-related-max-height', availableHeight + 'px');
      };

      syncBriefRelatedHeight();
      if (typeof ResizeObserver !== 'undefined' && mainContent) {
        new ResizeObserver(syncBriefRelatedHeight).observe(mainContent);
      }
      window.addEventListener('resize', syncBriefRelatedHeight);
    }

    const readAlsoAside = document.querySelector('.article-sidebar');
    const readAlsoGrid = document.querySelector('.article-grid');
    const readAlsoAnchor = document.getElementById('read-also-anchor');

    if (readAlsoAside && readAlsoGrid && readAlsoAnchor) {
      const mobileQuery = window.matchMedia('(max-width: 968px)');

      const positionReadAlso = () => {
        if (mobileQuery.matches) {
          if (readAlsoAnchor.nextElementSibling !== readAlsoAside) {
            readAlsoAnchor.insertAdjacentElement('afterend', readAlsoAside);
          }
        } else if (readAlsoAside.parentElement !== readAlsoGrid) {
          readAlsoGrid.appendChild(readAlsoAside);
        }
      };

      positionReadAlso();
      if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', positionReadAlso);
      else if (mobileQuery.addListener) mobileQuery.addListener(positionReadAlso);
    }
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', setupArticlePage);
  } else {
    setupArticlePage();
  }
</script>

