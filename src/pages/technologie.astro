---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import { getCollection } from 'astro:content';

const tousLesArticles = await getCollection('articles');
const articlesTechnologie = tousLesArticles
    .filter(art => art.data.category?.toLowerCase() === 'technologie' && art.data.isVisible !== false)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<CategoryLayout 
  categoryTitle="Technologie" 
  categorySlug="technologie" 
  articles={articlesTechnologie} 
/>