---
import MainLayout from '../layouts/Layout.astro';
---

<MainLayout title="Mot de passe oublié">
  <div class="auth-page">
    <div class="auth-card">
      <h1 data-i18n="auth_forgot_title">Mot de passe oublié</h1>
      <p class="auth-subtitle" data-i18n="auth_forgot_subtitle">
        Indiquez votre adresse e-mail. Si un compte existe, vous recevrez un lien pour en choisir un nouveau.
      </p>

      <form id="forgot-form" class="auth-form">
        <div class="form-group">
          <label for="email" data-i18n="auth_email">Adresse e-mail</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <p id="form-message" class="form-message"></p>
        <button type="submit" id="submit-btn" data-i18n="auth_forgot_submit">Envoyer le lien</button>
      </form>

      <p class="auth-switch">
        <a id="login-link" href="/connexion" data-i18n="auth_forgot_back">Retour à la connexion</a>
      </p>
    </div>
  </div>
</MainLayout>

<script>
  import { getBrowserSupabase, safeRedirectPath, getAuthRedirectUrl } from '../utils/supabase-browser';
  import { t as translate } from '../utils/i18n.js';
  import { isValidEmail } from '../utils/auth-validation';

  const params = new URLSearchParams(window.location.search);
  const redirect = safeRedirectPath(params.get('redirect'));

  function currentLang(): 'FR' | 'EN' {
    return (localStorage.getItem('site_lang') || 'FR').toUpperCase() === 'EN' ? 'EN' : 'FR';
  }

  function t(key: string) {
    return translate(key, currentLang());
  }

  const loginLink = document.getElementById('login-link') as HTMLAnchorElement | null;
  if (loginLink && params.get('redirect')) {
    loginLink.href = `/connexion?redirect=${encodeURIComponent(redirect)}`;
  }

  const form = document.getElementById('forgot-form') as HTMLFormElement | null;
  const messageEl = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!messageEl || !form) return;

    const email = String(new FormData(form).get('email') || '').trim();
    if (!email) return;
    if (!isValidEmail(email)) {
      messageEl.textContent = t('auth_email_invalid');
      messageEl.style.color = '#ef4444';
      return;
    }

    messageEl.textContent = currentLang() === 'EN' ? 'Sending…' : 'Envoi en cours…';
    messageEl.style.color = '#9ca3af';
    if (submitBtn) submitBtn.disabled = true;

    try {
      const supabase = getBrowserSupabase();
      await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: getAuthRedirectUrl('/nouveau-mot-de-passe'),
      });
    } catch {
      /* message générique : on ne révèle pas si l’adresse existe */
    }

    messageEl.textContent = t('auth_forgot_sent');
    messageEl.style.color = '#22c55e';
    if (submitBtn) submitBtn.disabled = false;
  });
</script>

<style>
  .auth-page {
    max-width: 480px;
    margin: 40px auto 80px auto;
  }

  .auth-card {
    background-color: #02001d;
    border-radius: 8px;
    padding: 40px 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .auth-card h1 {
    margin: 0 0 8px 0;
    font-size: 1.8rem;
    color: #ffffff;
  }

  .auth-subtitle {
    margin: 0 0 28px 0;
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    color: #d1d5db;
  }

  .form-group input {
    background-color: #0b092b;
    border: 1px solid #1f2937;
    border-radius: 6px;
    padding: 0.75rem;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.95rem;
  }

  .form-group input:focus {
    outline: none;
    border-color: #ea580c;
  }

  .form-message {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.9rem;
  }

  #submit-btn {
    background-color: #ea580c;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
  }

  #submit-btn:hover:not(:disabled) {
    background-color: #d4510b;
  }

  #submit-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .auth-switch {
    margin-top: 24px;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  .auth-switch a {
    color: #ea580c;
    font-weight: 600;
    text-decoration: none;
  }

  .auth-switch a:hover {
    text-decoration: underline;
  }

  @media (max-width: 968px) {
    .auth-page {
      margin: 20px auto 40px auto;
    }
    .auth-card {
      padding: 28px 20px;
    }
  }
</style>
