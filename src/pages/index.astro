    .thumbnail-text { position: absolute; z-index: 1; margin: 0; padding: 0; width: 60%; max-width: 400px; line-height: 1.2; word-wrap: break-word; overflow-wrap: break-word; text-shadow: 2px 2px 5px rgba(0,0,0,0.9); }
</style>