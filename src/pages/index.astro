---
import MainLayout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import homeSettings from '../data/settings.json';
import { categoryLabel } from '../utils/i18n.js';
import Analytics from '@vercel/analytics/astro';

// Nettoyage flexible pour la comparaison des slugs/IDs
const nettoyer = (s: any) => 
    String(s || '')
        .replace(/\.mdx?$/, '')
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]/g, "");

const slugEstVide = (s: any) => s == null || String(s).trim() === "";

// Tous les articles visibles, triés du plus récent au plus ancien
const tousLesArticles = (await getCollection('articles'))
    .filter(art => art.data.isVisible !== false)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const trouverArticleParSlug = (slugCible: string | null | undefined) => {
    if (slugEstVide(slugCible)) return null;
    const cibleClean = nettoyer(slugCible);
    return tousLesArticles.find(art => nettoyer(art.id || art.slug) === cibleClean) || null;
};

const checkHasEn = (art: any) => Boolean(art && art.data && art.data.title_en && String(art.data.title_en).trim() !== "");

const IMG_PLACEHOLDER = "/assets/uploads/default-placeholder.jpg";

// --- PLACEMENT FR : 2 PASSES ---
// Passe 1 = uniquement les choix admin (emplacement le plus haut gagne si doublon)
// Passe 2 = combler les trous du haut vers le bas par date de publication
const articlesUtilisesIdsFR = new Set<string>();

const reserverAdmin = (slugCible: any) => {
    const art = trouverArticleParSlug(slugCible);
    if (!art || articlesUtilisesIdsFR.has(art.id)) return null;
    articlesUtilisesIdsFR.add(art.id);
    return art;
};

const prochainRecent = () => {
    const art = tousLesArticles.find((a) => !articlesUtilisesIdsFR.has(a.id)) || null;
    if (art) articlesUtilisesIdsFR.add(art.id);
    return art;
};

const avecStyles = (art: any, styleDecap: any, defaults: { fontSize: string; fontWeight: string; fontFamily: string }) => {
    if (!art) return null;
    return {
        ...art,
        customStyles: {
            fontSize: styleDecap?.titleSize || defaults.fontSize,
            fontWeight: styleDecap?.titleWeight || defaults.fontWeight,
            fontFamily: styleDecap?.titleFont || defaults.fontFamily,
        },
    };
};

const slotsSmall = (homeSettings.sidebarSmallArticles?.length > 0)
    ? homeSettings.sidebarSmallArticles
    : [null, null];
const slotsBottom = (homeSettings.bottomArticles?.length > 0)
    ? homeSettings.bottomArticles
    : [null, null, null];
const slotsAsymLeft = (homeSettings.asymLeftArticles?.length > 0)
    ? homeSettings.asymLeftArticles
    : [null, null, null];

// Passe 1 — réservations admin (ne remplit JAMAIS un trou ici)
let articleUneFR: any = reserverAdmin(homeSettings.heroArticle);
let premierSecondaireLongFR: any = reserverAdmin(homeSettings.sidebarLongArticle);

let autresSecondairesBasFR: any[] = slotsSmall.slice(0, 2).map((slug: any) => reserverAdmin(slug));
while (autresSecondairesBasFR.length < 2) autresSecondairesBasFR.push(null);

let articlesRangeeInferieureFR: any[] = slotsBottom.slice(0, 3).map((slug: any, index: number) =>
    avecStyles(
        reserverAdmin(slug),
        homeSettings.bottomArticlesStyles?.[index],
        { fontSize: "1.2rem", fontWeight: "700", fontFamily: "sans-serif" }
    )
);
while (articlesRangeeInferieureFR.length < 3) articlesRangeeInferieureFR.push(null);

let articlesAsymGaucheFR: any[] = slotsAsymLeft.slice(0, 3).map((slug: any, index: number) =>
    avecStyles(
        reserverAdmin(slug),
        homeSettings.asymLeftStyles?.[index],
        { fontSize: "1.1rem", fontWeight: "700", fontFamily: "sans-serif" }
    )
);
while (articlesAsymGaucheFR.length < 3) articlesAsymGaucheFR.push(null);

let articleAsymDroiteFR: any = reserverAdmin(homeSettings.asymRightArticle);

// Passe 2 — combler les trous (haut → bas), sans toucher aux réservations
articleUneFR = articleUneFR || prochainRecent();
premierSecondaireLongFR = premierSecondaireLongFR || prochainRecent();
autresSecondairesBasFR = autresSecondairesBasFR.map((art) => art || prochainRecent());
articlesRangeeInferieureFR = articlesRangeeInferieureFR.map((art, index) =>
    art || avecStyles(
        prochainRecent(),
        homeSettings.bottomArticlesStyles?.[index],
        { fontSize: "1.2rem", fontWeight: "700", fontFamily: "sans-serif" }
    )
);
articlesAsymGaucheFR = articlesAsymGaucheFR.map((art, index) =>
    art || avecStyles(
        prochainRecent(),
        homeSettings.asymLeftStyles?.[index],
        { fontSize: "1.1rem", fontWeight: "700", fontFamily: "sans-serif" }
    )
);
articleAsymDroiteFR = articleAsymDroiteFR || prochainRecent();

// Retirer les null résiduels (plus assez d'articles)
autresSecondairesBasFR = autresSecondairesBasFR.filter(Boolean);
articlesRangeeInferieureFR = articlesRangeeInferieureFR.filter(Boolean);
articlesAsymGaucheFR = articlesAsymGaucheFR.filter(Boolean);

const styleDroiteDecap = homeSettings.asymRightStyle || {};
const styleGrandArticle = {
    fontSize: styleDroiteDecap.titleSize || "1.8rem",
    fontWeight: styleDroiteDecap.titleWeight || "700",
    fontFamily: styleDroiteDecap.titleFont || "sans-serif",
};

// --- PLACEMENT EN (FR inchangé) ---
// Parcours haut → bas. Si le slot FR a une EN encore dispo → on le garde.
// Sinon (trou) → on promeut l'article admin traduit le plus haut restant,
// sinon le prochain EN par date de publication.
const articlesENDisponibles = tousLesArticles.filter(checkHasEn);

const assignerSlotsEN = (slotsFR: any[]) => {
    const usedIds = new Set<string>();
    const result = slotsFR.map(() => ({ article: null as any, hasEn: false }));

    // File admin EN dans l'ordre page / settings (1re occurrence = plus haut)
    const adminEnQueue: any[] = [];
    const pushAdminEn = (slug: any) => {
        if (slugEstVide(slug)) return;
        const art = trouverArticleParSlug(slug);
        if (!art || !checkHasEn(art)) return;
        if (adminEnQueue.some((a) => a.id === art.id)) return;
        adminEnQueue.push(art);
    };
    pushAdminEn(homeSettings.heroArticle);
    pushAdminEn(homeSettings.sidebarLongArticle);
    (homeSettings.sidebarSmallArticles || []).forEach(pushAdminEn);
    (homeSettings.bottomArticles || []).forEach(pushAdminEn);
    (homeSettings.asymLeftArticles || []).forEach(pushAdminEn);
    pushAdminEn(homeSettings.asymRightArticle);

    const prochainAdminEn = () => adminEnQueue.find((a) => !usedIds.has(a.id)) || null;
    const prochainDateEn = () => articlesENDisponibles.find((a) => !usedIds.has(a.id)) || null;

    const placer = (index: number, art: any) => {
        if (!art || usedIds.has(art.id) || result[index].hasEn) return false;
        usedIds.add(art.id);
        result[index] = { article: art, hasEn: true };
        return true;
    };

    for (let i = 0; i < slotsFR.length; i++) {
        const artFR = slotsFR[i];
        if (!artFR) continue;

        // Traduction dispo à cet emplacement → on la garde
        if (checkHasEn(artFR) && !usedIds.has(artFR.id)) {
            placer(i, artFR);
            continue;
        }

        // Trou : admin traduit le plus haut restant, sinon ordre de publication
        placer(i, prochainAdminEn() || prochainDateEn());
    }

    return result;
};

const allSlotsFR = [
    articleUneFR,
    premierSecondaireLongFR,
    ...autresSecondairesBasFR,
    ...articlesRangeeInferieureFR,
    ...articlesAsymGaucheFR,
    articleAsymDroiteFR,
];

const allSlotsEN = assignerSlotsEN(allSlotsFR);

let enIdx = 0;
const uneEN = allSlotsEN[enIdx++] ?? { article: null, hasEn: false };
const longEN = allSlotsEN[enIdx++] ?? { article: null, hasEn: false };
const autresSecondairesBasResult = allSlotsEN.slice(enIdx, enIdx + autresSecondairesBasFR.length);
enIdx += autresSecondairesBasFR.length;
const articlesRangeeInferieureResult = allSlotsEN.slice(enIdx, enIdx + articlesRangeeInferieureFR.length);
enIdx += articlesRangeeInferieureFR.length;
const articlesAsymGaucheResult = allSlotsEN.slice(enIdx, enIdx + articlesAsymGaucheFR.length);
enIdx += articlesAsymGaucheFR.length;
const asymDroiteEN = allSlotsEN[enIdx] ?? { article: null, hasEn: false };

const articleUneEN = uneEN.article;
const hasEnUne = uneEN.hasEn;
const premierSecondaireLongEN = longEN.article;
const hasEnLong = longEN.hasEn;
const articleAsymDroiteEN = asymDroiteEN.article;
const hasEnAsymDroite = asymDroiteEN.hasEn;

const enText = (artEN: any, hasEn: boolean, field: string, fallbackField?: string) => {
    if (!hasEn || !artEN) return "";
    const primary = artEN.data?.[field];
    if (primary != null && String(primary).trim() !== "") return String(primary);
    if (fallbackField) {
        const secondary = artEN.data?.[fallbackField];
        if (secondary != null && String(secondary).trim() !== "") return String(secondary);
    }
    return "";
};
const enImage = (artEN: any, hasEn: boolean) => {
    if (!hasEn || !artEN) return "";
    return artEN.data?.image || IMG_PLACEHOLDER;
};
const enHref = (artEN: any, hasEn: boolean) => {
    if (!hasEn || !artEN) return "";
    return `/articles/${artEN.id}`;
};
const enBg = (artEN: any, hasEn: boolean, field = "image") => {
    if (!hasEn || !artEN) return "";
    return artEN.data?.[field] || artEN.data?.image || IMG_PLACEHOLDER;
};
---

<MainLayout title="Accueil" isHome={true}>
    <div class="container-accueil">
        
        <!-- GRILLE PRINCIPALE (HAUT) -->
        <div class="main-grid">
            {articleUneFR ? (
                articleUneFR.data.use_thumbnail && articleUneFR.data.thumbnail_bg ? (
                    <a 
                      href={`/articles/${articleUneFR.id}`} 
                      class="thumbnail-wrapper article-une article-card-item"
                      data-href-fr={`/articles/${articleUneFR.id}`}
                      data-href-en={enHref(articleUneEN, hasEnUne)}
                      data-has-en={hasEnUne ? "true" : "false"}
                    >
                        <div class="thumbnail-canvas" 
                        data-bg-fr={articleUneFR.data.thumbnail_bg}
                        data-bg-en={enBg(articleUneEN, hasEnUne, "thumbnail_bg")}
                        style={`
                        background-image: url('${articleUneFR.data.thumbnail_bg}');
                        background-size: ${articleUneFR.data.thumbnail_bg_zoom ? articleUneFR.data.thumbnail_bg_zoom + '%' : 'cover'};
                        background-position: ${articleUneFR.data.thumbnail_bg_position || 'center'};
                        background-repeat: no-repeat;
                        `}>
                            <div class="thumbnail-shadow"></div>

                            {articleUneFR.data.thumbnail_title && (
                                <h2 
                                  class="thumbnail-text" 
                                  style={`
                                    left: ${articleUneFR.data.title_x ?? 20}px;
                                    top: ${articleUneFR.data.title_y ?? 20}px;
                                    font-size: ${articleUneFR.data.title_size ?? 24}px;
                                    font-weight: ${articleUneFR.data.title_weight ?? 700};
                                    font-family: ${articleUneFR.data.title_font ?? 'sans-serif'};
                                    color: ${articleUneFR.data.title_color ?? '#ffffff'};
                                  `}
                                  data-fr={articleUneFR.data.title}
                                  data-en={enText(articleUneEN, hasEnUne, "title_en")}
                                >
                                    {articleUneFR.data.title}
                                </h2>
                            )}

                            {(articleUneFR.data.thumbnail_descs ?? []).map((bloc: any) => (
                                <p class="thumbnail-text" style={`
                                left: ${bloc.x ?? 20}px;
                                top: ${bloc.y ?? 80}px;
                                font-size: ${bloc.size ?? 14}px;
                                font-weight: ${bloc.weight ?? 400};
                                font-family: ${bloc.font ?? 'sans-serif'};
                                color: ${bloc.color ?? '#e1e8ed'};
                                `}>
                                    {bloc.line}
                                </p>
                            ))}
                        </div>
                    </a>
                ) : (
                    <a 
                      href={`/articles/${articleUneFR.id}`} 
                      class="article-une article-card-item"
                      data-href-fr={`/articles/${articleUneFR.id}`}
                      data-href-en={enHref(articleUneEN, hasEnUne)}
                      data-has-en={hasEnUne ? "true" : "false"}
                    >
                        <div class="article-une-body">
                            <p 
                              class="article-tag"
                              data-fr={categoryLabel(articleUneFR.data.category, 'FR')}
                              data-en={hasEnUne ? categoryLabel(articleUneEN.data.category, 'EN') : ''}
                            >
                                {categoryLabel(articleUneFR.data.category, 'FR')}
                            </p>
                            <h2 
                              data-fr={articleUneFR.data.title}
                              data-en={enText(articleUneEN, hasEnUne, "title_en")}
                            >
                                {articleUneFR.data.title}
                            </h2>
                            <p 
                              class="article-desc"
                              data-fr={articleUneFR.data.description}
                              data-en={enText(articleUneEN, hasEnUne, "description_en")}
                            >
                                {articleUneFR.data.description}
                            </p>
                        </div>
                        {articleUneFR.data.image && (
                            <div class="image-wrapper">
                              <img 
                                src={articleUneFR.data.image} 
                                data-img-fr={articleUneFR.data.image}
                                data-img-en={enImage(articleUneEN, hasEnUne)}
                                alt="" 
                              />
                            </div>
                        )}
                    </a>
                )
            ) : (
                <section class="article-une"><p>Aucun article à la une trouvé.</p></section>
            )}

            <aside class="sidebar-articles">
                {premierSecondaireLongFR && (
                    <a 
                      href={`/articles/${premierSecondaireLongFR.id}`} 
                      class="article-sidebar long article-card-item"
                      data-href-fr={`/articles/${premierSecondaireLongFR.id}`}
                      data-href-en={enHref(premierSecondaireLongEN, hasEnLong)}
                      data-has-en={hasEnLong ? "true" : "false"}
                    >
                        <div class="card-content-top">
                            <p 
                              class="sidebar-tag"
                              data-fr={categoryLabel(premierSecondaireLongFR.data.category, 'FR')}
                              data-en={hasEnLong ? categoryLabel(premierSecondaireLongEN.data.category, 'EN') : ''}
                            >
                                {categoryLabel(premierSecondaireLongFR.data.category, 'FR')}
                            </p>
                            <h3
                              data-fr={premierSecondaireLongFR.data.title}
                              data-en={enText(premierSecondaireLongEN, hasEnLong, "title_en")}
                            >
                                {premierSecondaireLongFR.data.title}
                            </h3>
                            <p 
                              class="sidebar-desc"
                              data-fr={premierSecondaireLongFR.data.description}
                              data-en={enText(premierSecondaireLongEN, hasEnLong, "description_en")}
                            >
                                {premierSecondaireLongFR.data.description}
                            </p>
                        </div>
                        <div class="card-dynamic-spacer">
                            <img 
                              src={premierSecondaireLongFR.data.image || IMG_PLACEHOLDER} 
                              data-img-fr={premierSecondaireLongFR.data.image || IMG_PLACEHOLDER}
                              data-img-en={enImage(premierSecondaireLongEN, hasEnLong)}
                              alt="" 
                              class="spacer-img" 
                            />
                        </div>
                    </a>
                )}

                {autresSecondairesBasFR.length > 0 && (
                    <div class="sub-grid">
                        {autresSecondairesBasFR.map((artFR, idx) => {
                            const artEN = autresSecondairesBasResult[idx]?.article ?? null;
                            const hasEn = autresSecondairesBasResult[idx]?.hasEn ?? false;
                            return (
                                <a 
                                  href={`/articles/${artFR.id}`} 
                                  class="article-sidebar article-card-item scroll-fade-up" 
                                  set:key={artFR.id}
                                  data-href-fr={`/articles/${artFR.id}`}
                                  data-href-en={enHref(artEN, hasEn)}
                                  data-has-en={hasEn ? "true" : "false"}
                                >
                                    <div class="card-content-top">
                                        <p 
                                          class="sidebar-tag"
                                          data-fr={categoryLabel(artFR.data.category, 'FR')}
                                          data-en={hasEn ? categoryLabel(artEN.data.category, 'EN') : ''}
                                        >
                                            {categoryLabel(artFR.data.category, 'FR')}
                                        </p>
                                        <h3
                                          data-fr={artFR.data.title}
                                          data-en={enText(artEN, hasEn, "title_en")}
                                        >
                                            {artFR.data.title}
                                        </h3>
                                        <p 
                                          class="sidebar-desc"
                                          data-fr={artFR.data.description}
                                          data-en={enText(artEN, hasEn, "description_en")}
                                        >
                                            {artFR.data.description}
                                        </p>
                                    </div>
                                    <div class="card-dynamic-spacer">
                                        <img 
                                          src={artFR.data.image || IMG_PLACEHOLDER} 
                                          data-img-fr={artFR.data.image || IMG_PLACEHOLDER}
                                          data-img-en={enImage(artEN, hasEn)}
                                          alt="" 
                                          class="spacer-img" 
                                        />
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                )}
            </aside>
        </div>

        <!-- RANGÉE DU BAS (3 ARTICLES) -->
        {articlesRangeeInferieureFR.length > 0 && (
            <section class="bottom-row-grid scroll-interactive">
                {articlesRangeeInferieureFR.map((artFR, idx) => {
                    const artEN = articlesRangeeInferieureResult[idx]?.article ?? null;
                    const hasEn = articlesRangeeInferieureResult[idx]?.hasEn ?? false;
                    const bgImageFR = artFR.data.image || IMG_PLACEHOLDER;
                    return (
                        <a 
                          href={`/articles/${artFR.id}`} 
                          class="article-bottom-card has-bg article-card-item" 
                          set:key={artFR.id} 
                          style={`background-image: url('${bgImageFR}');`}
                          data-bg-fr={bgImageFR}
                          data-bg-en={enImage(artEN, hasEn)}
                          data-href-fr={`/articles/${artFR.id}`}
                          data-href-en={enHref(artEN, hasEn)}
                          data-has-en={hasEn ? "true" : "false"}
                        >
                            <div class="overlay"></div>
                            <div class="card-content-top">
                                <p 
                                  class="card-tag"
                                  data-fr={categoryLabel(artFR.data.category, 'FR')}
                                  data-en={hasEn ? categoryLabel(artEN.data.category, 'EN') : ''}
                                >
                                    {categoryLabel(artFR.data.category, 'FR')}
                                </p>
                                <h3 
                                  style={`font-size: ${artFR.customStyles.fontSize} !important; font-weight: ${artFR.customStyles.fontWeight} !important; font-family: ${artFR.customStyles.fontFamily} !important;`}
                                  data-fr={artFR.data.title}
                                  data-en={enText(artEN, hasEn, "title_en")}
                                >
                                    {artFR.data.title}
                                </h3>
                                <p 
                                  class="card-desc"
                                  data-fr={artFR.data.description}
                                  data-en={enText(artEN, hasEn, "description_en")}
                                >
                                    {artFR.data.description}
                                </p>
                            </div>
                        </a>
                    );
                })}
            </section>
        )}

        <!-- RANGÉE ASYMÉTRIQUE -->
        <section class="asym-container">
            <div class="asym-left-stack">
                {articlesAsymGaucheFR.map((artFR, index) => {
                    const artEN = articlesAsymGaucheResult[index]?.article ?? null;
                    const hasEn = articlesAsymGaucheResult[index]?.hasEn ?? false;
                    const bgImageFR = artFR.data.image || IMG_PLACEHOLDER;
                    return (
                        <div class="scroll-left-to-right article-card-item" data-index={index} set:key={artFR.id} data-has-en={hasEn ? "true" : "false"}>
                            <a 
                              href={`/articles/${artFR.id}`} 
                              class="article-bottom-card has-bg" 
                              style={`background-image: url('${bgImageFR}');`}
                              data-bg-fr={bgImageFR}
                              data-bg-en={enImage(artEN, hasEn)}
                              data-href-fr={`/articles/${artFR.id}`}
                              data-href-en={enHref(artEN, hasEn)}
                            >
                                <div class="overlay"></div>
                                <div class="card-content-top">
                                    <p 
                                      class="card-tag"
                                      data-fr={categoryLabel(artFR.data.category, 'FR')}
                                      data-en={hasEn ? categoryLabel(artEN.data.category, 'EN') : ''}
                                    >
                                        {categoryLabel(artFR.data.category, 'FR')}
                                    </p>
                                    <h3 
                                      style={`font-size: ${artFR.customStyles.fontSize} !important; font-weight: ${artFR.customStyles.fontWeight} !important; font-family: ${artFR.customStyles.fontFamily} !important;`}
                                      data-fr={artFR.data.title}
                                      data-en={enText(artEN, hasEn, "title_en")}
                                    >
                                        {artFR.data.title}
                                    </h3>
                                </div>
                            </a>
                        </div>
                    );
                })}
            </div>

            {articleAsymDroiteFR && (() => {
                const bgImageFR = articleAsymDroiteFR.data.image || IMG_PLACEHOLDER;
                return (
                    <div class="scroll-bottom-to-top article-card-item" data-has-en={hasEnAsymDroite ? "true" : "false"}>
                        <a 
                          href={`/articles/${articleAsymDroiteFR.id}`} 
                          class="article-bottom-card has-bg asym-right-giant" 
                          style={`background-image: url('${bgImageFR}');`}
                          data-bg-fr={bgImageFR}
                          data-bg-en={enImage(articleAsymDroiteEN, hasEnAsymDroite)}
                          data-href-fr={`/articles/${articleAsymDroiteFR.id}`}
                          data-href-en={enHref(articleAsymDroiteEN, hasEnAsymDroite)}
                        >
                            <div class="overlay"></div>
                            <div class="card-content-top">
                                <p 
                                  class="card-tag"
                                  data-fr={categoryLabel(articleAsymDroiteFR.data.category, 'FR')}
                                  data-en={hasEnAsymDroite ? categoryLabel(articleAsymDroiteEN.data.category, 'EN') : ''}
                                >
                                    {categoryLabel(articleAsymDroiteFR.data.category, 'FR')}
                                </p>
                                <h3 
                                  style={`font-size: ${styleGrandArticle.fontSize} !important; font-weight: ${styleGrandArticle.fontWeight} !important; font-family: ${styleGrandArticle.fontFamily} !important;`}
                                  data-fr={articleAsymDroiteFR.data.title}
                                  data-en={enText(articleAsymDroiteEN, hasEnAsymDroite, "title_en")}
                                >
                                    {articleAsymDroiteFR.data.title}
                                </h3>
                                <p 
                                  class="card-desc"
                                  data-fr={articleAsymDroiteFR.data.description}
                                  data-en={enText(articleAsymDroiteEN, hasEnAsymDroite, "description_en")}
                                >
                                    {articleAsymDroiteFR.data.description}
                                </p>
                            </div>
                        </a>
                    </div>
                );
            })()}
        </section>
    </div>
</MainLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Scroll interactive animations
        const bottomRow = document.querySelector('.scroll-interactive') as HTMLElement;
        const leftCards = document.querySelectorAll('.scroll-left-to-right');
        const rightGiant = document.querySelector('.scroll-bottom-to-top') as HTMLElement;
        const fadeUpCards = document.querySelectorAll('.scroll-fade-up');

        // Sur mobile, on unifie toutes les animations d'apparition en "bas → haut"
        // (le slide horizontal gauche→droite ne rend pas bien une fois les cartes empilées).
        // Seuil aligné sur celui du CSS (968px) : un décalage entre les deux faisait que
        // certaines cartes recevaient encore un translateX (glissement horizontal) alors
        // qu'elles étaient déjà empilées en pleine largeur, ce qui créait un léger
        // débordement/glissement horizontal de la page en mobile.
        const mobileQuery = window.matchMedia('(max-width: 968px)');

        function animateOnScroll() {
            const isMobile = mobileQuery.matches;
            const viewHeight = window.innerHeight;
            const startAnimation = viewHeight;
            const endAnimation = viewHeight - 200; 

            if (bottomRow) {
                const rect = bottomRow.getBoundingClientRect();
                let progress = (startAnimation - rect.top) / (startAnimation - endAnimation);
                progress = Math.max(0, Math.min(1, progress));
                bottomRow.style.opacity = progress.toString();
                bottomRow.style.transform = `translateY(${50 - (progress * 50)}px)`;
            }

            leftCards.forEach((card) => {
                const el = card as HTMLElement;
                const rect = el.getBoundingClientRect();
                const index = parseInt(el.getAttribute('data-index') || '0');
                
                let progress = (startAnimation - (rect.top + (index * 40))) / (startAnimation - endAnimation);
                progress = Math.max(0, Math.min(1, progress));

                el.style.opacity = progress.toString();
                if (isMobile) {
                    const translateY = 40 - (progress * 40);
                    el.style.transform = `translateY(${translateY}px)`;
                } else {
                    const translateX = -60 + (progress * 60);
                    el.style.transform = `translateX(${translateX}px)`;
                }
            });

            if (rightGiant) {
                const rect = rightGiant.getBoundingClientRect();
                let progress = (startAnimation - rect.top) / (startAnimation - endAnimation);
                progress = Math.max(0, Math.min(1, progress));

                const translateY = 70 - (progress * 70);
                rightGiant.style.opacity = progress.toString();
                rightGiant.style.transform = `translateY(${translateY}px)`;
            }

            // Sur mobile uniquement : les petites cartes de la sidebar (3e/4e article)
            // apparaissent aussi en fondu "bas → haut". Sur PC, elles restent statiques.
            fadeUpCards.forEach((card) => {
                const el = card as HTMLElement;
                if (!isMobile) {
                    el.style.opacity = '';
                    el.style.transform = '';
                    return;
                }
                const rect = el.getBoundingClientRect();
                let progress = (startAnimation - rect.top) / (startAnimation - endAnimation);
                progress = Math.max(0, Math.min(1, progress));
                el.style.opacity = progress.toString();
                el.style.transform = `translateY(${40 - (progress * 40)}px)`;
            });
        }

        window.addEventListener('scroll', animateOnScroll);
        window.addEventListener('resize', animateOnScroll);
        animateOnScroll(); 
    });
</script>

