    .sidebar-tag, .card-tag { font-size: 0.8rem; margin: 0 0 5px 0; }
    .article-desc, .sidebar-desc, .card-desc { font-size: 0.95rem; line-height: 1.5; color: #333; margin: 0; }
    .article-une:hover h2, .article-sidebar:hover h3, .article-bottom-card:hover h3 { text-decoration: underline; }
    .scroll-interactive { opacity: 0; transform: translateY(50px); transition: opacity 0.1s ease-out, transform 0.1s ease-out; will-change: opacity, transform; }
    .article-bottom-card.has-bg { position: relative; background-size: cover; background-position: center; border: none; z-index: 1; overflow: hidden; }
    .article-bottom-card.has-bg .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.7)); z-index: -1; }
    .article-bottom-card.has-bg h3 { color: #ffffff !important; }
    .article-bottom-card.has-bg .card-desc { color: #e0e0e0; }
    .asym-container { display: grid; grid-template-columns: 3.5fr 6.5fr; gap: 20px; width: 100%; align-items: stretch; }
    .asym-left-stack { display: flex; flex-direction: column; gap: 15px; justify-content: space-between; }
    .asym-left-stack .article-bottom-card { min-height: 120px; padding: 15px; width: 100%; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .asym-left-stack .article-bottom-card:hover{ transform: translateY(-6px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4); }
    .asym-right-giant { min-height: 410px; height: 100%; transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .asym-right-giant:hover { transform: translateY(-6px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5); }
    .scroll-left-to-right { opacity: 0; transform: translateX(-20px); transition: opacity 0.15s ease-out, transform 0.15s ease-out; will-change: opacity, transform; }
