---
import MainLayout from '../layouts/Layout.astro';
---

<MainLayout title="Mon compte">
  <div class="account-page" id="account-page" hidden>
    <header class="account-header">
      <h1 data-i18n="account_title">Mon compte</h1>
      <p class="account-subtitle" data-i18n="account_subtitle">
        Modifiez vos informations. Chaque bloc se sauvegarde séparément.
      </p>
    </header>

    <section class="account-card" data-section="cms" id="account-cms-card" hidden>
      <h2 data-i18n="account_cms">Administration</h2>
      <p class="section-help" data-i18n="account_cms_help">
        Accédez à l’espace de rédaction et de publication.
      </p>
      <a href="/admin/" class="btn-primary" data-i18n="account_cms_open">Ouvrir l’admin</a>
    </section>

    <section class="account-card" data-section="photo">
      <h2 data-i18n="account_photo_title">Photo de profil</h2>
      <form id="photo-form" class="account-form">
        <div class="avatar-picker">
          <span id="photo-preview" class="sonar-avatar sonar-avatar-lg" aria-hidden="true"></span>
          <div class="avatar-actions">
            <label class="file-btn">
              <span data-i18n="account_photo_choose">Choisir une image</span>
              <input type="file" id="avatar" name="avatar" accept="image/png,image/jpeg,image/webp" />
            </label>
            <button type="button" id="photo-remove" class="btn-ghost" data-i18n="account_photo_remove">
              Retirer la photo
            </button>
            <small data-i18n="account_photo_hint">PNG, JPG ou WebP, 2 Mo max. Sans photo : initiale du pseudo.</small>
          </div>
        </div>
        <p class="form-message" data-photo-message></p>
        <button type="submit" class="btn-primary" data-i18n="account_save">Enregistrer</button>
      </form>
    </section>

    <section class="account-card" data-section="identity">
      <h2 data-i18n="account_identity_title">Identité</h2>
      <form id="identity-form" class="account-form">
        <div class="form-row">
          <div class="form-group">
            <label for="last_name" data-i18n="auth_last_name">Nom</label>
            <input type="text" id="last_name" name="last_name" required autocomplete="family-name" />
          </div>
          <div class="form-group">
            <label for="first_name" data-i18n="auth_first_name">Prénom</label>
            <input type="text" id="first_name" name="first_name" required autocomplete="given-name" />
          </div>
        </div>
        <div class="form-group">
          <label for="username" data-i18n="auth_username">Pseudo</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            minlength="3"
            maxlength="20"
            pattern="[A-Za-z0-9_]+"
            autocomplete="username"
          />
          <small data-i18n="auth_username_hint">3 à 20 caractères : lettres, chiffres et underscore.</small>
        </div>
        <div class="form-group">
          <label for="phone" data-i18n="auth_phone">Téléphone (optionnel)</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>
        <p class="form-message" data-identity-message></p>
        <button type="submit" class="btn-primary" data-i18n="account_save">Enregistrer</button>
      </form>
    </section>

    <section class="account-card" data-section="email">
      <h2 data-i18n="account_email_title">Adresse e-mail</h2>
      <p class="section-help" data-i18n="account_email_help">
        Un e-mail de confirmation sera envoyé à la nouvelle adresse si la confirmation est activée.
      </p>
      <form id="email-form" class="account-form">
        <div class="form-group">
          <label for="email" data-i18n="auth_email">Adresse e-mail</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <p class="form-message" data-email-message></p>
        <button type="submit" class="btn-primary" data-i18n="account_save">Enregistrer</button>
      </form>
    </section>

    <section class="account-card" data-section="password">
      <h2 data-i18n="account_password_title">Mot de passe</h2>
      <form id="password-form" class="account-form">
        <div class="form-group">
          <label for="current_password" data-i18n="account_password_current">Mot de passe actuel</label>
          <input type="password" id="current_password" name="current_password" required autocomplete="current-password" />
        </div>
        <div class="form-group">
          <label for="new_password" data-i18n="account_password_new">Nouveau mot de passe</label>
          <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password" />
          <ul class="password-checks" id="password-checks" aria-live="polite">
            <li data-check="minLength" data-i18n="auth_password_rule_length">8 caractères minimum</li>
            <li data-check="lower" data-i18n="auth_password_rule_lower">Une minuscule</li>
            <li data-check="upper" data-i18n="auth_password_rule_upper">Une majuscule</li>
            <li data-check="digit" data-i18n="auth_password_rule_digit">Un chiffre</li>
          </ul>
        </div>
        <div class="form-group">
          <label for="new_password_confirm" data-i18n="account_password_confirm">Confirmer le nouveau mot de passe</label>
          <input type="password" id="new_password_confirm" name="new_password_confirm" required minlength="8" autocomplete="new-password" />
        </div>
        <p class="form-message" data-password-message></p>
        <button type="submit" class="btn-primary" data-i18n="account_save">Enregistrer</button>
      </form>
    </section>

    <section class="account-card account-card--danger" data-section="delete">
      <h2 data-i18n="account_delete">Supprimer le compte</h2>
      <p class="section-help" data-i18n="account_delete_body">
        Cette action est irréversible. Votre profil sera effacé et vous ne pourrez plus commenter avec ce compte.
      </p>
      <button type="button" class="btn-danger" id="account-delete-open" data-i18n="account_delete">
        Supprimer le compte
      </button>
    </section>
  </div>

  <div class="account-modal" id="account-delete-modal" hidden>
    <div class="account-modal-card" role="dialog" aria-modal="true" aria-labelledby="account-delete-title">
      <h3 id="account-delete-title" data-i18n="account_delete_title">Supprimer votre compte ?</h3>
      <p data-i18n="account_delete_body">
        Cette action est irréversible. Votre profil sera effacé et vous ne pourrez plus commenter avec ce compte.
      </p>
      <p class="account-modal-error" id="account-delete-error" hidden></p>
      <div class="account-modal-actions">
        <button type="button" class="account-modal-cancel" id="account-delete-cancel" data-i18n="account_delete_cancel">
          Annuler
        </button>
        <button type="button" class="account-modal-confirm" id="account-delete-confirm" data-i18n="account_delete_confirm">
          Supprimer définitivement
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { getBrowserSupabase, getCurrentAccount, getAuthRedirectUrl, type Account } from '../utils/supabase-browser';
  import { avatarInitial, avatarImgHtml, uploadAccountAvatar } from '../utils/avatar';
  import { isValidEmail, isStrongPassword, bindPasswordChecklist } from '../utils/auth-validation';
  import { t as translate } from '../utils/i18n.js';
  import { accountHasCmsLink } from '../utils/cms-accounts';

  function currentLang(): 'FR' | 'EN' {
    return (localStorage.getItem('site_lang') || 'FR').toUpperCase() === 'EN' ? 'EN' : 'FR';
  }

  function t(key: string) {
    return translate(key, currentLang());
  }

  const page = document.getElementById('account-page');
  const photoForm = document.getElementById('photo-form') as HTMLFormElement | null;
  const identityForm = document.getElementById('identity-form') as HTMLFormElement | null;
  const emailForm = document.getElementById('email-form') as HTMLFormElement | null;
  const passwordForm = document.getElementById('password-form') as HTMLFormElement | null;
  const previewEl = document.getElementById('photo-preview') as HTMLElement | null;
  const avatarInput = document.getElementById('avatar') as HTMLInputElement | null;
  const removeBtn = document.getElementById('photo-remove') as HTMLButtonElement | null;

  bindPasswordChecklist(
    document.getElementById('new_password') as HTMLInputElement | null,
    document.getElementById('password-checks')
  );

  let account: Account | null = null;
  let previewObjectUrl: string | null = null;
  let removePhoto = false;

  function setMessage(selector: string, text: string, ok: boolean) {
    const el = document.querySelector(selector) as HTMLElement | null;
    if (!el) return;
    el.textContent = text;
    el.style.color = ok ? '#22c55e' : '#ef4444';
  }

  function fillAvatarPreview(username: string, avatarUrl: string | null, avatarColor: string) {
    if (!previewEl) return;
    if (previewObjectUrl) {
      URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = null;
    }
    if (avatarUrl) {
      previewEl.style.backgroundColor = 'transparent';
      previewEl.innerHTML = avatarImgHtml(avatarUrl);
      return;
    }
    previewEl.style.backgroundColor = avatarColor || '#ea580c';
    previewEl.innerHTML = '';
    previewEl.textContent = avatarInitial(username);
  }

  function fillHeader(next: Account) {
    document.querySelectorAll('[data-auth-username]').forEach((el) => {
      el.textContent = next.username;
    });
    document.querySelectorAll<HTMLElement>('[data-auth-avatar]').forEach((el) => {
      el.style.backgroundColor = next.avatar_url ? 'transparent' : (next.avatar_color || '#ea580c');
      if (next.avatar_url) {
        el.innerHTML = avatarImgHtml(next.avatar_url);
      } else {
        el.textContent = avatarInitial(next.username);
      }
    });
  }

  function fillForms(current: Account) {
    (document.getElementById('last_name') as HTMLInputElement).value = current.last_name;
    (document.getElementById('first_name') as HTMLInputElement).value = current.first_name;
    (document.getElementById('username') as HTMLInputElement).value = current.username;
    (document.getElementById('phone') as HTMLInputElement).value = current.phone || '';
    (document.getElementById('email') as HTMLInputElement).value = current.email;
    fillAvatarPreview(current.username, current.avatar_url, current.avatar_color);
  }

  async function syncEmailFromAuth() {
    const supabase = getBrowserSupabase();
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user?.email || !account) return;
    if (session.user.email.toLowerCase() === account.email.toLowerCase()) return;

    await supabase.from('accounts').update({ email: session.user.email }).eq('id', account.id);
    account = { ...account, email: session.user.email };
    (document.getElementById('email') as HTMLInputElement).value = session.user.email;
  }

  try {
    account = await getCurrentAccount();
    if (!account) {
      window.location.replace(`/connexion?redirect=${encodeURIComponent('/compte')}`);
    } else {
      await syncEmailFromAuth();
      fillForms(account);
      page?.removeAttribute('hidden');
      try {
        const res = await fetch('/api/site-cms-access', { cache: 'no-store' });
        const data = res.ok ? await res.json() : { siteAccess: [] };
        const card = document.getElementById('account-cms-card');
        if (card && accountHasCmsLink(account, Array.isArray(data.siteAccess) ? data.siteAccess : [])) {
          card.removeAttribute('hidden');
        }
      } catch {
        /* pas de lien admin */
      }
    }
  } catch {
    window.location.replace(`/connexion?redirect=${encodeURIComponent('/compte')}`);
  }

  avatarInput?.addEventListener('change', () => {
    removePhoto = false;
    const file = avatarInput.files?.[0];
    if (!file || !previewEl || !account) {
      fillAvatarPreview(account?.username || '?', account?.avatar_url || null, account?.avatar_color || '#ea580c');
      return;
    }
    if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
    previewObjectUrl = URL.createObjectURL(file);
    previewEl.style.backgroundColor = 'transparent';
    previewEl.innerHTML = `<img src="${previewObjectUrl}" alt="" />`;
  });

  removeBtn?.addEventListener('click', () => {
    if (!account) return;
    removePhoto = true;
    if (avatarInput) avatarInput.value = '';
    fillAvatarPreview(account.username, null, account.avatar_color);
  });

  photoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!account) return;
    const file = avatarInput?.files?.[0] || null;

    if (!removePhoto && !file) {
      setMessage('[data-photo-message]', 'Choisissez une image, ou retirez la photo actuelle.', false);
      return;
    }

    if (file && file.size > 2 * 1024 * 1024) {
      setMessage('[data-photo-message]', 'La photo doit faire moins de 2 Mo.', false);
      return;
    }

    setMessage('[data-photo-message]', 'Enregistrement...', true);
    try {
      const supabase = getBrowserSupabase();
      if (removePhoto) {
        const { error } = await supabase.from('accounts').update({ avatar_url: null }).eq('id', account.id);
        if (error) throw error;
        account = { ...account, avatar_url: null };
      } else if (file) {
        const url = await uploadAccountAvatar(supabase, account.id, file);
        account = { ...account, avatar_url: url };
      }
      removePhoto = false;
      if (avatarInput) avatarInput.value = '';
      fillAvatarPreview(account.username, account.avatar_url, account.avatar_color);
      fillHeader(account);
      setMessage('[data-photo-message]', 'Photo mise à jour.', true);
    } catch (err) {
      setMessage('[data-photo-message]', err instanceof Error ? err.message : 'Impossible d’enregistrer la photo.', false);
    }
  });

  identityForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!account || !identityForm) return;

    const formData = new FormData(identityForm);
    const firstName = String(formData.get('first_name') || '').trim();
    const lastName = String(formData.get('last_name') || '').trim();
    const username = String(formData.get('username') || '').trim();
    const phone = String(formData.get('phone') || '').trim();

    if (!/^[A-Za-z0-9_]{3,20}$/.test(username)) {
      setMessage('[data-identity-message]', 'Le pseudo doit contenir 3 à 20 lettres, chiffres ou underscore.', false);
      return;
    }

    setMessage('[data-identity-message]', 'Enregistrement...', true);
    try {
      const supabase = getBrowserSupabase();
      if (username.toLowerCase() !== account.username.toLowerCase()) {
        const { data: taken } = await supabase
          .from('accounts')
          .select('id')
          .ilike('username', username)
          .maybeSingle();
        if (taken && taken.id !== account.id) {
          setMessage('[data-identity-message]', 'Ce pseudo est déjà pris.', false);
          return;
        }
      }

      const { error } = await supabase
        .from('accounts')
        .update({
          first_name: firstName,
          last_name: lastName,
          username,
          phone: phone || null,
        })
        .eq('id', account.id);

      if (error) throw error;

      await supabase.auth.updateUser({
        data: { first_name: firstName, last_name: lastName, username, phone: phone || null },
      });

      account = { ...account, first_name: firstName, last_name: lastName, username, phone: phone || null };
      fillHeader(account);
      if (!account.avatar_url) {
        fillAvatarPreview(username, null, account.avatar_color);
      }
      setMessage('[data-identity-message]', 'Identité mise à jour.', true);
    } catch (err) {
      setMessage('[data-identity-message]', err instanceof Error ? err.message : 'Impossible d’enregistrer.', false);
    }
  });

  emailForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!account || !emailForm) return;

    const nextEmail = String(new FormData(emailForm).get('email') || '').trim();
    if (!nextEmail) return;
    if (!isValidEmail(nextEmail)) {
      setMessage('[data-email-message]', t('auth_email_invalid'), false);
      return;
    }
    if (nextEmail.toLowerCase() === account.email.toLowerCase()) {
      setMessage('[data-email-message]', 'C’est déjà votre adresse actuelle.', false);
      return;
    }

    setMessage('[data-email-message]', 'Enregistrement...', true);
    try {
      const supabase = getBrowserSupabase();
      const { data: taken } = await supabase
        .from('accounts')
        .select('id')
        .ilike('email', nextEmail)
        .maybeSingle();
      if (taken && taken.id !== account.id) {
        setMessage('[data-email-message]', 'Un compte existe déjà avec cette adresse e-mail.', false);
        return;
      }

      const { data, error } = await supabase.auth.updateUser(
        { email: nextEmail },
        { emailRedirectTo: getAuthRedirectUrl('/compte') }
      );

      if (error) {
        const raw = (error.message || '').toLowerCase();
        if (raw.includes('rate limit')) {
          setMessage('[data-email-message]', 'Trop d’e-mails envoyés. Réessayez plus tard.', false);
        } else {
          setMessage('[data-email-message]', error.message, false);
        }
        return;
      }

      const confirmedEmail = data.user?.email || '';
      if (confirmedEmail.toLowerCase() === nextEmail.toLowerCase()) {
        const { error: syncError } = await supabase
          .from('accounts')
          .update({ email: nextEmail })
          .eq('id', account.id);
        if (syncError) throw syncError;
        account = { ...account, email: nextEmail };
        setMessage('[data-email-message]', 'Adresse e-mail mise à jour.', true);
      } else {
        setMessage(
          '[data-email-message]',
          'Un e-mail de confirmation a été envoyé. L’adresse ne changera qu’après validation du lien.',
          true
        );
      }
    } catch (err) {
      setMessage('[data-email-message]', err instanceof Error ? err.message : 'Impossible de changer l’e-mail.', false);
    }
  });

  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!account || !passwordForm) return;

    const formData = new FormData(passwordForm);
    const currentPassword = String(formData.get('current_password') || '');
    const newPassword = String(formData.get('new_password') || '');
    const confirmPassword = String(formData.get('new_password_confirm') || '');

    if (!isStrongPassword(newPassword)) {
      setMessage('[data-password-message]', t('auth_password_hint'), false);
      return;
    }
    if (newPassword !== confirmPassword) {
      setMessage('[data-password-message]', 'Les deux nouveaux mots de passe ne correspondent pas.', false);
      return;
    }

    setMessage('[data-password-message]', 'Enregistrement...', true);
    try {
      const supabase = getBrowserSupabase();
      const { error: reauthError } = await supabase.auth.signInWithPassword({
        email: account.email,
        password: currentPassword,
      });
      if (reauthError) {
        setMessage('[data-password-message]', 'Mot de passe actuel incorrect.', false);
        return;
      }

      const { error } = await supabase.auth.updateUser({ password: newPassword });
      if (error) throw error;

      passwordForm.reset();
      setMessage('[data-password-message]', 'Mot de passe mis à jour.', true);
    } catch (err) {
      setMessage('[data-password-message]', err instanceof Error ? err.message : 'Impossible de changer le mot de passe.', false);
    }
  });

  const deleteModal = document.getElementById('account-delete-modal');
  const deleteError = document.getElementById('account-delete-error');

  function closeDeleteModal() {
    if (!deleteModal) return;
    deleteModal.hidden = true;
    if (deleteError) {
      deleteError.hidden = true;
      deleteError.textContent = '';
    }
  }

  document.getElementById('account-delete-open')?.addEventListener('click', () => {
    if (deleteModal) deleteModal.hidden = false;
  });
  document.getElementById('account-delete-cancel')?.addEventListener('click', closeDeleteModal);
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && deleteModal && !deleteModal.hidden) closeDeleteModal();
  });

  document.getElementById('account-delete-confirm')?.addEventListener('click', async () => {
    const confirmBtn = document.getElementById('account-delete-confirm') as HTMLButtonElement | null;
    if (confirmBtn) confirmBtn.disabled = true;
    if (deleteError) {
      deleteError.hidden = true;
      deleteError.textContent = '';
    }

    try {
      const supabase = getBrowserSupabase();
      const { error } = await supabase.rpc('delete_own_account');
      if (error) throw error;
      await supabase.auth.signOut();
      window.location.href = '/';
    } catch (err) {
      if (deleteError) {
        deleteError.hidden = false;
        deleteError.textContent = err instanceof Error
          ? err.message
          : 'Impossible de supprimer le compte pour le moment.';
      }
      if (confirmBtn) confirmBtn.disabled = false;
    }
  });
</script>

<style>
  .account-page {
    max-width: 640px;
    margin: 40px auto 80px auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .account-header h1 {
    margin: 0 0 8px 0;
    font-size: 1.8rem;
    color: #ffffff;
  }

  .account-subtitle,
  .section-help {
    margin: 0;
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .account-card {
    background-color: #02001d;
    border-radius: 8px;
    padding: 28px 28px 24px 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .account-card h2 {
    margin: 0 0 8px 0;
    font-size: 1.15rem;
    color: #ffffff;
  }

  .account-card .section-help {
    margin-bottom: 1.2rem;
  }

  .account-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-size: 0.9rem;
    color: #d1d5db;
  }

  .form-group small,
  .avatar-actions small {
    color: #6b7280;
    font-size: 0.8rem;
  }

  .password-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 0.8rem;
    color: #9ca3af;
  }

  .password-checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .password-checks li::before {
    content: '○';
    color: #6b7280;
  }

  .password-checks li.is-met {
    color: #22c55e;
  }

  .password-checks li.is-met::before {
    content: '✓';
    color: #22c55e;
  }

  .form-group input[type="text"],
  .form-group input[type="email"],
  .form-group input[type="password"],
  .form-group input[type="tel"] {
    background-color: #0b092b;
    border: 1px solid #1f2937;
    border-radius: 6px;
    padding: 0.75rem;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.95rem;
  }

  .form-group input:focus {
    outline: none;
    border-color: #ea580c;
  }

  .avatar-picker {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .sonar-avatar-lg {
    width: 72px;
    height: 72px;
    font-size: 1.6rem;
  }

  .avatar-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }

  .file-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    background-color: #ffffff;
    color: #03031a;
    border-radius: 6px;
    padding: 0.55rem 1rem;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .file-btn input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .form-message {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.9rem;
  }

  .account-card[hidden] {
    display: none !important;
  }

  .btn-primary {
